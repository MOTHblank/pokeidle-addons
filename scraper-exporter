            }
        `;

        (
            document.head ||
            document.documentElement
        ).appendChild(
            style
        );
    }

    function ensureButton() {
        if (
            q(
                '#' +
                BUTTON_ID
            )
        ) {
            return;
        }

        const host =
            q('.menu-topo') ||
            document.body;

        if (!host) {
            return;
        }

        const button =
            document.createElement(
                'button'
            );

        button.type =
            'button';

        button.id =
            BUTTON_ID;

        button.textContent =
            'Scrape';

        button.title =
            'PokéIdle upstream scraper/exporter';

        button.addEventListener(
            'click',
            () => {
                const panel =
                    ensurePanel();

                panel.hidden =
                    !panel.hidden;

                updateUI();
            }
        );

        host.appendChild(
            button
        );
    }

    function ensurePanel() {
        injectStyle();

        let root =
            q(
                '#' +
                ROOT_ID
            );

        if (root) {
            return root;
        }

        root =
            document.createElement(
                'section'
            );

        root.id =
            ROOT_ID;

        root.hidden =
            true;

        root.innerHTML = `
            <div class="mus-head">
                <strong>Upstream Scraper</strong>
                <button type="button" data-mus-close>×</button>
            </div>

            <div class="mus-status" data-mus-status></div>

            <div class="mus-meta">
                <div><b data-mus-files>0</b><span>files</span></div>
                <div><b data-mus-size>0 KB</b><span>text</span></div>
                <div><b data-mus-errors>0</b><span>skipped</span></div>
            </div>

            <div class="mus-actions">
                <button type="button" data-mus-scan>Scan</button>
                <button type="button" data-mus-tar disabled>Export TAR</button>
                <button type="button" data-mus-manifest disabled>Manifest</button>
            </div>

            <div class="mus-errors" data-mus-error-list></div>
        `;

        document.body.appendChild(
            root
        );

        q(
            '[data-mus-close]',
            root
        ).addEventListener(
            'click',
            () => {
                root.hidden =
                    true;
            }
        );

        q(
            '[data-mus-scan]',
            root
        ).addEventListener(
            'click',
            scrape
        );

        q(
            '[data-mus-tar]',
            root
        ).addEventListener(
            'click',
            exportTar
        );

        q(
            '[data-mus-manifest]',
            root
        ).addEventListener(
            'click',
            exportManifest
        );

        return root;
    }

    function prettyBytes(
        bytes
    ) {
        if (
            bytes >=
            1024 *
                1024
        ) {
            return (
                bytes /
                1024 /
                1024
            ).toFixed(1) +
                ' MB';
        }

        return Math.round(
            bytes /
            1024
        ) + ' KB';
    }

    function updateUI() {
        const root =
            ensurePanel();

        const status =
            q(
                '[data-mus-status]',
                root
            );

        if (status) {
            status.textContent =
                state.status;
        }

        q(
            '[data-mus-files]',
            root
        ).textContent =
            String(
                state.files.size
            );

        q(
            '[data-mus-size]',
            root
        ).textContent =
            prettyBytes(
                totalBytes()
            );

        q(
            '[data-mus-errors]',
            root
        ).textContent =
            String(
                state.errors.length
            );

        const scan =
            q(
                '[data-mus-scan]',
                root
            );

        scan.disabled =
            state.running;

        scan.textContent =
            state.running
                ? 'Scanning…'
                : state.files.size
                    ? 'Rescan'
                    : 'Scan';

        for (
            const selector of [
                '[data-mus-tar]',
                '[data-mus-manifest]'
            ]
        ) {
            q(
                selector,
                root
            ).disabled =
                state.running ||
                !state.files.size;
        }

        const errors =
            q(
                '[data-mus-error-list]',
                root
            );

        errors.innerHTML =
            state.errors
                .slice(0, 12)
                .map(
                    item =>
                        `<div>${escapeHtml(new URL(item.url, location.href).pathname)} — ${escapeHtml(item.error)}</div>`
                )
                .join('');
    }

    function bootstrap() {
        injectStyle();
        ensureButton();
        ensurePanel();

        setInterval(
            ensureButton,
            3000
        );

        console.info(
            '[PokéIdle Upstream Scraper] v1.0 loaded'
        );
    }

    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            bootstrap,
            {
                once: true
            }
        );
    } else {
        bootstrap();
    }
})();

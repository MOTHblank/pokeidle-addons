// ==UserScript==
// @name         PokéIdle Upstream Scraper & Exporter
// @namespace    moth.pokeidle
// @version      1.0.0
// @description  Mirrors PokéIdle's same-origin client code and exports a repo-ready upstream/ TAR plus manifest.
// @match        https://pokeidle.io/*
// @match        https://www.pokeidle.io/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(() => {
    'use strict';

    const ROOT_ID = 'moth-upstream-scraper';
    const BUTTON_ID = 'moth-upstream-scraper-button';
    const STYLE_ID = 'moth-upstream-scraper-style';

    const MAX_FILES = 350;
    const MAX_TEXT_BYTES = 3 * 1024 * 1024;

    const state = {
        running: false,
        files: new Map(),
        errors: [],
        status: 'Not scanned yet',
        startedAt: 0,
        finishedAt: 0
    };

    const q = (selector, root = document) =>
        root.querySelector(selector);

    const qa = (selector, root = document) =>
        [...root.querySelectorAll(selector)];

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function normalizeUrl(value, base = location.href) {
        try {
            const url = new URL(value, base);

            if (url.origin !== location.origin) {
                return null;
            }

            url.hash = '';

            return url.href;
        } catch {
            return null;
        }
    }

    function resourcePath(urlValue, contentType = '') {
        const url = new URL(urlValue);
        let pathname = decodeURIComponent(url.pathname);

        if (
            pathname === '/' ||
            pathname === '/app' ||
            pathname === '/app/'
        ) {
            return 'upstream/app.html';
        }

        pathname = pathname
            .replace(/^\/+/, '')
            .replace(/\/+$/g, '');

        if (!pathname) {
            pathname = 'index.html';
        }

        if (
            !/\.[a-z0-9]{1,8}$/i.test(pathname)
        ) {
            if (/html/i.test(contentType)) {
                pathname += '.html';
            }
        }

        const safe = pathname
            .split('/')
            .filter(
                part =>
                    part &&
                    part !== '.' &&
                    part !== '..'
            )
            .map(part =>
                part.replace(/[<>:"|?*\x00-\x1f]/g, '_')
            )
            .join('/');

        return 'upstream/' + safe;
    }

    function isTextCandidate(urlValue) {
        try {
            const url = new URL(urlValue);
            const path = url.pathname.toLowerCase();

            if (
                path === '/' ||
                path === '/app' ||
                path === '/app/'
            ) {
                return true;
            }

            return /\.(?:js|mjs|css|html?|json|csv|txt|xml|map)$/i
                .test(path);
        } catch {
            return false;
        }
    }

    function isTextContentType(type) {
        const value = String(type || '').toLowerCase();

        return (
            value.startsWith('text/') ||
            value.includes('javascript') ||
            value.includes('json') ||
            value.includes('xml') ||
            value.includes('csv') ||
            value === ''
        );
    }

    function collectInitialUrls() {
        const urls = new Set();

        const add = value => {
            const normalized =
                normalizeUrl(value);

            if (
                normalized &&
                isTextCandidate(normalized)
            ) {
                urls.add(normalized);
            }
        };

        add(location.origin + '/app');

        for (
            const el of
            qa('script[src], link[href]')
        ) {
            const value =
                el.getAttribute('src') ||
                el.getAttribute('href');

            if (!value) continue;

            const rel =
                String(
                    el.getAttribute('rel') ||
                    ''
                ).toLowerCase();

            if (
                el.tagName === 'LINK' &&
                rel &&
                !rel.includes('stylesheet') &&
                !rel.includes('modulepreload') &&
                !rel.includes('preload')
            ) {
                continue;
            }

            add(value);
        }

        for (
            const entry of
            performance.getEntriesByType('resource')
        ) {
            add(entry.name);
        }

        return [...urls];
    }

    function extractImports(
        text,
        sourceUrl,
        contentType
    ) {
        const discovered =
            new Set();

        const add = raw => {
            if (!raw) return;

            const normalized =
                normalizeUrl(
                    raw,
                    sourceUrl
                );

            if (
                normalized &&
                isTextCandidate(normalized)
            ) {
                discovered.add(normalized);
            }
        };

        const path =
            new URL(sourceUrl)
                .pathname
                .toLowerCase();

        if (
            /(?:javascript|ecmascript)/i.test(
                contentType
            ) ||
            /\.(?:js|mjs)$/i.test(path)
        ) {
            const patterns = [
                /\b(?:import|export)\s+(?:[^'"]*?\s+from\s*)?['"]([^'"]+)['"]/g,
                /\bimport\s*\(\s*['"]([^'"]+)['"]\s*\)/g,
                /\bnew\s+URL\s*\(\s*['"]([^'"]+)['"]\s*,\s*import\.meta\.url\s*\)/g
            ];

            for (
                const pattern of
                patterns
            ) {
                let match;

                while (
                    (
                        match =
                            pattern.exec(text)
                    )
                ) {
                    add(match[1]);
                }
            }
        }

        if (
            /css/i.test(contentType) ||
            /\.css$/i.test(path)
        ) {
            let match;

            const imports =
                /@import\s+(?:url\()?\s*['"]?([^'")\s;]+)['"]?\s*\)?/g;

            while (
                (
                    match =
                        imports.exec(text)
                )
            ) {
                add(match[1]);
            }
        }

        if (
            /html/i.test(contentType) ||
            /\.html?$/i.test(path) ||
            path === '/app'
        ) {
            const parser =
                new DOMParser();

            const doc =
                parser.parseFromString(
                    text,
                    'text/html'
                );

            for (
                const el of
                doc.querySelectorAll(
                    'script[src], link[href]'
                )
            ) {
                add(
                    el.getAttribute('src') ||
                    el.getAttribute('href')
                );
            }
        }

        return [...discovered];
    }

    async function sha256(text) {
        const bytes =
            new TextEncoder()
                .encode(text);

        const digest =
            await crypto.subtle.digest(
                'SHA-256',
                bytes
            );

        return [...new Uint8Array(digest)]
            .map(value =>
                value
                    .toString(16)
                    .padStart(2, '0')
            )
            .join('');
    }

    async function fetchText(url) {
        const response =
            await fetch(
                url,
                {
                    credentials:
                        'same-origin',
                    cache:
                        'no-store'
                }
            );

        if (!response.ok) {
            throw new Error(
                'HTTP ' +
                response.status
            );
        }

        const type =
            response.headers.get(
                'content-type'
            ) || '';

        if (
            !isTextContentType(type)
        ) {
            throw new Error(
                'non-text ' +
                type
            );
        }

        const length =
            Number(
                response.headers.get(
                    'content-length'
                ) ||
                0
            );

        if (
            length >
            MAX_TEXT_BYTES
        ) {
            throw new Error(
                'too large (' +
                length +
                ' bytes)'
            );
        }

        const text =
            await response.text();

        const bytes =
            new TextEncoder()
                .encode(text)
                .byteLength;

        if (
            bytes >
            MAX_TEXT_BYTES
        ) {
            throw new Error(
                'too large (' +
                bytes +
                ' bytes)'
            );
        }

        return {
            text,
            bytes,
            contentType:
                type.split(';')[0]
                    .trim(),
            finalUrl:
                response.url ||
                url
        };
    }

    function inferVersion() {
        const candidates = [];

        for (
            const file of
            state.files.values()
        ) {
            try {
                const url =
                    new URL(file.url);

                const version =
                    url.searchParams.get(
                        'v'
                    );

                if (version) {
                    candidates.push(
                        version
                    );
                }
            } catch {}
        }

        return (
            candidates
                .sort(
                    (a, b) =>
                        String(b)
                            .localeCompare(
                                String(a),
                                undefined,
                                {
                                    numeric: true
                                }
                            )
                )[0] ||
            null
        );
    }

    async function scrape() {
        if (state.running) {
            return;
        }

        state.running = true;
        state.files.clear();
        state.errors = [];
        state.startedAt =
            Date.now();
        state.finishedAt = 0;
        state.status =
            'Discovering resources…';

        updateUI();

        const queue =
            collectInitialUrls();

        const queued =
            new Set(queue);

        let cursor = 0;

        while (
            cursor < queue.length &&
            state.files.size <
                MAX_FILES
        ) {
            const url =
                queue[cursor++];

            state.status =
                `Fetching ${state.files.size + 1} · ${new URL(url).pathname}`;

            updateUI();

            try {
                const result =
                    await fetchText(
                        url
                    );

                const path =
                    resourcePath(
                        result.finalUrl,
                        result.contentType
                    );

                const hash =
                    await sha256(
                        result.text
                    );

                state.files.set(
                    path,
                    {
                        path,
                        url:
                            result.finalUrl,
                        contentType:
                            result.contentType,
                        bytes:
                            result.bytes,
                        sha256:
                            hash,
                        text:
                            result.text
                    }
                );

                for (
                    const dependency of
                    extractImports(
                        result.text,
                        result.finalUrl,
                        result.contentType
                    )
                ) {
                    if (
                        !queued.has(
                            dependency
                        )
                    ) {
                        queued.add(
                            dependency
                        );

                        queue.push(
                            dependency
                        );
                    }
                }
            } catch (error) {
                state.errors.push({
                    url,
                    error:
                        String(
                            error?.message ||
                            error
                        )
                });
            }

            /*
             * Yield occasionally so the game UI remains responsive during a
             * large recursive scrape.
             */
            if (
                cursor % 8 === 0
            ) {
                await new Promise(
                    resolve =>
                        setTimeout(
                            resolve,
                            0
                        )
                );
            }
        }

        state.running = false;
        state.finishedAt =
            Date.now();

        if (
            state.files.size >=
            MAX_FILES
        ) {
            state.errors.push({
                url: '(scraper)',
                error:
                    `Stopped at MAX_FILES=${MAX_FILES}`
            });
        }

        state.status =
            `Ready · ${state.files.size} files · ${state.errors.length} skipped`;

        updateUI();
    }

    function totalBytes() {
        return [...state.files.values()]
            .reduce(
                (sum, file) =>
                    sum +
                    Number(
                        file.bytes ||
                        0
                    ),
                0
            );
    }

    function manifestObject() {
        return {
            generatedAt:
                new Date(
                    state.finishedAt ||
                    Date.now()
                ).toISOString(),
            source:
                location.origin,
            page:
                location.pathname,
            version:
                inferVersion(),
            fileCount:
                state.files.size,
            totalBytes:
                totalBytes(),
            files:
                [...state.files.values()]
                    .map(file => ({
                        path:
                            file.path,
                        url:
                            file.url,
                        contentType:
                            file.contentType,
                        bytes:
                            file.bytes,
                        sha256:
                            file.sha256
                    }))
                    .sort(
                        (a, b) =>
                            a.path.localeCompare(
                                b.path
                            )
                    ),
            skipped:
                state.errors
        };
    }

    function downloadBlob(
        blob,
        filename
    ) {
        const url =
            URL.createObjectURL(
                blob
            );

        const anchor =
            document.createElement(
                'a'
            );

        anchor.href =
            url;

        anchor.download =
            filename;

        document.body.appendChild(
            anchor
        );

        anchor.click();
        anchor.remove();

        setTimeout(
            () =>
                URL.revokeObjectURL(
                    url
                ),
            1500
        );
    }

    function exportManifest() {
        if (!state.files.size) {
            return;
        }

        const text =
            JSON.stringify(
                manifestObject(),
                null,
                2
            ) + '\n';

        downloadBlob(
            new Blob(
                [text],
                {
                    type:
                        'application/json'
                }
            ),
            'pokeidle-upstream-manifest.json'
        );
    }

    function tarString(
        header,
        offset,
        length,
        value
    ) {
        for (
            let i = 0;
            i < length;
            i++
        ) {
            header[
                offset + i
            ] = 0;
        }

        const bytes =
            new TextEncoder()
                .encode(
                    String(value)
                );

        header.set(
            bytes.slice(
                0,
                length
            ),
            offset
        );
    }

    function tarOctal(
        header,
        offset,
        length,
        value
    ) {
        const text =
            Math.max(
                0,
                Number(value) ||
                0
            )
                .toString(8)
                .padStart(
                    length - 1,
                    '0'
                )
                .slice(
                    -(length - 1)
                ) +
            '\0';

        tarString(
            header,
            offset,
            length,
            text
        );
    }

    function tarHeader(
        name,
        size,
        mtime
    ) {
        const header =
            new Uint8Array(
                512
            );

        let filename =
            name;

        let prefix =
            '';

        if (
            filename.length >
            100
        ) {
            const cut =
                filename.lastIndexOf(
                    '/',
                    155
                );

            if (
                cut > 0 &&
                filename.length -
                    cut -
                    1 <=
                    100
            ) {
                prefix =
                    filename.slice(
                        0,
                        cut
                    );

                filename =
                    filename.slice(
                        cut + 1
                    );
            }
        }

        tarString(
            header,
            0,
            100,
            filename
        );

        tarOctal(
            header,
            100,
            8,
            0o644
        );

        tarOctal(
            header,
            108,
            8,
            0
        );

        tarOctal(
            header,
            116,
            8,
            0
        );

        tarOctal(
            header,
            124,
            12,
            size
        );

        tarOctal(
            header,
            136,
            12,
            Math.floor(
                mtime /
                1000
            )
        );

        for (
            let i = 148;
            i < 156;
            i++
        ) {
            header[i] =
                32;
        }

        header[156] =
            '0'.charCodeAt(0);

        tarString(
            header,
            257,
            6,
            'ustar'
        );

        tarString(
            header,
            263,
            2,
            '00'
        );

        tarString(
            header,
            345,
            155,
            prefix
        );

        let checksum = 0;

        for (
            const byte of
            header
        ) {
            checksum +=
                byte;
        }

        const checksumText =
            checksum
                .toString(8)
                .padStart(
                    6,
                    '0'
                )
                .slice(-6) +
            '\0 ';

        tarString(
            header,
            148,
            8,
            checksumText
        );

        return header;
    }

    function tarParts() {
        const encoder =
            new TextEncoder();

        const manifest =
            JSON.stringify(
                manifestObject(),
                null,
                2
            ) + '\n';

        const entries = [
            ...[...state.files.values()]
                .map(file => ({
                    path:
                        file.path,
                    bytes:
                        encoder.encode(
                            file.text
                        )
                })),
            {
                path:
                    'upstream/manifest.json',
                bytes:
                    encoder.encode(
                        manifest
                    )
            }
        ]
            .sort(
                (a, b) =>
                    a.path.localeCompare(
                        b.path
                    )
            );

        const parts = [];

        for (
            const entry of
            entries
        ) {
            parts.push(
                tarHeader(
                    entry.path,
                    entry.bytes
                        .byteLength,
                    state.finishedAt ||
                        Date.now()
                )
            );

            parts.push(
                entry.bytes
            );

            const remainder =
                entry.bytes
                    .byteLength %
                512;

            if (remainder) {
                parts.push(
                    new Uint8Array(
                        512 -
                        remainder
                    )
                );
            }
        }

        parts.push(
            new Uint8Array(
                1024
            )
        );

        return parts;
    }

    function exportTar() {
        if (!state.files.size) {
            return;
        }

        const version =
            inferVersion();

        const filename =
            'pokeidle-upstream' +
            (
                version
                    ? '-v' +
                      version
                    : ''
            ) +
            '.tar';

        downloadBlob(
            new Blob(
                tarParts(),
                {
                    type:
                        'application/x-tar'
                }
            ),
            filename
        );
    }

    function injectStyle() {
        if (
            q(
                '#' +
                STYLE_ID
            )
        ) {
            return;
        }

        const style =
            document.createElement(
                'style'
            );

        style.id =
            STYLE_ID;

        style.textContent = `
            #${BUTTON_ID} {
                display:inline-flex!important;
                align-items:center!important;
                justify-content:center!important;
                min-width:0!important;
                width:auto!important;
                height:30px!important;
                padding:5px 8px!important;
                border:1px solid rgba(255,255,255,.17)!important;
                border-radius:6px!important;
                background:rgba(42,34,38,.86)!important;
                color:#eee!important;
                font:700 10px/1 system-ui,sans-serif!important;
                cursor:pointer!important;
            }

            #${ROOT_ID} {
                position:fixed!important;
                right:12px!important;
                bottom:12px!important;
                z-index:2147483646!important;
                width:min(380px,calc(100vw - 24px))!important;
                padding:10px!important;
                border:1px solid rgba(255,255,255,.18)!important;
                border-radius:9px!important;
                background:#171316!important;
                color:#eee7ea!important;
                box-shadow:0 10px 35px rgba(0,0,0,.5)!important;
                font:11px/1.35 system-ui,sans-serif!important;
            }

            #${ROOT_ID}[hidden] {
                display:none!important;
            }

            #${ROOT_ID} * {
                box-sizing:border-box!important;
            }

            .mus-head {
                display:flex;
                align-items:center;
                gap:7px;
                margin-bottom:7px;
            }

            .mus-head strong {
                flex:1;
                font-size:12px;
            }

            .mus-head button,
            .mus-actions button {
                border:1px solid rgba(255,255,255,.14);
                border-radius:5px;
                background:rgba(255,255,255,.06);
                color:#eee;
                padding:5px 7px;
                font:inherit;
                cursor:pointer;
            }

            .mus-head button:disabled,
            .mus-actions button:disabled {
                opacity:.45;
                cursor:default;
            }

            .mus-status {
                min-height:31px;
                padding:6px 7px;
                border-radius:6px;
                background:rgba(255,255,255,.045);
                color:#cfc4c9;
                overflow-wrap:anywhere;
            }

            .mus-meta {
                display:grid;
                grid-template-columns:repeat(3,minmax(0,1fr));
                gap:5px;

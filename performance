    function labelForMode(mode) {
        if (
            mode ===
                'full'
        ) {
            return 'Full';
        }

        const fps =
            Number(mode);

        return Number.isFinite(
            fps
        )
            ? fps +
              'fps'
            : mode;
    }

    function labelForUi(level) {
        return {
            off: 'UI Full',
            lite: 'UI Lite',
            aggressive: 'UI Low',
            performance: 'UI Max'
        }[level] || level;
    }

    function setText(el, value) {
        if (!el) {
            return;
        }

        const next =
            String(value);

        if (
            el.textContent !==
            next
        ) {
            el.textContent =
                next;
        }
    }

    function setChecked(el, value) {
        if (
            el &&
            el.checked !==
                Boolean(value)
        ) {
            el.checked =
                Boolean(value);
        }
    }

    function setValue(el, value) {
        if (
            el &&
            el.value !==
                String(value)
        ) {
            el.value =
                String(value);
        }
    }

    function setClass(el, className, enabled) {
        if (
            el &&
            el.classList.contains(
                className
            ) !== Boolean(enabled)
        ) {
            el.classList.toggle(
                className,
                Boolean(enabled)
            );
        }
    }

    // ------------------------------------------------------------------
    // Light control UI
    // ------------------------------------------------------------------

    function ensurePanel() {
        let panel =
            q('#' + PANEL_ID);

        if (panel) {
            return panel;
        }

        const host =
            q('#auto-corpo');

        if (!host) {
            return null;
        }

        panel =
            document.createElement(
                'section'
            );

        panel.id = PANEL_ID;
        panel.hidden = true;

        panel.innerHTML = `
            <div class="mpp-head">
                <strong>Performance+</strong>
                <label>
                    <input id="mpp-enabled" type="checkbox">
                    On
                </label>
            </div>

            <div class="mpp-metrics">
                <div class="mpp-metric">
                    <b id="mpp-browser-fps">—</b>
                    <span>browser FPS</span>
                </div>

                <div class="mpp-metric">
                    <b id="mpp-scene-runs">0</b>
                    <span>campo runs/s</span>
                </div>

                <div class="mpp-metric">
                    <b id="mpp-ui-skips">0</b>
                    <span>UI skips/s</span>
                </div>

                <div class="mpp-metric">
                    <b id="mpp-long">0</b>
                    <span>long ms/s</span>
                </div>
            </div>

            <div class="mpp-row">
                <label>Profile</label>

                <select id="mpp-profile">
                    <option value="full">Full</option>
                    <option value="adaptive">Adaptive</option>
                    <option value="afk">AFK</option>
                    <option value="capture">Capture Saver</option>
                    <option value="performance">Performance</option>
                </select>
            </div>

            <div class="mpp-status" id="mpp-status">
                Loading campo.mjs hook…
            </div>
        `;

        host.prepend(panel);

        q(
            '#mpp-enabled',
            panel
        ).addEventListener(
            'change',
            event => {
                settings.enabled =
                    event.target.checked;

                saveSettings();
                applyMode();
            }
        );

        q(
            '#mpp-profile',
            panel
        ).addEventListener(
            'change',
            event => {
                settings.profile =
                    event.target.value;

                lastActivity =
                    Date.now();

                interactionBoostUntil =
                    Date.now() + 2500;

                adaptiveDecision = '30';

                saveSettings();
                applyMode();
            }
        );

        return panel;
    }

    function ensureTrigger() {
        if (!document.body) {
            return false;
        }

        installStyles();
        installCampoHook();
        ensurePanel();

        let trigger =
            q('#' + TRIGGER_ID);

        if (trigger) {
            return true;
        }

        const header =
            q('#p-auto .painel-cab-auto') ||
            q('#p-auto .painel-cab');

        if (!header) {
            return false;
        }

        trigger =
            document.createElement(
                'button'
            );

        trigger.type = 'button';
        trigger.id = TRIGGER_ID;
        trigger.textContent =
            'Perf · load';

        trigger.title =
            'Performance+ loaded';

        trigger.addEventListener(
            'click',
            event => {
                event.preventDefault();
                event.stopPropagation();

                const autoToggle =
                    q('#btn-auto-toggle');

                if (
                    autoToggle?.getAttribute(
                        'aria-expanded'
                    ) === 'false'
                ) {
                    autoToggle.click();
                }

                const panel =
                    ensurePanel();

                if (panel) {
                    panel.hidden =
                        !panel.hidden;
                }
            }
        );

        const collapse =
            q(
                '#btn-auto-toggle',
                header
            );

        if (collapse) {
            header.insertBefore(
                trigger,
                collapse
            );
        } else {
            header.appendChild(
                trigger
            );
        }

        return true;
    }

    function updateUI() {
        const trigger =
            q('#' + TRIGGER_ID);

        const panel =
            q('#' + PANEL_ID);

        if (panel) {
            setChecked(
                q(
                    '#mpp-enabled',
                    panel
                ),
                settings.enabled
            );

            setValue(
                q(
                    '#mpp-profile',
                    panel
                ),
                settings.profile
            );

            setText(
                q(
                    '#mpp-browser-fps',
                    panel
                ),
                document.hidden
                    ? 'BG'
                    : Math.round(
                        browserFps
                    )
            );

            setText(
                q(
                    '#mpp-scene-runs',
                    panel
                ),
                isNativeEconomy()
                    ? 'Eco'
                    : campoRunsPerSecond
            );

            setText(
                q(
                    '#mpp-ui-skips',
                    panel
                ),
                uiTimerSkippedPerSecond
            );

            setText(
                q(
                    '#mpp-long',
                    panel
                ),
                Math.round(
                    longTaskMsPerSecond
                )
            );

            const status =
                q(
                    '#mpp-status',
                    panel
                );

            let statusText;

            if (isNativeEconomy()) {
                statusText =
                    'Native Economy is active; Auto Catch cannot receive fallen targets.';
            } else if (!campoHookInstalled) {
                statusText =
                    'Could not install the page-world campo hook.';
            } else if (!campoLoopFound) {
                statusText =
                    'Hook ready; waiting for campo.mjs renderer.';
            } else if (!settings.enabled) {
                statusText =
                    'campo.mjs renderer found; Performance+ disabled.';
            } else if (
                settings.profile ===
                'performance'
            ) {
                statusText =
                    'Performance: 30fps active · 15fps idle · native Optimized · hot UI timers throttled · core controls preserved.';
            } else if (
                profile().adaptive
            ) {
                statusText =
                    'Adaptive · ' +
                    pressure +
                    ' load · ' +
                    labelForMode(
                        currentMode
                    ) +
                    ' · ' +
                    Math.round(
                        jankPerSecond * 10
                    ) / 10 +
                    ' jank/s · scene skipped ' +
                    campoSkippedPerSecond +
                    '/s · UI skipped ' +
                    uiTimerSkippedPerSecond +
                    '/s' +
                    (
                        npcLoopFound
                            ? ' · NPC ' +
                              npcRunsPerSecond +
                              '/s'
                            : ''
                    ) +
                    '.';
            } else {
                statusText =
                    'Upstream render/UI loops targeted · scene skipped ' +
                    campoSkippedPerSecond +
                    '/s · UI skipped ' +
                    uiTimerSkippedPerSecond +
                    '/s · native Optimized ' +
                    (
                        nativeOptimizedEnabled()
                            ? 'on'
                            : 'off'
                    ) +
                    '.';
            }

            setText(
                status,
                statusText
            );
        }

        if (!trigger) {
            return;
        }

        let triggerText;
        let working = false;
        let warning = false;

        if (isNativeEconomy()) {
            triggerText =
                'Perf · Native Eco';

            warning = true;
        } else if (!settings.enabled) {
            triggerText =
                'Perf · Off';
        } else if (!campoHookInstalled) {
            triggerText =
                'Perf · hook!';

            warning = true;
        } else if (!campoLoopFound) {
            triggerText =
                'Perf · campo…';

            warning = true;
        } else {
            triggerText =
                'Perf · ' +
                labelForMode(
                    currentMode
                ) +
                ' · ' +
                labelForUi(
                    currentUi
                );

            working = true;
        }

        setText(
            trigger,
            triggerText
        );

        setClass(
            trigger,
            'working',
            working
        );

        setClass(
            trigger,
            'warning',
            warning
        );
    }

    // ------------------------------------------------------------------
    // Tick / bootstrap
    // ------------------------------------------------------------------

    nativeSetInterval(() => {
        campoRunsPerSecond =
            campoRunsWindow;

        campoSkippedPerSecond =
            campoSkippedWindow;

        uiTimerRunsPerSecond =
            uiTimerRunsWindow;

        uiTimerSkippedPerSecond =
            uiTimerSkippedWindow;

        npcRunsPerSecond =
            npcRunsWindow;

        npcSkippedPerSecond =
            npcSkippedWindow;

        campoRunsWindow = 0;
        campoSkippedWindow = 0;
        uiTimerRunsWindow = 0;
        uiTimerSkippedWindow = 0;
        npcRunsWindow = 0;
        npcSkippedWindow = 0;

        prunePerformanceSamples();
        updateAdaptiveDecision();
        applyMode();
    }, 1000);

    function bootstrap() {
        installStyles();
        installCampoHook();
        ensureTrigger();

        lastActivity =
            Date.now();

        applyMode();

        nativeSetInterval(() => {
            installCampoHook();
            installUiTimerHook();
            ensureTrigger();
        }, 1500);

        console.info(
            '[PokéIdle Performance+] v5.0.0 loaded'
        );
    }

    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            bootstrap,
            {
                once: true
            }
        );
    } else {
        bootstrap();
    }
})();

// ==UserScript==
// @name         PokéIdle Performance+
// @namespace    moth.pokeidle
// @version      5.0.0
// @description  Targets PokéIdle's campo.mjs loop, reduces expensive UI work, and adapts scene rate to load.
// @match        https://pokeidle.io/*
// @match        https://www.pokeidle.io/*
// @grant        unsafeWindow
// @run-at       document-start
// ==/UserScript==

(() => {
    'use strict';

    const STORAGE_KEY = 'moth-pokeidle-performance-v6';
    const LEGACY_KEY = 'moth-pokeidle-performance-v5';
    const NATIVE_OPT_OWNER_KEY = 'moth-pokeidle-performance-native-opt-owner';
    const NATIVE_OPT_BASE_KEY = 'moth-pokeidle-performance-native-opt-base';
    const TRIGGER_ID = 'moth-performance-trigger';
    const PANEL_ID = 'moth-performance-panel';
    const STYLE_ID = 'moth-performance-style';

    const page = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
    const q = (selector, root = document) => root.querySelector(selector);

    const nativeSetInterval = page.setInterval.bind(page);
    const nativeClearInterval = page.clearInterval.bind(page);

    /*
     * "Performance" is intentionally different from AFK/Capture Saver:
     * it does NOT cap the scene. It removes superfluous UI/effects so the
     * browser can spend as much of its frame budget as possible on campo.
     */
    const PROFILES = {
        full: {
            label: 'Full',
            adaptive: false,
            scene: 'full',
            idleScene: 'full',
            backgroundScene: 'full',
            idleSeconds: 0,
            ui: 'off',
            idleUi: 'off',
            effects: 'full',
            nativeOptimized: false
        },
        adaptive: {
            label: 'Adaptive',
            adaptive: true,
            scene: '30',
            idleScene: '5',
            backgroundScene: '2',
            idleSeconds: 45,
            ui: 'lite',
            idleUi: 'aggressive',
            effects: 'reduced',
            nativeOptimized: true
        },
        afk: {
            label: 'AFK',
            adaptive: false,
            scene: '15',
            idleScene: '5',
            backgroundScene: '2',
            idleSeconds: 20,
            ui: 'lite',
            idleUi: 'aggressive',
            effects: 'reduced',
            nativeOptimized: true
        },
        capture: {
            label: 'Capture Saver',
            adaptive: false,
            scene: '10',
            idleScene: '5',
            backgroundScene: '2',
            idleSeconds: 10,
            ui: 'aggressive',
            idleUi: 'aggressive',
            effects: 'minimal',
            nativeOptimized: true
        },
        performance: {
            label: 'Performance',
            adaptive: false,
            scene: '30',
            idleScene: '15',
            backgroundScene: '2',
            idleSeconds: 30,
            ui: 'performance',
            idleUi: 'performance',
            effects: 'minimal',
            nativeOptimized: true
        }
    };

    const DEFAULTS = {
        enabled: true,
        profile: 'adaptive'
    };

    function loadSettings() {
        let saved = {};

        try {
            saved = JSON.parse(
                localStorage.getItem(STORAGE_KEY) ||
                localStorage.getItem(LEGACY_KEY) ||
                '{}'
            );
        } catch {}

        // v3 called the adaptive-ish profile "balanced".
        if (saved.profile === 'balanced') {
            saved.profile = 'adaptive';
        }

        if (!PROFILES[saved.profile]) {
            saved.profile = DEFAULTS.profile;
        }

        return {
            ...DEFAULTS,
            ...saved
        };
    }

    let settings = loadSettings();
    let lastActivity = Date.now();
    let interactionBoostUntil = 0;
    let currentMode = 'full';
    let currentUi = 'off';
    let chatCollapsedByAddon = false;

    // Exact campo.mjs loop hook state.
    const nativeRAF = page.requestAnimationFrame?.bind(page);
    const nativeCancelRAF = page.cancelAnimationFrame?.bind(page);
    const throttledRequests = new Map();
    const rafState = new WeakMap();
    const rafClassification = new WeakMap();
    let nextSyntheticRafId = -1;
    let campoHookInstalled = false;
    let campoLoopFound = false;
    let npcLoopFound = false;
    let campoRunsWindow = 0;
    let campoSkippedWindow = 0;
    let campoRunsPerSecond = 0;
    let campoSkippedPerSecond = 0;

    // Load monitor.
    const longTasks = [];
    const jankFrames = [];
    let browserFps = 0;
    let frameCount = 0;
    let frameWindowStart = performance.now();
    let previousMonitorFrame = 0;
    let longTaskMsPerSecond = 0;
    let jankPerSecond = 0;
    let pressure = 'light';
    let adaptiveDecision = '30';
    let adaptiveCandidate = '30';
    let adaptiveCandidateStreak = 0;

    let uiTimerRunsWindow = 0;
    let uiTimerSkippedWindow = 0;
    let uiTimerRunsPerSecond = 0;
    let uiTimerSkippedPerSecond = 0;

    let npcRunsWindow = 0;
    let npcSkippedWindow = 0;
    let npcRunsPerSecond = 0;
    let npcSkippedPerSecond = 0;

    function saveSettings() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
    }

    function profile() {
        return PROFILES[settings.profile] || PROFILES.adaptive;
    }

    function isNativeEconomy() {
        return document.documentElement.classList.contains('modo-economia');
    }

    function autoCatchEnabled() {
        const button = q('#moth-ac-toggle');

        if (button) {
            return button.textContent.trim().toUpperCase() === 'ON';
        }

        try {
            return Boolean(
                JSON.parse(
                    localStorage.getItem('moth-pokeidle-autocatch-v4') || '{}'
                ).enabled
            );
        } catch {
            return false;
        }
    }

    // ------------------------------------------------------------------
    // Native optimized mode cooperation
    // ------------------------------------------------------------------

    function nativeOptimizedEnabled() {
        try {
            return (
                localStorage.getItem(
                    'cfg-otimizado'
                ) === '1'
            );
        } catch {
            return false;
        }
    }

    function forceNativeOptimized() {
        try {
            const owned =
                localStorage.getItem(
                    NATIVE_OPT_OWNER_KEY
                ) === '1';

            if (owned) {
                localStorage.setItem(
                    'cfg-otimizado',
                    '1'
                );

                return;
            }

            if (
                localStorage.getItem(
                    'cfg-otimizado'
                ) === '1'
            ) {
                /*
                 * The player already enabled PokéIdle's own optimization.
                 * Leave it entirely under their control.
                 */
                return;
            }

            const previous =
                localStorage.getItem(
                    'cfg-otimizado'
                );

            localStorage.setItem(
                NATIVE_OPT_BASE_KEY,
                previous === null
                    ? '__null__'
                    : previous
            );

            localStorage.setItem(
                NATIVE_OPT_OWNER_KEY,
                '1'
            );

            localStorage.setItem(
                'cfg-otimizado',
                '1'
            );
        } catch {}
    }

    function restoreNativeOptimized() {
        try {
            if (
                localStorage.getItem(
                    NATIVE_OPT_OWNER_KEY
                ) !== '1'
            ) {
                return;
            }

            const previous =
                localStorage.getItem(
                    NATIVE_OPT_BASE_KEY
                );

            if (
                previous ===
                '__null__'
            ) {
                localStorage.removeItem(
                    'cfg-otimizado'
                );
            } else if (
                previous !==
                null
            ) {
                localStorage.setItem(
                    'cfg-otimizado',
                    previous
                );
            }

            localStorage.removeItem(
                NATIVE_OPT_OWNER_KEY
            );

            localStorage.removeItem(
                NATIVE_OPT_BASE_KEY
            );
        } catch {}
    }

    function syncNativeOptimized() {
        const shouldForce =
            settings.enabled &&
            profile()
                .nativeOptimized &&
            !isNativeEconomy();

        if (shouldForce) {
            forceNativeOptimized();
        } else {
            restoreNativeOptimized();
        }
    }

    /*
     * Restore the user's own native preference on navigation/reload. The
     * next page load re-enables it at document-start if Performance+ still
     * needs it.
     */
    page.addEventListener(
        'pagehide',
        restoreNativeOptimized
    );

    // Apply before app.js/campo.mjs start using otimizadoLigado().
    syncNativeOptimized();

    // ------------------------------------------------------------------
    // Upstream-aware requestAnimationFrame throttling
    // ------------------------------------------------------------------

    function scheduleComesFromCampo() {
        try {
            return /(?:https:\/\/pokeidle\.io)?\/campo\.mjs(?:\?|:)/i
                .test(
                    String(
                        new Error()
                            .stack ||
                        ''
                    )
                );
        } catch {
            return false;
        }
    }

    function classifyRafCallback(
        callback
    ) {
        if (
            typeof callback !==
                'function'
        ) {
            return null;
        }

        if (
            rafClassification.has(
                callback
            )
        ) {
            return (
                rafClassification.get(
                    callback
                ) ||
                null
            );
        }

        const name =
            String(
                callback.name ||
                ''
            );

        let kind =
            null;

        /*
         * app.js has a permanent rAF in the Pokémon Center solely to keep
         * the nurse/TM/depot/house buttons visually attached to NPCs.
         */
        if (
            name ===
                'seguirEnfermeira' ||
            String(
                callback
            ).includes(
                'seguirBotaoCentro'
            )
        ) {
            kind =
                'npc';

            npcLoopFound =
                true;
        } else if (
            scheduleComesFromCampo()
        ) {
            /*
             * Every Campo instance has its own bound loop. v4 only found
             * the first one, allowing replay/war/PvP Campo instances to
             * run uncapped. Classify every distinct callback once.
             */
            kind =
                'campo';

            campoLoopFound =
                true;
        }

        rafClassification.set(
            callback,
            kind ||
                false
        );

        if (
            kind ===
                'campo'
        ) {
            console.info(
                '[PokéIdle Performance+] hooked a campo.mjs renderer'
            );
        } else if (
            kind ===
                'npc'
        ) {
            console.info(
                '[PokéIdle Performance+] hooked Center NPC positioning loop'
            );
        }

        return kind;
    }

    function intervalForMode(
        mode
    ) {
        if (
            mode ===
                'full'
        ) {
            return 0;
        }

        const fps =
            Number(mode);

        if (
            !Number.isFinite(
                fps
            ) ||
            fps <= 0
        ) {
            return 0;
        }

        return (
            1000 /
            fps
        );
    }

    function intervalForRafKind(
        kind
    ) {
        if (
            !settings.enabled
        ) {
            return 0;
        }

        if (
            kind ===
                'campo'
        ) {
            return intervalForMode(
                currentMode
            );
        }

        if (
            kind ===
                'npc'
        ) {
            if (
                document.hidden
            ) {
                return 500;
            }

            if (
                Date.now() <
                interactionBoostUntil
            ) {
                return 1000 / 30;
            }

            if (
                currentUi ===
                    'off'
            ) {
                return 0;
            }

            if (
                currentUi ===
                    'lite'
            ) {
                return 1000 / 20;
            }

            return 100;
        }

        return 0;
    }

    function installCampoHook() {
        if (
            campoHookInstalled ||
            !nativeRAF ||
            !nativeCancelRAF
        ) {
            return campoHookInstalled;
        }

        function mothRequestAnimationFrame(
            callback
        ) {
            const kind =
                classifyRafCallback(
                    callback
                );

            if (!kind) {
                return nativeRAF(
                    callback
                );
            }

            const publicId =
                nextSyntheticRafId--;

            const pending = {
                actualId: null,
                cancelled: false
            };

            const gate =
                timestamp => {
                    if (
                        pending.cancelled
                    ) {
                        throttledRequests.delete(
                            publicId
                        );

                        return;
                    }

                    const interval =
                        intervalForRafKind(
                            kind
                        );

                    let callbackState =
                        rafState.get(
                            callback
                        );

                    if (
                        !callbackState
                    ) {
                        callbackState = {
                            lastRun:
                                -Infinity
                        };

                        rafState.set(
                            callback,
                            callbackState
                        );
                    }

                    if (
                        interval > 0 &&
                        timestamp -
                            callbackState
                                .lastRun <
                            interval
                    ) {
                        if (
                            kind ===
                                'campo'
                        ) {
                            campoSkippedWindow++;
                        } else {
                            npcSkippedWindow++;
                        }

                        pending.actualId =
                            nativeRAF(
                                gate
                            );

                        return;
                    }

                    callbackState.lastRun =
                        timestamp;

                    if (
                        kind ===
                            'campo'
                    ) {
                        campoRunsWindow++;
                    } else {
                        npcRunsWindow++;
                    }

                    throttledRequests.delete(
                        publicId
                    );

                    callback.call(
                        page,
                        timestamp
                    );
                };

            pending.actualId =
                nativeRAF(
                    gate
                );

            throttledRequests.set(
                publicId,
                pending
            );

            return publicId;
        }

        function mothCancelAnimationFrame(
            id
        ) {
            const pending =
                throttledRequests.get(
                    id
                );

            if (!pending) {
                return nativeCancelRAF(
                    id
                );
            }

            pending.cancelled =
                true;

            if (
                pending.actualId !=
                null
            ) {
                nativeCancelRAF(
                    pending.actualId
                );
            }

            throttledRequests.delete(
                id
            );
        }

        try {
            page.requestAnimationFrame =
                mothRequestAnimationFrame;

            page.cancelAnimationFrame =
                mothCancelAnimationFrame;

            campoHookInstalled =
                page.requestAnimationFrame ===
                mothRequestAnimationFrame;
        } catch (error) {
            console.warn(
                '[PokéIdle Performance+] rAF hook failed',
                error
            );

            campoHookInstalled =
                false;
        }

        return campoHookInstalled;
    }

    // ------------------------------------------------------------------
    // Hot presentation interval throttling
    // ------------------------------------------------------------------

    const uiTimerClassification =
        new WeakMap();

    let uiTimerHookInstalled =
        false;

    function classifyUiTimer(
        callback,
        delay
    ) {
        if (
            typeof callback !==
                'function'
        ) {
            return null;
        }

        if (
            uiTimerClassification.has(
                callback
            )
        ) {
            return (
                uiTimerClassification.get(
                    callback
                ) ||
                null
            );
        }

        const name =
            String(
                callback.name ||
                ''
            );

        const source =
            String(
                callback
            );

        let kind =
            null;

        if (
            name ===
                'tiqueCentroSaida'
        ) {
            kind =
                'exitHud';
        } else if (
            name ===
                'pintarCaidos'
        ) {
            kind =
                'fallen';
        } else if (
            name ===
                'pintarPillDeFila' ||
            name ===
                'tiqueFilaNoModal'
        ) {
            kind =
                'pvpTicker';
        } else if (
            name ===
                'tiqueCentro'
        ) {
            kind =
                'centerTicker';
        } else if (
            Number(delay) ===
                100 &&
            source.includes(
                'reposicionarGolpesPainel'
            ) &&
            source.includes(
                'golpesCooldownFim'
            )
        ) {
            kind =
                'moveHud';
        }

        uiTimerClassification.set(
            callback,
            kind ||
                false
        );

        return kind;
    }

    function uiTimerMinimum(
        kind
    ) {
        if (
            !settings.enabled ||
            currentUi ===
                'off'
        ) {
            return 0;
        }

        /*
         * Any fresh interaction temporarily restores native UI cadence.
         * Performance+ should disappear when the player starts using the
         * interface, then save work again after the short boost window.
         */
        if (
            Date.now() <
            interactionBoostUntil
        ) {
            return 0;
        }

        if (
            kind ===
                'moveHud'
        ) {
            if (
                currentUi ===
                    'lite'
            ) {
                return 250;
            }

            /*
             * The panel is hidden by our aggressive/performance CSS. One
             * slow sweep keeps its state fresh for instant restoration.
             */
            return currentUi ===
                'performance'
                ? 2000
                : 1000;
        }

        if (
            kind ===
                'exitHud'
        ) {
            if (
                currentUi ===
                    'lite'
            ) {
                return 160;
            }

            return currentUi ===
                'performance'
                ? 500
                : 250;
        }

        if (
            kind ===
                'fallen'
        ) {
            /*
             * Auto Catch consumes the upstream fallen-body DOM, so never
             * slow this producer while Auto Catch is active.
             */
            if (
                autoCatchEnabled()
            ) {
                return 0;
            }

            return currentUi ===
                'performance'
                ? 750
                : currentUi ===
                    'aggressive'
                    ? 500
                    : 250;
        }

        if (
            kind ===
                'pvpTicker'
        ) {
            return currentUi ===
                'performance'
                ? 1500
                : currentUi ===
                    'aggressive'
                    ? 1000
                    : 500;
        }

        if (
            kind ===
                'centerTicker'
        ) {
            return currentUi ===
                'performance'
                ? 1500
                : 1000;
        }

        return 0;
    }

    function installUiTimerHook() {
        if (
            uiTimerHookInstalled
        ) {
            return true;
        }

        function mothSetInterval(
            callback,
            delay,
            ...args
        ) {
            const kind =
                classifyUiTimer(
                    callback,
                    delay
                );

            if (!kind) {
                return nativeSetInterval(
                    callback,
                    delay,
                    ...args
                );
            }

            let lastRun =
                -Infinity;

            const wrapped =
                function (
                    ...callbackArgs
                ) {
                    const now =
                        performance.now();

                    const minimum =
                        uiTimerMinimum(
                            kind
                        );

                    if (
                        minimum > 0 &&
                        now -
                            lastRun <
                            minimum
                    ) {
                        uiTimerSkippedWindow++;

                        return;
                    }

                    lastRun =
                        now;

                    uiTimerRunsWindow++;

                    return callback.apply(
                        this,
                        callbackArgs
                    );
                };

            return nativeSetInterval(
                wrapped,
                delay,
                ...args
            );
        }

        try {
            page.setInterval =
                mothSetInterval;

            /*
             * IDs are native interval IDs; clearInterval needs no mapping.
             */
            page.clearInterval =
                nativeClearInterval;

            uiTimerHookInstalled =
                page.setInterval ===
                mothSetInterval;
        } catch (error) {
            console.warn(
                '[PokéIdle Performance+] UI timer hook failed',
                error
            );

            uiTimerHookInstalled =
                false;
        }

        return uiTimerHookInstalled;
    }

    // Install both hooks before app.js/campo.mjs schedule their permanent loops.
    installCampoHook();
    installUiTimerHook();

    // ------------------------------------------------------------------
    // Runtime pressure measurement
    // ------------------------------------------------------------------

    try {
        const observer =
            new PerformanceObserver(list => {
                const now =
                    performance.now();

                for (
                    const entry of
                    list.getEntries()
                ) {
                    longTasks.push({
                        time: now,
                        duration:
                            entry.duration
                    });
                }
            });

        observer.observe({
            type: 'longtask',
            buffered: false
        });
    } catch {}

    function monitorFrame(now) {
        frameCount++;

        if (previousMonitorFrame) {
            const gap =
                now -
                previousMonitorFrame;

            if (gap > 34) {
                jankFrames.push({
                    time: now,
                    gap
                });
            }
        }

        previousMonitorFrame = now;

        const elapsed =
            now -
            frameWindowStart;

        if (elapsed >= 1000) {
            browserFps =
                frameCount *
                1000 /
                elapsed;

            frameCount = 0;
            frameWindowStart = now;
        }

        nativeRAF?.(monitorFrame);
    }

    nativeRAF?.(monitorFrame);

    function prunePerformanceSamples() {
        const now =
            performance.now();

        const cutoff =
            now - 5000;

        while (
            longTasks.length &&
            longTasks[0].time < cutoff
        ) {
            longTasks.shift();
        }

        while (
            jankFrames.length &&
            jankFrames[0].time < cutoff
        ) {
            jankFrames.shift();
        }

        const longMs =
            longTasks.reduce(
                (sum, item) =>
                    sum +
                    item.duration,
                0
            );

        longTaskMsPerSecond =
            longMs / 5;

        jankPerSecond =
            jankFrames.length / 5;

        if (
            document.hidden
        ) {
            pressure = 'background';
        } else if (
            longTaskMsPerSecond >= 90 ||
            jankPerSecond >= 5 ||
            (
                browserFps > 0 &&
                browserFps < 42
            )
        ) {
            pressure = 'heavy';
        } else if (
            longTaskMsPerSecond >= 35 ||
            jankPerSecond >= 2.5 ||
            (
                browserFps > 0 &&
                browserFps < 53
            )
        ) {
            pressure = 'medium';
        } else {
            pressure = 'light';
        }
    }

    function updateAdaptiveDecision() {
        const p =
            profile();

        if (!p.adaptive) {
            return;
        }

        const idleSeconds =
            (
                Date.now() -
                lastActivity
            ) /
            1000;

        if (
            document.hidden
        ) {
            adaptiveDecision =
                p.backgroundScene;

            adaptiveCandidate =
                adaptiveDecision;

            adaptiveCandidateStreak =
                0;

            return;
        }

        if (
            p.idleSeconds > 0 &&
            idleSeconds >=
                p.idleSeconds
        ) {
            adaptiveDecision =
                p.idleScene;

            adaptiveCandidate =
                adaptiveDecision;

            adaptiveCandidateStreak =
                0;

            return;
        }

        if (
            Date.now() <
            interactionBoostUntil
        ) {
            adaptiveDecision =
                p.scene;

            adaptiveCandidate =
                adaptiveDecision;

            adaptiveCandidateStreak =
                0;

            return;
        }

        const desired =
            pressure ===
                'heavy'
                ? '12'
                : pressure ===
                    'medium'
                    ? '20'
                    : p.scene;

        if (
            desired ===
            adaptiveDecision
        ) {
            adaptiveCandidate =
                desired;

            adaptiveCandidateStreak =
                0;

            return;
        }

        if (
            adaptiveCandidate ===
                desired
        ) {
            adaptiveCandidateStreak++;
        } else {
            adaptiveCandidate =
                desired;

            adaptiveCandidateStreak =
                1;
        }

        const currentFps =
            Number(
                adaptiveDecision
            ) ||
            0;

        const desiredFps =
            Number(desired) ||
            0;

        /*
         * Reduce quickly under sustained load, recover more slowly so the
         * renderer does not oscillate around a threshold.
         */
        const required =
            desiredFps <
                currentFps
                ? 2
                : 4;

        if (
            adaptiveCandidateStreak >=
            required
        ) {
            adaptiveDecision =
                desired;

            adaptiveCandidateStreak =
                0;
        }
    }

    // ------------------------------------------------------------------
    // UI performance levels
    // ------------------------------------------------------------------

    function collapseChat() {
        const button =
            q('#btn-chat-toggle');

        if (!button) {
            return;
        }

        if (
            button.getAttribute(
                'aria-expanded'
            ) !== 'false'
        ) {
            button.click();
            chatCollapsedByAddon = true;
        }
    }

    function restoreChat() {
        if (!chatCollapsedByAddon) {
            return;
        }

        const button =
            q('#btn-chat-toggle');

        if (
            button?.getAttribute(
                'aria-expanded'
            ) === 'false'
        ) {
            button.click();
        }

        chatCollapsedByAddon = false;
    }

    function isIdleForProfile(p) {
        if (document.hidden) {
            return true;
        }

        if (p.idleSeconds <= 0) {
            return false;
        }

        return (
            Date.now() -
            lastActivity
        ) >=
            p.idleSeconds * 1000;
    }

    function calculateMode() {
        if (!settings.enabled) {
            return 'full';
        }

        const p = profile();

        if (p.adaptive) {
            return adaptiveDecision;
        }

        if (document.hidden) {
            return p.backgroundScene;
        }

        if (isIdleForProfile(p)) {
            return p.idleScene;
        }

        return p.scene;
    }

    function calculateUiLevel() {
        if (!settings.enabled) {
            return 'off';
        }

        const p = profile();

        if (
            p.adaptive &&
            !document.hidden &&
            !isIdleForProfile(p)
        ) {
            /*
             * Under heavy pressure we remove the log/chat render work too;
             * when load recovers we return to the lighter move-HUD-only
             * reduction.
             */
            return pressure === 'heavy'
                ? 'aggressive'
                : p.ui;
        }

        return isIdleForProfile(p)
            ? p.idleUi
            : p.ui;
    }

    function syncChatPolicy() {
        /*
         * Performance+ no longer changes chat expansion state at all.
         * Collapsing a core communication panel is too intrusive and can
         * leave the interface looking broken after profile/script changes.
         */
        restoreChat();
    }

    function applyMode() {
        currentMode =
            calculateMode();

        currentUi =
            calculateUiLevel();

        const p = profile();
        const html =
            document.documentElement;

        html.classList.toggle(
            'moth-perf-reduced',
            settings.enabled &&
                p.effects === 'reduced'
        );

        html.classList.toggle(
            'moth-perf-minimal',
            settings.enabled &&
                p.effects === 'minimal'
        );

        for (
            const level of [
                'lite',
                'aggressive',
                'performance'
            ]
        ) {
            html.classList.toggle(
                'moth-ui-' + level,
                settings.enabled &&
                    currentUi === level
            );
        }

        html.classList.toggle(
            'moth-scene-sleep',
            settings.enabled &&
                currentMode === '2'
        );

        syncNativeOptimized();
        syncChatPolicy();
        updateUI();
    }

    function recordActivity() {
        lastActivity = Date.now();

        /*
         * Adaptive mode immediately returns to its responsive ceiling
         * after interaction, then reevaluates load a few seconds later.
         */
        interactionBoostUntil =
            Date.now() + 2500;

        if (
            profile().adaptive
        ) {
            adaptiveDecision =
                profile().scene;

            adaptiveCandidate =
                adaptiveDecision;

            adaptiveCandidateStreak =
                0;
        }

        applyMode();
    }

    for (
        const eventName of [
            'pointerdown',
            'keydown',
            'wheel',
            'touchstart'
        ]
    ) {
        window.addEventListener(
            eventName,
            recordActivity,
            {
                passive: true,
                capture: true
            }
        );
    }

    document.addEventListener(
        'visibilitychange',
        () => {
            if (
                !document.hidden
            ) {
                lastActivity =
                    Date.now();

                interactionBoostUntil =
                    Date.now() +
                    1500;

                if (
                    profile()
                        .adaptive
                ) {
                    adaptiveDecision =
                        profile().scene;

                    adaptiveCandidate =
                        adaptiveDecision;

                    adaptiveCandidateStreak =
                        0;
                }
            }

            applyMode();
        }
    );


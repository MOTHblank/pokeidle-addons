// ==UserScript==
// @name         PokéIdle Performance+
// @namespace    moth.pokeidle
// @version      2.1.0
// @description  Lightweight scene throttling that preserves hunt state and Auto Catch.
// @match        https://pokeidle.io/*
// @match        https://www.pokeidle.io/*
// @grant        none
// @sandbox      raw
// @run-at       document-start
// ==/UserScript==

(() => {
    'use strict';

    const STORAGE_KEY = 'moth-pokeidle-performance-v3';
    const TRIGGER_ID = 'moth-performance-trigger';
    const PANEL_ID = 'moth-performance-panel';
    const STYLE_ID = 'moth-performance-style';

    const PROFILES = {
        full: {
            label: 'Full',
            active: 'full',
            idle: 'full',
            background: 'full',
            idleSeconds: 0,
            effects: 'full',
            collapseChat: false
        },
        balanced: {
            label: 'Balanced',
            active: '30',
            idle: '15',
            background: 'off',
            idleSeconds: 60,
            effects: 'reduced',
            collapseChat: false
        },
        afk: {
            label: 'AFK',
            active: '15',
            idle: 'off',
            background: 'off',
            idleSeconds: 20,
            effects: 'reduced',
            collapseChat: true
        },
        capture: {
            label: 'Capture Saver',
            active: '15',
            idle: 'off',
            background: 'off',
            idleSeconds: 10,
            effects: 'minimal',
            collapseChat: true
        }
    };

    const DEFAULTS = {
        enabled: true,
        profile: 'balanced'
    };

    const q = (selector, root = document) => root.querySelector(selector);

    let settings = loadSettings();
    let lastActivity = Date.now();
    let currentRenderMode = 'full';
    let frameAllowed = true;
    let lastAllowedFrame = 0;
    let lastClearCall = -Infinity;
    let chatCollapsedByAddon = false;

    let sceneFramesWindow = 0;
    let blockedCallsWindow = 0;
    let passedCallsWindow = 0;
    let sceneFps = 0;
    let blockedPerSecond = 0;
    let passedPerSecond = 0;
    let hookInstalled = false;

    function loadSettings() {
        try {
            return {
                ...DEFAULTS,
                ...JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}')
            };
        } catch {
            return { ...DEFAULTS };
        }
    }

    function saveSettings() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
    }

    function profile() {
        return PROFILES[settings.profile] || PROFILES.balanced;
    }

    function isNativeEconomy() {
        return document.documentElement.classList.contains('modo-economia');
    }

    function autoCatchEnabled() {
        const button = q('#moth-ac-toggle');
        if (button) return button.textContent.trim().toUpperCase() === 'ON';

        try {
            return Boolean(
                JSON.parse(localStorage.getItem('moth-pokeidle-autocatch-v4') || '{}').enabled
            );
        } catch {
            return false;
        }
    }

    // ------------------------------------------------------------------
    // Canvas hook
    // ------------------------------------------------------------------

    function installCanvasHook() {
        if (hookInstalled) return true;

        const proto = window.CanvasRenderingContext2D?.prototype;
        if (!proto) return false;

        const sceneContext = ctx => ctx?.canvas?.id === 'cena';

        const intervalForMode = () => {
            if (currentRenderMode === '30') return 1000 / 30;
            if (currentRenderMode === '15') return 1000 / 15;
            return 0;
        };

        const clearOriginal = proto.clearRect;

        if (typeof clearOriginal === 'function') {
            proto.clearRect = function (...args) {
                if (!sceneContext(this)) {
                    return clearOriginal.apply(this, args);
                }

                if (!settings.enabled || currentRenderMode === 'full') {
                    frameAllowed = true;
                    sceneFramesWindow++;
                    passedCallsWindow++;
                    return clearOriginal.apply(this, args);
                }

                if (currentRenderMode === 'off') {
                    frameAllowed = false;
                    blockedCallsWindow++;
                    return;
                }

                const now = performance.now();

                if (now - lastClearCall > 4) {
                    const interval = intervalForMode();
                    frameAllowed = (now - lastAllowedFrame) >= interval;

                    if (frameAllowed) {
                        lastAllowedFrame = now;
                        sceneFramesWindow++;
                    }
                }

                lastClearCall = now;

                if (!frameAllowed) {
                    blockedCallsWindow++;
                    return;
                }

                passedCallsWindow++;
                return clearOriginal.apply(this, args);
            };
        }

        const methods = [
            'drawImage',
            'fill',
            'stroke',
            'fillRect',
            'strokeRect',
            'fillText',
            'strokeText',
            'putImageData',
            'beginPath',
            'closePath',
            'moveTo',
            'lineTo',
            'rect',
            'roundRect',
            'arc',
            'arcTo',
            'ellipse',
            'bezierCurveTo',
            'quadraticCurveTo',
            'save',
            'restore',
            'translate',
            'rotate',
            'scale',
            'transform',
            'setTransform',
            'resetTransform',
            'clip',
            'setLineDash'
        ];

        for (const name of methods) {
            const original = proto[name];
            if (typeof original !== 'function') continue;

            proto[name] = function (...args) {
                if (
                    sceneContext(this) &&
                    settings.enabled &&
                    (
                        currentRenderMode === 'off' ||
                        (currentRenderMode !== 'full' && !frameAllowed)
                    )
                ) {
                    blockedCallsWindow++;
                    return;
                }

                if (sceneContext(this)) passedCallsWindow++;
                return original.apply(this, args);
            };
        }

        hookInstalled = true;
        console.info('[PokéIdle Performance+] canvas hook installed');
        return true;
    }

    // ------------------------------------------------------------------
    // Adaptive mode
    // ------------------------------------------------------------------

    function calculateMode() {
        if (!settings.enabled) return 'full';

        const p = profile();

        if (document.hidden) return p.background;

        const idleSeconds = (Date.now() - lastActivity) / 1000;
        if (p.idleSeconds > 0 && idleSeconds >= p.idleSeconds) return p.idle;

        return p.active;
    }

    function collapseChat() {
        const toggle = q('#btn-chat-toggle');
        if (!toggle) return;

        if (toggle.getAttribute('aria-expanded') !== 'false') {
            toggle.click();
            chatCollapsedByAddon = true;
        }
    }

    function restoreChat() {
        if (!chatCollapsedByAddon) return;

        const toggle = q('#btn-chat-toggle');
        if (toggle?.getAttribute('aria-expanded') === 'false') toggle.click();

        chatCollapsedByAddon = false;
    }

    function applyMode() {
        currentRenderMode = calculateMode();

        const p = profile();
        const html = document.documentElement;

        html.classList.toggle('moth-scene-off', settings.enabled && currentRenderMode === 'off');
        html.classList.toggle('moth-perf-reduced', settings.enabled && p.effects === 'reduced');
        html.classList.toggle('moth-perf-minimal', settings.enabled && p.effects === 'minimal');

        const idle = document.hidden || currentRenderMode === p.idle;

        if (settings.enabled && p.collapseChat && idle) collapseChat();
        else restoreChat();

        updateUI();
    }

    function recordActivity() {
        lastActivity = Date.now();
        applyMode();
    }

    for (const eventName of ['pointerdown', 'keydown', 'wheel', 'touchstart']) {
        window.addEventListener(eventName, recordActivity, {
            passive: true,
            capture: true
        });
    }

    document.addEventListener('visibilitychange', applyMode);

    // ------------------------------------------------------------------
    // Styles and light UI
    // ------------------------------------------------------------------

    function installStyles() {
        if (q('#' + STYLE_ID)) return;

        const style = document.createElement('style');
        style.id = STYLE_ID;

        style.textContent = `
            html.moth-perf-reduced :is(
                .ab-confete *,
                .recompensa *,
                .shiny-anuncio *,
                .lendario-anuncio *,
                .evento-faixa *
            ) {
                animation-duration: .001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .001ms !important;
            }

            html.moth-perf-minimal :is(
                .ab-confete *,
                .recompensa *,
                .shiny-anuncio *,
                .lendario-anuncio *,
                .evento-faixa *,
                .pvp-fila-pill *
            ) {
                animation-duration: .001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .001ms !important;
                backdrop-filter: none !important;
                filter: none !important;
            }

            html.moth-perf-minimal :is(
                .la-relampago,
                .la-raios,
                .la-faiscas,
                .rc-flash,
                .rc-particulas,
                .ab-confete
            ) {
                display: none !important;
            }

            html.moth-scene-off #cena {
                opacity: .035 !important;
            }

            #${TRIGGER_ID} {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                flex: 0 0 auto !important;
                min-width: 0 !important;
                width: auto !important;
                height: 25px !important;
                padding: 3px 7px !important;
                margin-left: auto !important;
                border: 1px solid rgba(255,255,255,.16) !important;
                border-radius: 999px !important;
                background: rgba(40,31,35,.75) !important;
                color: #ddd !important;
                font: 700 9px/1 system-ui,sans-serif !important;
                cursor: pointer !important;
                opacity: 1 !important;
                visibility: visible !important;
                position: relative !important;
                z-index: 20 !important;
            }

            #${TRIGGER_ID}.working {
                color: #8fe0a5 !important;
                border-color: rgba(100,210,130,.35) !important;
            }

            #${TRIGGER_ID}.warning {
                color: #ffd27c !important;
                border-color: rgba(255,190,80,.38) !important;
            }

            #${PANEL_ID} {
                margin: 7px 0 9px !important;
                padding: 8px !important;
                border: 1px solid rgba(255,255,255,.12) !important;
                border-radius: 7px !important;
                background: rgba(20,16,19,.65) !important;
                color: #eee !important;
                font: 10px/1.25 system-ui,sans-serif !important;
            }

            #${PANEL_ID}[hidden] {
                display: none !important;
            }

            #${PANEL_ID} * {
                box-sizing: border-box !important;
            }

            #${PANEL_ID} .mpp-head {
                display: flex;
                align-items: center;
                gap: 6px;
                margin-bottom: 7px;
            }

            #${PANEL_ID} .mpp-head strong {
                flex: 1;
                font-size: 11px;
            }

            #${PANEL_ID} .mpp-metrics {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 4px;
                margin-bottom: 7px;
            }

            #${PANEL_ID} .mpp-metric {
                padding: 4px;
                border-radius: 5px;
                background: rgba(255,255,255,.05);
                text-align: center;
            }

            #${PANEL_ID} .mpp-metric b {
                display: block;
                font-size: 11px;
            }

            #${PANEL_ID} .mpp-metric span {
                color: #998f93;
                font-size: 8px;
            }

            #${PANEL_ID} .mpp-row {
                display: flex;
                align-items: center;
                gap: 6px;
                min-height: 27px;
            }

            #${PANEL_ID} .mpp-row label {
                flex: 1;
            }

            #${PANEL_ID} select {
                width: 115px;
                padding: 3px 4px;
                border: 1px solid rgba(255,255,255,.12);
                border-radius: 4px;
                background: #211a1e;
                color: #fff;
                font: inherit;
            }

            #${PANEL_ID} .mpp-status {
                margin-top: 6px;
                padding-top: 6px;
                border-top: 1px solid rgba(255,255,255,.07);
                color: #a89da2;
                font-size: 9px;
            }
        `;

        (document.head || document.documentElement).appendChild(style);
    }

    function renderLabel(mode) {
        return {
            full: 'Full',
            '30': '30',
            '15': '15',
            off: 'Off'
        }[mode] || mode;
    }

    function ensurePanel() {
        let panel = q('#' + PANEL_ID);
        if (panel) return panel;

        const host = q('#auto-corpo');
        if (!host) return null;

        panel = document.createElement('section');
        panel.id = PANEL_ID;
        panel.hidden = true;
        panel.innerHTML = `
            <div class="mpp-head">
                <strong>Performance+</strong>
                <label><input id="mpp-enabled" type="checkbox"> On</label>
            </div>

            <div class="mpp-metrics">
                <div class="mpp-metric"><b id="mpp-scene-fps">—</b><span>scene FPS</span></div>
                <div class="mpp-metric"><b id="mpp-blocked">0</b><span>blocked/s</span></div>
                <div class="mpp-metric"><b id="mpp-capture">—</b><span>auto catch</span></div>
            </div>

            <div class="mpp-row">
                <label>Profile</label>
                <select id="mpp-profile">
                    <option value="full">Full</option>
                    <option value="balanced">Balanced</option>
                    <option value="afk">AFK</option>
                    <option value="capture">Capture Saver</option>
                </select>
            </div>

            <div class="mpp-status" id="mpp-status">Hook loaded.</div>
        `;

        host.prepend(panel);

        q('#mpp-enabled', panel).addEventListener('change', event => {
            settings.enabled = event.target.checked;
            saveSettings();
            applyMode();
        });

        q('#mpp-profile', panel).addEventListener('change', event => {
            settings.profile = event.target.value;
            lastActivity = Date.now();
            saveSettings();
            applyMode();
        });

        return panel;
    }

    function ensureTrigger() {
        if (!document.body) return false;

        installStyles();
        installCanvasHook();
        ensurePanel();

        let trigger = q('#' + TRIGGER_ID);
        if (trigger) return true;

        const header = q('#p-auto .painel-cab-auto') || q('#p-auto .painel-cab');
        if (!header) return false;

        trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.id = TRIGGER_ID;
        trigger.textContent = 'Perf · load';
        trigger.title = 'Performance+ loaded';

        trigger.addEventListener('click', event => {
            event.preventDefault();
            event.stopPropagation();

            const autoToggle = q('#btn-auto-toggle');
            if (autoToggle?.getAttribute('aria-expanded') === 'false') autoToggle.click();

            const panel = ensurePanel();
            if (panel) panel.hidden = !panel.hidden;
        });

        const collapse = q('#btn-auto-toggle', header);
        if (collapse) header.insertBefore(trigger, collapse);
        else header.appendChild(trigger);

        return true;
    }

    function updateUI() {
        const trigger = q('#' + TRIGGER_ID);
        const panel = q('#' + PANEL_ID);

        if (panel) {
            const enabled = q('#mpp-enabled', panel);
            const select = q('#mpp-profile', panel);

            if (enabled) enabled.checked = settings.enabled;
            if (select) select.value = settings.profile;

            const fpsEl = q('#mpp-scene-fps', panel);
            const blockedEl = q('#mpp-blocked', panel);
            const captureEl = q('#mpp-capture', panel);
            const statusEl = q('#mpp-status', panel);

            if (fpsEl) fpsEl.textContent = isNativeEconomy() ? 'Eco' : sceneFps;
            if (blockedEl) blockedEl.textContent = blockedPerSecond.toLocaleString();
            if (captureEl) captureEl.textContent = autoCatchEnabled() ? 'ON' : 'OFF';

            if (statusEl) {
                if (isNativeEconomy()) {
                    statusEl.textContent =
                        'Native Economy is active. It removes battlefield state, so Auto Catch has no fallen targets.';
                } else if (!hookInstalled) {
                    statusEl.textContent =
                        'Canvas hook not installed yet.';
                } else if (!settings.enabled) {
                    statusEl.textContent =
                        'Loaded, but disabled.';
                } else if (currentRenderMode === 'full') {
                    statusEl.textContent =
                        'Loaded. Full scene rendering is allowed by this profile.';
                } else if (blockedPerSecond > 0) {
                    statusEl.textContent =
                        `Working: suppressing ${blockedPerSecond.toLocaleString()} scene canvas calls each second.`;
                } else {
                    statusEl.textContent =
                        'Hook loaded; waiting for #cena drawing. If this stays at 0 during a hunt, the game is using a different render path.';
                }
            }
        }

        if (trigger) {
            trigger.classList.remove('working', 'warning');

            if (isNativeEconomy()) {
                trigger.textContent = 'Perf · Native Eco';
                trigger.classList.add('warning');
            } else if (!settings.enabled) {
                trigger.textContent = 'Perf · Off';
            } else {
                trigger.textContent =
                    `Perf · ${renderLabel(currentRenderMode)} · ↓${blockedPerSecond.toLocaleString()}`;

                if (blockedPerSecond > 0) trigger.classList.add('working');
                else if (currentRenderMode !== 'full') trigger.classList.add('warning');
            }
        }
    }

    // ------------------------------------------------------------------
    // Metrics + bootstrap
    // ------------------------------------------------------------------

    setInterval(() => {
        sceneFps = sceneFramesWindow;
        blockedPerSecond = blockedCallsWindow;
        passedPerSecond = passedCallsWindow;

        sceneFramesWindow = 0;
        blockedCallsWindow = 0;
        passedCallsWindow = 0;

        updateUI();
    }, 1000);

    function bootstrap() {
        ensureTrigger();
        installCanvasHook();
        applyMode();

        setInterval(() => {
            ensureTrigger();
            installCanvasHook();
            applyMode();
        }, 1000);

        console.info('[PokéIdle Performance+] loaded');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
        bootstrap();
    }
})();

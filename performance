// ==UserScript==
// @name         PokéIdle Performance+
// @namespace    moth.pokeidle
// @version      3.0.0
// @description  Throttles PokéIdle's scene animation loop while preserving hunt state and Auto Catch.
// @match        https://pokeidle.io/*
// @match        https://www.pokeidle.io/*
// @grant        unsafeWindow
// @run-at       document-start
// ==/UserScript==

(() => {
    'use strict';

    const STORAGE_KEY = 'moth-pokeidle-performance-v4';
    const TRIGGER_ID = 'moth-performance-trigger';
    const PANEL_ID = 'moth-performance-panel';
    const STYLE_ID = 'moth-performance-style';

    const page = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
    const q = (selector, root = document) => root.querySelector(selector);

    const PROFILES = {
        full: {
            label: 'Full',
            active: 'full',
            idle: 'full',
            background: 'full',
            idleSeconds: 0,
            effects: 'full',
            collapseChat: false
        },
        balanced: {
            label: 'Balanced',
            active: '30',
            idle: '15',
            background: '2',
            idleSeconds: 60,
            effects: 'reduced',
            collapseChat: false
        },
        afk: {
            label: 'AFK',
            active: '15',
            idle: '2',
            background: '2',
            idleSeconds: 20,
            effects: 'reduced',
            collapseChat: true
        },
        capture: {
            label: 'Capture Saver',
            active: '15',
            idle: '2',
            background: '2',
            idleSeconds: 10,
            effects: 'minimal',
            collapseChat: true
        }
    };

    const DEFAULTS = {
        enabled: true,
        profile: 'balanced'
    };

    let settings = loadSettings();
    let lastActivity = Date.now();
    let currentMode = 'full';
    let chatCollapsedByAddon = false;

    // Renderer diagnostics.
    let hookInstalled = false;
    let detectorInstalled = false;
    let sceneCallbacksFound = 0;
    let sceneRunsWindow = 0;
    let throttledWindow = 0;
    let sceneRunsPerSecond = 0;
    let throttledPerSecond = 0;

    // rAF hook state.
    const sceneCallbacks = new WeakSet();
    const sceneCallbackSources = new Set();
    const callbackState = new WeakMap();
    const pendingRaf = new Map();
    let nextRafId = -1;
    let activeRafCallback = null;
    let sceneTouchedInActiveRaf = false;

    const originalRAF = page.requestAnimationFrame?.bind(page);
    const originalCancelRAF = page.cancelAnimationFrame?.bind(page);

    function loadSettings() {
        try {
            return {
                ...DEFAULTS,
                ...JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}')
            };
        } catch {
            return { ...DEFAULTS };
        }
    }

    function saveSettings() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
    }

    function profile() {
        return PROFILES[settings.profile] || PROFILES.balanced;
    }

    function isNativeEconomy() {
        return document.documentElement.classList.contains('modo-economia');
    }

    function autoCatchEnabled() {
        const button = q('#moth-ac-toggle');
        if (button) return button.textContent.trim().toUpperCase() === 'ON';

        try {
            return Boolean(
                JSON.parse(localStorage.getItem('moth-pokeidle-autocatch-v4') || '{}').enabled
            );
        } catch {
            return false;
        }
    }

    // ------------------------------------------------------------------
    // Scene-loop detection
    // ------------------------------------------------------------------

    function callbackSource(callback) {
        try {
            return Function.prototype.toString.call(callback).slice(0, 1200);
        } catch {
            return '';
        }
    }

    function markSceneTouch(ctx) {
        if (!activeRafCallback || ctx?.canvas?.id !== 'cena') return;

        sceneTouchedInActiveRaf = true;

        if (!sceneCallbacks.has(activeRafCallback)) {
            sceneCallbacks.add(activeRafCallback);

            const source = callbackSource(activeRafCallback);
            if (source) sceneCallbackSources.add(source);

            sceneCallbacksFound++;
            console.info('[PokéIdle Performance+] identified scene rAF callback', activeRafCallback);
        }
    }

    function installSceneDetector() {
        if (detectorInstalled) return true;

        const proto = page.CanvasRenderingContext2D?.prototype;
        if (!proto) return false;

        for (const name of ['clearRect', 'drawImage']) {
            const original = proto[name];
            if (typeof original !== 'function') continue;

            // Avoid wrapping twice if Tampermonkey reinjects.
            if (original.__mothPerformanceWrapped) continue;

            const wrapped = function (...args) {
                markSceneTouch(this);
                return original.apply(this, args);
            };

            try {
                Object.defineProperty(wrapped, '__mothPerformanceWrapped', {
                    value: true
                });
            } catch {}

            proto[name] = wrapped;
        }

        detectorInstalled = true;
        return true;
    }

    function intervalForMode(mode) {
        if (mode === '30') return 1000 / 30;
        if (mode === '15') return 1000 / 15;
        if (mode === '2') return 500;
        return 0;
    }

    function knownSceneCallback(callback) {
        if (sceneCallbacks.has(callback)) return true;

        const source = callbackSource(callback);
        return Boolean(source && sceneCallbackSources.has(source));
    }

    // ------------------------------------------------------------------
    // requestAnimationFrame hook
    //
    // Unlike v2, this suppresses the campo.mjs animation callback itself.
    // That avoids doing the scene's JS work on frames we were going to
    // discard anyway.
    // ------------------------------------------------------------------

    function installRafHook() {
        if (hookInstalled || !originalRAF || !originalCancelRAF) return hookInstalled;

        installSceneDetector();

        function mothRequestAnimationFrame(callback) {
            if (typeof callback !== 'function') {
                return originalRAF(callback);
            }

            const publicId = nextRafId--;
            const pending = {
                actualId: null,
                cancelled: false,
                callback
            };

            const runner = timestamp => {
                if (pending.cancelled) {
                    pendingRaf.delete(publicId);
                    return;
                }

                const scene = knownSceneCallback(callback);
                const interval =
                    settings.enabled && scene
                        ? intervalForMode(currentMode)
                        : 0;

                if (interval > 0) {
                    let state = callbackState.get(callback);

                    if (!state) {
                        state = { lastRun: -Infinity };
                        callbackState.set(callback, state);
                    }

                    if ((timestamp - state.lastRun) < interval) {
                        throttledWindow++;
                        pending.actualId = originalRAF(runner);
                        return;
                    }

                    state.lastRun = timestamp;
                }

                activeRafCallback = callback;
                sceneTouchedInActiveRaf = false;

                try {
                    callback.call(page, timestamp);
                } finally {
                    if (sceneTouchedInActiveRaf) {
                        sceneCallbacks.add(callback);

                        const source = callbackSource(callback);
                        if (source) sceneCallbackSources.add(source);

                        sceneRunsWindow++;
                    }

                    activeRafCallback = null;
                    sceneTouchedInActiveRaf = false;
                    pendingRaf.delete(publicId);
                }
            };

            pending.actualId = originalRAF(runner);
            pendingRaf.set(publicId, pending);

            return publicId;
        }

        function mothCancelAnimationFrame(id) {
            const pending = pendingRaf.get(id);

            if (pending) {
                pending.cancelled = true;

                if (pending.actualId != null) {
                    originalCancelRAF(pending.actualId);
                }

                pendingRaf.delete(id);
                return;
            }

            return originalCancelRAF(id);
        }

        try {
            page.requestAnimationFrame = mothRequestAnimationFrame;
            page.cancelAnimationFrame = mothCancelAnimationFrame;

            hookInstalled =
                page.requestAnimationFrame === mothRequestAnimationFrame;

            if (hookInstalled) {
                console.info('[PokéIdle Performance+] page-world rAF hook installed');
            }
        } catch (error) {
            console.warn('[PokéIdle Performance+] could not patch rAF', error);
            hookInstalled = false;
        }

        return hookInstalled;
    }

    // ------------------------------------------------------------------
    // Adaptive mode
    // ------------------------------------------------------------------

    function calculateMode() {
        if (!settings.enabled) return 'full';

        const p = profile();

        if (document.hidden) return p.background;

        const idleSeconds = (Date.now() - lastActivity) / 1000;

        if (p.idleSeconds > 0 && idleSeconds >= p.idleSeconds) {
            return p.idle;
        }

        return p.active;
    }

    function collapseChat() {
        const button = q('#btn-chat-toggle');
        if (!button) return;

        if (button.getAttribute('aria-expanded') !== 'false') {
            button.click();
            chatCollapsedByAddon = true;
        }
    }

    function restoreChat() {
        if (!chatCollapsedByAddon) return;

        const button = q('#btn-chat-toggle');
        if (button?.getAttribute('aria-expanded') === 'false') button.click();

        chatCollapsedByAddon = false;
    }

    function applyMode() {
        currentMode = calculateMode();

        const p = profile();
        const html = document.documentElement;

        html.classList.toggle(
            'moth-perf-reduced',
            settings.enabled && p.effects === 'reduced'
        );

        html.classList.toggle(
            'moth-perf-minimal',
            settings.enabled && p.effects === 'minimal'
        );

        html.classList.toggle(
            'moth-scene-sleep',
            settings.enabled && currentMode === '2'
        );

        const idle = document.hidden || currentMode === p.idle;

        if (settings.enabled && p.collapseChat && idle) collapseChat();
        else restoreChat();

        updateUI();
    }

    function recordActivity() {
        lastActivity = Date.now();
        applyMode();
    }

    for (const eventName of ['pointerdown', 'keydown', 'wheel', 'touchstart']) {
        window.addEventListener(eventName, recordActivity, {
            passive: true,
            capture: true
        });
    }

    document.addEventListener('visibilitychange', applyMode);

    // ------------------------------------------------------------------
    // UI performance CSS
    // ------------------------------------------------------------------

    function installStyles() {
        if (q('#' + STYLE_ID)) return;

        const style = document.createElement('style');
        style.id = STYLE_ID;

        style.textContent = `
            /*
             * Balanced removes expensive decorative motion without hiding
             * functional controls.
             */
            html.moth-perf-reduced :is(
                .ab-confete *,
                .recompensa *,
                .shiny-anuncio *,
                .lendario-anuncio *,
                .evento-faixa *,
                .pvp-fila-pill *
            ) {
                animation-duration: .001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .001ms !important;
            }

            /*
             * Capture Saver also strips costly visual CSS from ordinary UI.
             * Layout, visibility and interaction remain intact.
             */
            html.moth-perf-minimal #app *,
            html.moth-perf-minimal #app *::before,
            html.moth-perf-minimal #app *::after {
                animation-duration: .001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .001ms !important;
                backdrop-filter: none !important;
                filter: none !important;
                text-shadow: none !important;
                box-shadow: none !important;
            }

            html.moth-perf-minimal :is(
                .la-relampago,
                .la-raios,
                .la-faiscas,
                .rc-flash,
                .rc-particulas,
                .ab-confete
            ) {
                display: none !important;
            }

            /*
             * A nearly static scene should not keep an expensive composited
             * canvas looking like it is merely frozen by accident.
             */
            html.moth-scene-sleep #cena {
                opacity: .45 !important;
            }

            #${TRIGGER_ID} {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                min-width: 0 !important;
                width: auto !important;
                height: 25px !important;
                padding: 3px 7px !important;
                margin-left: auto !important;
                border: 1px solid rgba(255,255,255,.16) !important;
                border-radius: 999px !important;
                background: rgba(40,31,35,.75) !important;
                color: #ddd !important;
                font: 700 9px/1 system-ui,sans-serif !important;
                cursor: pointer !important;
                opacity: 1 !important;
                visibility: visible !important;
                position: relative !important;
                z-index: 20 !important;
            }

            #${TRIGGER_ID}.working {
                color: #8fe0a5 !important;
                border-color: rgba(100,210,130,.35) !important;
            }

            #${TRIGGER_ID}.warning {
                color: #ffd27c !important;
                border-color: rgba(255,190,80,.38) !important;
            }

            #${PANEL_ID} {
                margin: 7px 0 9px !important;
                padding: 8px !important;
                border: 1px solid rgba(255,255,255,.12) !important;
                border-radius: 7px !important;
                background: rgba(20,16,19,.65) !important;
                color: #eee !important;
                font: 10px/1.25 system-ui,sans-serif !important;
            }

            #${PANEL_ID}[hidden] {
                display: none !important;
            }

            #${PANEL_ID} * {
                box-sizing: border-box !important;
            }

            #${PANEL_ID} .mpp-head,
            #${PANEL_ID} .mpp-row {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            #${PANEL_ID} .mpp-head {
                margin-bottom: 7px;
            }

            #${PANEL_ID} .mpp-head strong,
            #${PANEL_ID} .mpp-row label {
                flex: 1;
            }

            #${PANEL_ID} .mpp-metrics {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 4px;
                margin-bottom: 7px;
            }

            #${PANEL_ID} .mpp-metric {
                padding: 4px;
                border-radius: 5px;
                background: rgba(255,255,255,.05);
                text-align: center;
            }

            #${PANEL_ID} .mpp-metric b {
                display: block;
                font-size: 11px;
            }

            #${PANEL_ID} .mpp-metric span {
                color: #998f93;
                font-size: 8px;
            }

            #${PANEL_ID} .mpp-row {
                min-height: 27px;
            }

            #${PANEL_ID} select {
                width: 115px;
                padding: 3px 4px;
                border: 1px solid rgba(255,255,255,.12);
                border-radius: 4px;
                background: #211a1e;
                color: #fff;
                font: inherit;
            }

            #${PANEL_ID} .mpp-status {
                margin-top: 6px;
                padding-top: 6px;
                border-top: 1px solid rgba(255,255,255,.07);
                color: #a89da2;
                font-size: 9px;
            }
        `;

        (document.head || document.documentElement).appendChild(style);
    }

    function labelForMode(mode) {
        return {
            full: 'Full',
            '30': '30fps',
            '15': '15fps',
            '2': '2fps'
        }[mode] || mode;
    }

    function ensurePanel() {
        let panel = q('#' + PANEL_ID);
        if (panel) return panel;

        const host = q('#auto-corpo');
        if (!host) return null;

        panel = document.createElement('section');
        panel.id = PANEL_ID;
        panel.hidden = true;

        panel.innerHTML = `
            <div class="mpp-head">
                <strong>Performance+</strong>
                <label><input id="mpp-enabled" type="checkbox"> On</label>
            </div>

            <div class="mpp-metrics">
                <div class="mpp-metric"><b id="mpp-runs">0</b><span>scene runs/s</span></div>
                <div class="mpp-metric"><b id="mpp-throttled">0</b><span>skipped/s</span></div>
                <div class="mpp-metric"><b id="mpp-capture">—</b><span>auto catch</span></div>
            </div>

            <div class="mpp-row">
                <label>Profile</label>
                <select id="mpp-profile">
                    <option value="full">Full</option>
                    <option value="balanced">Balanced</option>
                    <option value="afk">AFK</option>
                    <option value="capture">Capture Saver</option>
                </select>
            </div>

            <div class="mpp-status" id="mpp-status">Loading renderer hook…</div>
        `;

        host.prepend(panel);

        q('#mpp-enabled', panel).addEventListener('change', event => {
            settings.enabled = event.target.checked;
            saveSettings();
            applyMode();
        });

        q('#mpp-profile', panel).addEventListener('change', event => {
            settings.profile = event.target.value;
            lastActivity = Date.now();
            saveSettings();
            applyMode();
        });

        return panel;
    }

    function ensureTrigger() {
        if (!document.body) return false;

        installStyles();
        installRafHook();
        ensurePanel();

        let trigger = q('#' + TRIGGER_ID);
        if (trigger) return true;

        const header = q('#p-auto .painel-cab-auto') || q('#p-auto .painel-cab');
        if (!header) return false;

        trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.id = TRIGGER_ID;
        trigger.textContent = 'Perf · load';
        trigger.title = 'Performance+ loaded';

        trigger.addEventListener('click', event => {
            event.preventDefault();
            event.stopPropagation();

            const autoToggle = q('#btn-auto-toggle');
            if (autoToggle?.getAttribute('aria-expanded') === 'false') autoToggle.click();

            const panel = ensurePanel();
            if (panel) panel.hidden = !panel.hidden;
        });

        const collapse = q('#btn-auto-toggle', header);
        if (collapse) header.insertBefore(trigger, collapse);
        else header.appendChild(trigger);

        return true;
    }

    function updateUI() {
        const trigger = q('#' + TRIGGER_ID);
        const panel = q('#' + PANEL_ID);

        if (panel) {
            const enabled = q('#mpp-enabled', panel);
            const select = q('#mpp-profile', panel);

            if (enabled) enabled.checked = settings.enabled;
            if (select) select.value = settings.profile;

            q('#mpp-runs', panel).textContent =
                isNativeEconomy() ? 'Eco' : String(sceneRunsPerSecond);

            q('#mpp-throttled', panel).textContent =
                String(throttledPerSecond);

            q('#mpp-capture', panel).textContent =
                autoCatchEnabled() ? 'ON' : 'OFF';

            const status = q('#mpp-status', panel);

            if (isNativeEconomy()) {
                status.textContent =
                    'Native Economy is active; battlefield capture state is unavailable.';
            } else if (!hookInstalled) {
                status.textContent =
                    'Page-world requestAnimationFrame hook is not installed.';
            } else if (!settings.enabled) {
                status.textContent =
                    'Loaded, currently disabled.';
            } else if (sceneCallbacksFound === 0) {
                status.textContent =
                    'Hook active; identifying the campo.mjs scene loop…';
            } else if (currentMode === 'full') {
                status.textContent =
                    'Scene loop found. Full profile is not throttling it.';
            } else if (throttledPerSecond > 0) {
                status.textContent =
                    `Working: campo scene loop identified; skipping ${throttledPerSecond} animation callbacks/s.`;
            } else {
                status.textContent =
                    `Scene loop found; target is ${labelForMode(currentMode)}.`;
            }
        }

        if (trigger) {
            trigger.classList.remove('working', 'warning');

            if (isNativeEconomy()) {
                trigger.textContent = 'Perf · Native Eco';
                trigger.classList.add('warning');
            } else if (!settings.enabled) {
                trigger.textContent = 'Perf · Off';
            } else if (!hookInstalled) {
                trigger.textContent = 'Perf · hook!';
                trigger.classList.add('warning');
            } else if (sceneCallbacksFound === 0) {
                trigger.textContent = 'Perf · finding…';
                trigger.classList.add('warning');
            } else {
                trigger.textContent =
                    `Perf · ${labelForMode(currentMode)} · ↓${throttledPerSecond}`;

                if (currentMode !== 'full' && throttledPerSecond > 0) {
                    trigger.classList.add('working');
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // Metrics / bootstrap
    // ------------------------------------------------------------------

    setInterval(() => {
        sceneRunsPerSecond = sceneRunsWindow;
        throttledPerSecond = throttledWindow;

        sceneRunsWindow = 0;
        throttledWindow = 0;

        updateUI();
    }, 1000);

    function bootstrap() {
        installStyles();
        installSceneDetector();
        installRafHook();
        ensureTrigger();
        applyMode();

        setInterval(() => {
            installSceneDetector();
            installRafHook();
            ensureTrigger();
            applyMode();
        }, 1000);

        console.info('[PokéIdle Performance+] v3 loaded');
    }

    // Install the page-world hooks immediately, before waiting for DOMContentLoaded.
    installSceneDetector();
    installRafHook();

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
        bootstrap();
    }
})();

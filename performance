// ==UserScript==
// @name         PokéIdle Performance+
// @namespace    moth.pokeidle
// @version      4.2.0
// @description  Targets PokéIdle's campo.mjs loop, reduces expensive UI work, and adapts scene rate to load.
// @match        https://pokeidle.io/*
// @match        https://www.pokeidle.io/*
// @grant        unsafeWindow
// @run-at       document-start
// ==/UserScript==

(() => {
    'use strict';

    const STORAGE_KEY = 'moth-pokeidle-performance-v5';
    const LEGACY_KEY = 'moth-pokeidle-performance-v4';
    const TRIGGER_ID = 'moth-performance-trigger';
    const PANEL_ID = 'moth-performance-panel';
    const STYLE_ID = 'moth-performance-style';

    const page = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
    const q = (selector, root = document) => root.querySelector(selector);

    /*
     * "Performance" is intentionally different from AFK/Capture Saver:
     * it does NOT cap the scene. It removes superfluous UI/effects so the
     * browser can spend as much of its frame budget as possible on campo.
     */
    const PROFILES = {
        full: {
            label: 'Full',
            adaptive: false,
            scene: 'full',
            idleScene: 'full',
            backgroundScene: 'full',
            idleSeconds: 0,
            ui: 'off',
            idleUi: 'off',
            effects: 'full',
            chat: 'normal'
        },
        adaptive: {
            label: 'Adaptive',
            adaptive: true,
            scene: '30',
            idleScene: '2',
            backgroundScene: '2',
            idleSeconds: 45,
            ui: 'lite',
            idleUi: 'aggressive',
            effects: 'reduced',
            chat: 'idle'
        },
        afk: {
            label: 'AFK',
            adaptive: false,
            scene: '15',
            idleScene: '2',
            backgroundScene: '2',
            idleSeconds: 20,
            ui: 'lite',
            idleUi: 'aggressive',
            effects: 'reduced',
            chat: 'idle'
        },
        capture: {
            label: 'Capture Saver',
            adaptive: false,
            scene: '15',
            idleScene: '2',
            backgroundScene: '2',
            idleSeconds: 10,
            ui: 'aggressive',
            idleUi: 'aggressive',
            effects: 'minimal',
            chat: 'always'
        },
        performance: {
            label: 'Performance',
            adaptive: false,
            scene: 'full',
            idleScene: 'full',
            backgroundScene: 'full',
            idleSeconds: 0,
            ui: 'performance',
            idleUi: 'performance',
            effects: 'minimal',
            chat: 'normal'
        }
    };

    const DEFAULTS = {
        enabled: true,
        profile: 'adaptive'
    };

    function loadSettings() {
        let saved = {};

        try {
            saved = JSON.parse(
                localStorage.getItem(STORAGE_KEY) ||
                localStorage.getItem(LEGACY_KEY) ||
                '{}'
            );
        } catch {}

        // v3 called the adaptive-ish profile "balanced".
        if (saved.profile === 'balanced') {
            saved.profile = 'adaptive';
        }

        if (!PROFILES[saved.profile]) {
            saved.profile = DEFAULTS.profile;
        }

        return {
            ...DEFAULTS,
            ...saved
        };
    }

    let settings = loadSettings();
    let lastActivity = Date.now();
    let interactionBoostUntil = 0;
    let currentMode = 'full';
    let currentUi = 'off';
    let chatCollapsedByAddon = false;

    // Exact campo.mjs loop hook state.
    const nativeRAF = page.requestAnimationFrame?.bind(page);
    const nativeCancelRAF = page.cancelAnimationFrame?.bind(page);
    const throttledRequests = new Map();
    const campoState = new WeakMap();
    let nextSyntheticRafId = -1;
    const campoCallbacks = new WeakSet();
    let campoHookInstalled = false;
    let campoLoopFound = false;
    let campoRunsWindow = 0;
    let campoSkippedWindow = 0;
    let campoRunsPerSecond = 0;
    let campoSkippedPerSecond = 0;

    // Load monitor.
    const longTasks = [];
    const jankFrames = [];
    let browserFps = 0;
    let frameCount = 0;
    let frameWindowStart = performance.now();
    let previousMonitorFrame = 0;
    let longTaskMsPerSecond = 0;
    let jankPerSecond = 0;
    let pressure = 'light';
    let heavyStreak = 0;
    let lightStreak = 0;
    let adaptiveDecision = '30';

    function saveSettings() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
    }

    function profile() {
        return PROFILES[settings.profile] || PROFILES.adaptive;
    }

    function isNativeEconomy() {
        return document.documentElement.classList.contains('modo-economia');
    }

    function autoCatchEnabled() {
        const button = q('#moth-ac-toggle');

        if (button) {
            return button.textContent.trim().toUpperCase() === 'ON';
        }

        try {
            return Boolean(
                JSON.parse(
                    localStorage.getItem('moth-pokeidle-autocatch-v4') || '{}'
                ).enabled
            );
        } catch {
            return false;
        }
    }

    // ------------------------------------------------------------------
    // Exact campo.mjs loop throttle
    // ------------------------------------------------------------------

    function scheduleComesFromCampo() {
        try {
            return /(?:https:\/\/pokeidle\.io)?\/campo\.mjs(?:\?|:)/i
                .test(String(new Error().stack || ''));
        } catch {
            return false;
        }
    }

    function isCampoLoopRequest(callback) {
        if (
            typeof callback !==
            'function'
        ) {
            return false;
        }

        if (
            campoCallbacks.has(
                callback
            )
        ) {
            return true;
        }

        /*
         * Firefox's profiler labels the renderer as campo.mjs -> loop,
         * but Function.name is not guaranteed for module-local callbacks.
         * v4 incorrectly required callback.name === "loop", which is why
         * it could remain stuck at "campo…".
         *
         * Discover once from the requestAnimationFrame call site itself.
         * After the first campo callback is found, unrelated rAF calls no
         * longer pay the cost of creating Error stacks.
         */
        if (
            campoLoopFound ||
            !scheduleComesFromCampo()
        ) {
            return false;
        }

        campoCallbacks.add(
            callback
        );

        campoLoopFound = true;

        console.info(
            '[PokéIdle Performance+] hooked campo.mjs renderer from its rAF call site'
        );

        return true;
    }

    function intervalForMode(mode) {
        if (mode === '30') return 1000 / 30;
        if (mode === '15') return 1000 / 15;
        if (mode === '2') return 500;
        return 0;
    }

    function installCampoHook() {
        if (
            campoHookInstalled ||
            !nativeRAF ||
            !nativeCancelRAF
        ) {
            return campoHookInstalled;
        }

        function mothRequestAnimationFrame(callback) {
            if (!isCampoLoopRequest(callback)) {
                return nativeRAF(callback);
            }

            const publicId = nextSyntheticRafId--;
            const pending = {
                actualId: null,
                cancelled: false
            };

            const gate = timestamp => {
                if (pending.cancelled) {
                    throttledRequests.delete(publicId);
                    return;
                }

                const interval =
                    settings.enabled
                        ? intervalForMode(currentMode)
                        : 0;

                let state = campoState.get(callback);

                if (!state) {
                    state = {
                        lastRun: -Infinity
                    };

                    campoState.set(
                        callback,
                        state
                    );
                }

                if (
                    interval > 0 &&
                    timestamp - state.lastRun <
                        interval
                ) {
                    campoSkippedWindow++;

                    pending.actualId =
                        nativeRAF(gate);

                    return;
                }

                state.lastRun = timestamp;
                campoRunsWindow++;

                throttledRequests.delete(
                    publicId
                );

                callback.call(page, timestamp);
            };

            pending.actualId =
                nativeRAF(gate);

            throttledRequests.set(
                publicId,
                pending
            );

            return publicId;
        }

        function mothCancelAnimationFrame(id) {
            const pending =
                throttledRequests.get(id);

            if (!pending) {
                return nativeCancelRAF(id);
            }

            pending.cancelled = true;

            if (pending.actualId != null) {
                nativeCancelRAF(
                    pending.actualId
                );
            }

            throttledRequests.delete(id);
        }

        try {
            page.requestAnimationFrame =
                mothRequestAnimationFrame;

            page.cancelAnimationFrame =
                mothCancelAnimationFrame;

            campoHookInstalled =
                page.requestAnimationFrame ===
                mothRequestAnimationFrame;
        } catch (error) {
            console.warn(
                '[PokéIdle Performance+] campo hook failed',
                error
            );

            campoHookInstalled = false;
        }

        return campoHookInstalled;
    }

    // Install immediately, before campo.mjs starts its loop.
    installCampoHook();

    // ------------------------------------------------------------------
    // Runtime pressure measurement
    // ------------------------------------------------------------------

    try {
        const observer =
            new PerformanceObserver(list => {
                const now =
                    performance.now();

                for (
                    const entry of
                    list.getEntries()
                ) {
                    longTasks.push({
                        time: now,
                        duration:
                            entry.duration
                    });
                }
            });

        observer.observe({
            type: 'longtask',
            buffered: false
        });
    } catch {}

    function monitorFrame(now) {
        frameCount++;

        if (previousMonitorFrame) {
            const gap =
                now -
                previousMonitorFrame;

            if (gap > 34) {
                jankFrames.push({
                    time: now,
                    gap
                });
            }
        }

        previousMonitorFrame = now;

        const elapsed =
            now -
            frameWindowStart;

        if (elapsed >= 1000) {
            browserFps =
                frameCount *
                1000 /
                elapsed;

            frameCount = 0;
            frameWindowStart = now;
        }

        nativeRAF?.(monitorFrame);
    }

    nativeRAF?.(monitorFrame);

    function prunePerformanceSamples() {
        const now =
            performance.now();

        const cutoff =
            now - 5000;

        while (
            longTasks.length &&
            longTasks[0].time < cutoff
        ) {
            longTasks.shift();
        }

        while (
            jankFrames.length &&
            jankFrames[0].time < cutoff
        ) {
            jankFrames.shift();
        }

        const longMs =
            longTasks.reduce(
                (sum, item) =>
                    sum +
                    item.duration,
                0
            );

        longTaskMsPerSecond =
            longMs / 5;

        jankPerSecond =
            jankFrames.length / 5;

        if (
            document.hidden
        ) {
            pressure = 'background';
        } else if (
            longTaskMsPerSecond >= 90 ||
            jankPerSecond >= 5 ||
            (
                browserFps > 0 &&
                browserFps < 42
            )
        ) {
            pressure = 'heavy';
        } else if (
            longTaskMsPerSecond >= 35 ||
            jankPerSecond >= 2.5 ||
            (
                browserFps > 0 &&
                browserFps < 53
            )
        ) {
            pressure = 'medium';
        } else {
            pressure = 'light';
        }
    }

    function updateAdaptiveDecision() {
        const p = profile();

        if (!p.adaptive) {
            return;
        }

        const idleSeconds =
            (
                Date.now() -
                lastActivity
            ) / 1000;

        if (
            document.hidden ||
            (
                p.idleSeconds > 0 &&
                idleSeconds >=
                    p.idleSeconds
            )
        ) {
            adaptiveDecision = '2';
            heavyStreak = 0;
            lightStreak = 0;
            return;
        }

        if (
            Date.now() <
            interactionBoostUntil
        ) {
            adaptiveDecision = '30';
            return;
        }

        if (pressure === 'heavy') {
            heavyStreak++;
            lightStreak = 0;
        } else if (
            pressure === 'light'
        ) {
            lightStreak++;
            heavyStreak = 0;
        } else {
            heavyStreak = 0;
            lightStreak = 0;
        }

        /*
         * Hysteresis prevents 30/15 bouncing when load sits near a
         * threshold.
         */
        if (
            adaptiveDecision === '30' &&
            heavyStreak >= 2
        ) {
            adaptiveDecision = '15';
            heavyStreak = 0;
        } else if (
            adaptiveDecision === '15' &&
            lightStreak >= 4
        ) {
            adaptiveDecision = '30';
            lightStreak = 0;
        }
    }

    // ------------------------------------------------------------------
    // UI performance levels
    // ------------------------------------------------------------------

    function collapseChat() {
        const button =
            q('#btn-chat-toggle');

        if (!button) {
            return;
        }

        if (
            button.getAttribute(
                'aria-expanded'
            ) !== 'false'
        ) {
            button.click();
            chatCollapsedByAddon = true;
        }
    }

    function restoreChat() {
        if (!chatCollapsedByAddon) {
            return;
        }

        const button =
            q('#btn-chat-toggle');

        if (
            button?.getAttribute(
                'aria-expanded'
            ) === 'false'
        ) {
            button.click();
        }

        chatCollapsedByAddon = false;
    }

    function isIdleForProfile(p) {
        if (document.hidden) {
            return true;
        }

        if (p.idleSeconds <= 0) {
            return false;
        }

        return (
            Date.now() -
            lastActivity
        ) >=
            p.idleSeconds * 1000;
    }

    function calculateMode() {
        if (!settings.enabled) {
            return 'full';
        }

        const p = profile();

        if (p.adaptive) {
            return adaptiveDecision;
        }

        if (document.hidden) {
            return p.backgroundScene;
        }

        if (isIdleForProfile(p)) {
            return p.idleScene;
        }

        return p.scene;
    }

    function calculateUiLevel() {
        if (!settings.enabled) {
            return 'off';
        }

        const p = profile();

        if (
            p.adaptive &&
            !document.hidden &&
            !isIdleForProfile(p)
        ) {
            /*
             * Under heavy pressure we remove the log/chat render work too;
             * when load recovers we return to the lighter move-HUD-only
             * reduction.
             */
            return pressure === 'heavy'
                ? 'aggressive'
                : p.ui;
        }

        return isIdleForProfile(p)
            ? p.idleUi
            : p.ui;
    }

    function syncChatPolicy() {
        if (!settings.enabled) {
            restoreChat();
            return;
        }

        const p = profile();
        const idle =
            isIdleForProfile(p);

        /*
         * Never collapse chat just because UI load is high. That changes
         * user-visible state and made the panel appear broken. Only AFK-like
         * profiles explicitly configured for idle collapse may do it.
         */
        const shouldCollapse =
            p.chat === 'idle' &&
            idle;

        if (shouldCollapse) {
            collapseChat();
        } else {
            restoreChat();
        }
    }

    function applyMode() {
        currentMode =
            calculateMode();

        currentUi =
            calculateUiLevel();

        const p = profile();
        const html =
            document.documentElement;

        html.classList.toggle(
            'moth-perf-reduced',
            settings.enabled &&
                p.effects === 'reduced'
        );

        html.classList.toggle(
            'moth-perf-minimal',
            settings.enabled &&
                p.effects === 'minimal'
        );

        for (
            const level of [
                'lite',
                'aggressive',
                'performance'
            ]
        ) {
            html.classList.toggle(
                'moth-ui-' + level,
                settings.enabled &&
                    currentUi === level
            );
        }

        html.classList.toggle(
            'moth-scene-sleep',
            settings.enabled &&
                currentMode === '2'
        );

        syncChatPolicy();
        updateUI();
    }

    function recordActivity() {
        lastActivity = Date.now();

        /*
         * Adaptive mode immediately returns to its responsive ceiling
         * after interaction, then reevaluates load a few seconds later.
         */
        interactionBoostUntil =
            Date.now() + 2500;

        if (
            profile().adaptive
        ) {
            adaptiveDecision = '30';
        }

        applyMode();
    }

    for (
        const eventName of [
            'pointerdown',
            'keydown',
            'wheel',
            'touchstart'
        ]
    ) {
        window.addEventListener(
            eventName,
            recordActivity,
            {
                passive: true,
                capture: true
            }
        );
    }

    document.addEventListener(
        'visibilitychange',
        applyMode
    );

    // ------------------------------------------------------------------
    // CSS reductions
    // ------------------------------------------------------------------

    function installStyles() {
        if (q('#' + STYLE_ID)) {
            return;
        }

        const style =
            document.createElement(
                'style'
            );

        style.id = STYLE_ID;

        style.textContent = `
            /*
             * Trace-backed target:
             * reposicionarGolpesPainel produced repeated style/layout work.
             * In an idle game the move HUD is informational, not an input.
             */
            html.moth-ui-lite #golpes-painel,
            html.moth-ui-aggressive #golpes-painel,
            html.moth-ui-performance #golpes-painel {
                display: none !important;
            }

            /*
             * Aggressive UI Lite stops painting frequently-changing
             * informational feeds. Capture controls/history are NOT here.
             */
            html.moth-ui-aggressive #hud-log,
            html.moth-ui-performance #hud-log,
            html.moth-ui-aggressive .evento-faixa,
            html.moth-ui-performance .evento-faixa,
            html.moth-ui-aggressive #musica-player,
            html.moth-ui-performance #musica-player {
                display: none !important;
            }

            /*
             * UI Max must never remove interactive/core game UI.
             * Chat, team, active Pokémon and automation controls stay fully
             * usable. Only redundant live indicators are removed.
             */
            html.moth-ui-performance #ir-centro-conta {
                display: none !important;
            }

            /*
             * Let Chrome skip off-screen panel rendering where possible.
             * These are presentation optimizations only; no game state is
             * disconnected.
             */
            html:is(
                .moth-ui-lite,
                .moth-ui-aggressive,
                .moth-ui-performance
            ) :is(
                #p-ativo,
                #p-equipe,
                #p-treinador,
                #p-chat
            ) {
                content-visibility: auto;
                contain-intrinsic-size: auto 260px;
            }

            html.moth-perf-reduced :is(
                .ab-confete *,
                .recompensa *,
                .shiny-anuncio *,
                .lendario-anuncio *,
                .evento-faixa *,
                .pvp-fila-pill *
            ) {
                animation-duration: .001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .001ms !important;
            }

            html.moth-perf-minimal #app *,
            html.moth-perf-minimal #app *::before,
            html.moth-perf-minimal #app *::after {
                animation-duration: .001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .001ms !important;
                backdrop-filter: none !important;
                filter: none !important;
                text-shadow: none !important;
                box-shadow: none !important;
            }

            html.moth-perf-minimal :is(
                .la-relampago,
                .la-raios,
                .la-faiscas,
                .rc-flash,
                .rc-particulas,
                .ab-confete
            ) {
                display: none !important;
            }

            html.moth-scene-sleep #cena {
                opacity: .55 !important;
            }

            #${TRIGGER_ID} {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                min-width: 0 !important;
                width: auto !important;
                height: 25px !important;
                padding: 3px 7px !important;
                margin-left: auto !important;
                border: 1px solid rgba(255,255,255,.16) !important;
                border-radius: 999px !important;
                background: rgba(40,31,35,.75) !important;
                color: #ddd !important;
                font: 700 9px/1 system-ui,sans-serif !important;
                cursor: pointer !important;
                opacity: 1 !important;
                visibility: visible !important;
                position: relative !important;
                z-index: 20 !important;
            }

            #${TRIGGER_ID}.working {
                color: #8fe0a5 !important;
                border-color: rgba(100,210,130,.35) !important;
            }

            #${TRIGGER_ID}.warning {
                color: #ffd27c !important;
                border-color: rgba(255,190,80,.38) !important;
            }

            #${PANEL_ID} {
                margin: 7px 0 9px !important;
                padding: 8px !important;
                border: 1px solid rgba(255,255,255,.12) !important;
                border-radius: 7px !important;
                background: rgba(20,16,19,.65) !important;
                color: #eee !important;
                font: 10px/1.25 system-ui,sans-serif !important;
            }

            #${PANEL_ID}[hidden] {
                display: none !important;
            }

            #${PANEL_ID} * {
                box-sizing: border-box !important;
            }

            #${PANEL_ID} .mpp-head,
            #${PANEL_ID} .mpp-row {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            #${PANEL_ID} .mpp-head {
                margin-bottom: 7px;
            }

            #${PANEL_ID} .mpp-head strong,
            #${PANEL_ID} .mpp-row label {
                flex: 1;
            }

            #${PANEL_ID} .mpp-metrics {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 4px;
                margin-bottom: 7px;
            }

            #${PANEL_ID} .mpp-metric {
                padding: 4px;
                border-radius: 5px;
                background: rgba(255,255,255,.05);
                text-align: center;
            }

            #${PANEL_ID} .mpp-metric b {
                display: block;
                font-size: 11px;
            }

            #${PANEL_ID} .mpp-metric span {
                color: #998f93;
                font-size: 8px;
            }

            #${PANEL_ID} .mpp-row {
                min-height: 27px;
            }

            #${PANEL_ID} select {
                width: 120px;
                padding: 3px 4px;
                border: 1px solid rgba(255,255,255,.12);
                border-radius: 4px;
                background: #211a1e;
                color: #fff;
                font: inherit;
            }

            #${PANEL_ID} .mpp-status {
                margin-top: 6px;
                padding-top: 6px;
                border-top: 1px solid rgba(255,255,255,.07);
                color: #a89da2;
                font-size: 9px;
            }
        `;

        (
            document.head ||
            document.documentElement
        ).appendChild(style);
    }

    function labelForMode(mode) {
        return {
            full: 'Full',
            '30': '30fps',
            '15': '15fps',
            '2': '2fps'
        }[mode] || mode;
    }

    function labelForUi(level) {
        return {
            off: 'UI Full',
            lite: 'UI Lite',
            aggressive: 'UI Low',
            performance: 'UI Max'
        }[level] || level;
    }

    function setText(el, value) {
        if (!el) {
            return;
        }

        const next =
            String(value);

        if (
            el.textContent !==
            next
        ) {
            el.textContent =
                next;
        }
    }

    function setChecked(el, value) {
        if (
            el &&
            el.checked !==
                Boolean(value)
        ) {
            el.checked =
                Boolean(value);
        }
    }

    function setValue(el, value) {
        if (
            el &&
            el.value !==
                String(value)
        ) {
            el.value =
                String(value);
        }
    }

    function setClass(el, className, enabled) {
        if (
            el &&
            el.classList.contains(
                className
            ) !== Boolean(enabled)
        ) {
            el.classList.toggle(
                className,
                Boolean(enabled)
            );
        }
    }

    // ------------------------------------------------------------------
    // Light control UI
    // ------------------------------------------------------------------

    function ensurePanel() {
        let panel =
            q('#' + PANEL_ID);

        if (panel) {
            return panel;
        }

        const host =
            q('#auto-corpo');

        if (!host) {
            return null;
        }

        panel =
            document.createElement(
                'section'
            );

        panel.id = PANEL_ID;
        panel.hidden = true;

        panel.innerHTML = `
            <div class="mpp-head">
                <strong>Performance+</strong>
                <label>
                    <input id="mpp-enabled" type="checkbox">
                    On
                </label>
            </div>

            <div class="mpp-metrics">
                <div class="mpp-metric">
                    <b id="mpp-browser-fps">—</b>
                    <span>browser FPS</span>
                </div>

                <div class="mpp-metric">
                    <b id="mpp-scene-runs">0</b>
                    <span>campo runs/s</span>
                </div>

                <div class="mpp-metric">
                    <b id="mpp-long">0</b>
                    <span>long ms/s</span>
                </div>
            </div>

            <div class="mpp-row">
                <label>Profile</label>

                <select id="mpp-profile">
                    <option value="full">Full</option>
                    <option value="adaptive">Adaptive</option>
                    <option value="afk">AFK</option>
                    <option value="capture">Capture Saver</option>
                    <option value="performance">Performance</option>
                </select>
            </div>

            <div class="mpp-status" id="mpp-status">
                Loading campo.mjs hook…
            </div>
        `;

        host.prepend(panel);

        q(
            '#mpp-enabled',
            panel
        ).addEventListener(
            'change',
            event => {
                settings.enabled =
                    event.target.checked;

                saveSettings();
                applyMode();
            }
        );

        q(
            '#mpp-profile',
            panel
        ).addEventListener(
            'change',
            event => {
                settings.profile =
                    event.target.value;

                lastActivity =
                    Date.now();

                interactionBoostUntil =
                    Date.now() + 2500;

                adaptiveDecision = '30';

                saveSettings();
                applyMode();
            }
        );

        return panel;
    }

    function ensureTrigger() {
        if (!document.body) {
            return false;
        }

        installStyles();
        installCampoHook();
        ensurePanel();

        let trigger =
            q('#' + TRIGGER_ID);

        if (trigger) {
            return true;
        }

        const header =
            q('#p-auto .painel-cab-auto') ||
            q('#p-auto .painel-cab');

        if (!header) {
            return false;
        }

        trigger =
            document.createElement(
                'button'
            );

        trigger.type = 'button';
        trigger.id = TRIGGER_ID;
        trigger.textContent =
            'Perf · load';

        trigger.title =
            'Performance+ loaded';

        trigger.addEventListener(
            'click',
            event => {
                event.preventDefault();
                event.stopPropagation();

                const autoToggle =
                    q('#btn-auto-toggle');

                if (
                    autoToggle?.getAttribute(
                        'aria-expanded'
                    ) === 'false'
                ) {
                    autoToggle.click();
                }

                const panel =
                    ensurePanel();

                if (panel) {
                    panel.hidden =
                        !panel.hidden;
                }
            }
        );

        const collapse =
            q(
                '#btn-auto-toggle',
                header
            );

        if (collapse) {
            header.insertBefore(
                trigger,
                collapse
            );
        } else {
            header.appendChild(
                trigger
            );
        }

        return true;
    }

    function updateUI() {
        const trigger =
            q('#' + TRIGGER_ID);

        const panel =
            q('#' + PANEL_ID);

        if (panel) {
            setChecked(
                q(
                    '#mpp-enabled',
                    panel
                ),
                settings.enabled
            );

            setValue(
                q(
                    '#mpp-profile',
                    panel
                ),
                settings.profile
            );

            setText(
                q(
                    '#mpp-browser-fps',
                    panel
                ),
                document.hidden
                    ? 'BG'
                    : Math.round(
                        browserFps
                    )
            );

            setText(
                q(
                    '#mpp-scene-runs',
                    panel
                ),
                isNativeEconomy()
                    ? 'Eco'
                    : campoRunsPerSecond
            );

            setText(
                q(
                    '#mpp-long',
                    panel
                ),
                Math.round(
                    longTaskMsPerSecond
                )
            );

            const status =
                q(
                    '#mpp-status',
                    panel
                );

            let statusText;

            if (isNativeEconomy()) {
                statusText =
                    'Native Economy is active; Auto Catch cannot receive fallen targets.';
            } else if (!campoHookInstalled) {
                statusText =
                    'Could not install the page-world campo hook.';
            } else if (!campoLoopFound) {
                statusText =
                    'Hook ready; waiting for campo.mjs renderer.';
            } else if (!settings.enabled) {
                statusText =
                    'campo.mjs renderer found; Performance+ disabled.';
            } else if (
                settings.profile ===
                'performance'
            ) {
                statusText =
                    'Performance: native scene rate, nonessential effects reduced; core UI preserved.';
            } else if (
                profile().adaptive
            ) {
                statusText =
                    'Adaptive · ' +
                    pressure +
                    ' load · ' +
                    Math.round(
                        jankPerSecond * 10
                    ) / 10 +
                    ' jank/s · skipped ' +
                    campoSkippedPerSecond +
                    '/s.';
            } else {
                statusText =
                    'campo.mjs renderer targeted · skipped ' +
                    campoSkippedPerSecond +
                    '/s.';
            }

            setText(
                status,
                statusText
            );
        }

        if (!trigger) {
            return;
        }

        let triggerText;
        let working = false;
        let warning = false;

        if (isNativeEconomy()) {
            triggerText =
                'Perf · Native Eco';

            warning = true;
        } else if (!settings.enabled) {
            triggerText =
                'Perf · Off';
        } else if (!campoHookInstalled) {
            triggerText =
                'Perf · hook!';

            warning = true;
        } else if (!campoLoopFound) {
            triggerText =
                'Perf · campo…';

            warning = true;
        } else {
            triggerText =
                'Perf · ' +
                labelForMode(
                    currentMode
                ) +
                ' · ' +
                labelForUi(
                    currentUi
                );

            working = true;
        }

        setText(
            trigger,
            triggerText
        );

        setClass(
            trigger,
            'working',
            working
        );

        setClass(
            trigger,
            'warning',
            warning
        );
    }

    // ------------------------------------------------------------------
    // Tick / bootstrap
    // ------------------------------------------------------------------

    setInterval(() => {
        campoRunsPerSecond =
            campoRunsWindow;

        campoSkippedPerSecond =
            campoSkippedWindow;

        campoRunsWindow = 0;
        campoSkippedWindow = 0;

        prunePerformanceSamples();
        updateAdaptiveDecision();
        applyMode();
    }, 1000);

    function bootstrap() {
        installStyles();
        installCampoHook();
        ensureTrigger();

        lastActivity =
            Date.now();

        applyMode();

        setInterval(() => {
            installCampoHook();
            ensureTrigger();
        }, 1500);

        console.info(
            '[PokéIdle Performance+] v4.2 loaded'
        );
    }

    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            bootstrap,
            {
                once: true
            }
        );
    } else {
        bootstrap();
    }
})();

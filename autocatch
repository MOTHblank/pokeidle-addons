        (document.head || document.documentElement).appendChild(style);
    }

    function ballControl(key, label) {
        return `
            <label class="moth-ac-ball" title="Enable this ball type and keep this reserve.">
                <input type="checkbox" data-moth-use="${key}">
                <span>${label}</span>
                <input type="number" min="0" step="1" data-moth-reserve="${key}" title="Reserve">
            </label>
        `;
    }

    function panelMarkup() {
        return `
            <div class="moth-ac-head">
                <span class="moth-ac-title">Auto Catch+</span>
                <span class="moth-ac-status" id="moth-ac-status">Idle</span>
                <button type="button" class="moth-ac-toggle" id="moth-ac-toggle">OFF</button>
            </div>

            <div class="moth-ac-current" id="moth-ac-current">No target</div>

            <div class="moth-ac-stats">
                <div class="moth-ac-stat"><b id="moth-ac-captures">0</b><span>captures</span></div>
                <div class="moth-ac-stat"><b id="moth-ac-balls-used">0</b><span>balls used</span></div>
                <div class="moth-ac-stat"><b id="moth-ac-rate">0%</b><span>success</span></div>
            </div>

            <div class="moth-ac-grid">
                <label for="moth-ac-interval">Throw interval</label>
                <input id="moth-ac-interval" type="number" min="100" max="5000" step="25">
            </div>

            <div class="moth-ac-balls">
                ${ballControl('poke', 'Poké')}
                ${ballControl('great', 'Great')}
                ${ballControl('super', 'Super')}
                ${ballControl('ultra', 'Ultra')}
                ${ballControl('master', 'Master')}
            </div>

            <div class="moth-ac-foot">
                <label><input id="moth-ac-hud-check" type="checkbox"> HUD</label>
                <span id="moth-ac-protocol">Protocol: loading</span>
                <button type="button" class="moth-ac-reset" id="moth-ac-reset">Reset stats</button>
            </div>
        `;
    }

    function installPanel() {
        injectStyle();

        if (q('#moth-ac-panel')) return true;

        const host = q('#auto-corpo');
        if (!host) return false;

        const panel = document.createElement('section');
        panel.id = 'moth-ac-panel';
        panel.innerHTML = panelMarkup();
        host.prepend(panel);

        q('#moth-ac-toggle', panel).addEventListener('click', () => {
            setEnabled(!settings.enabled);
        });

        const interval = q('#moth-ac-interval', panel);
        interval.value = settings.intervalMs;

        interval.addEventListener('change', () => {
            settings.intervalMs = Math.max(
                MIN_INTERVAL_MS,
                Math.min(5000, Number(interval.value) || 650)
            );

            interval.value = settings.intervalMs;
            saveSettings();

            if (settings.enabled) schedule();
        });

        for (const checkbox of qa('[data-moth-use]', panel)) {
            const key = checkbox.dataset.mothUse;
            checkbox.checked = Boolean(settings.use[key]);

            checkbox.addEventListener('change', () => {
                settings.use[key] = checkbox.checked;
                saveSettings();
                updateUI();
            });
        }

        for (const input of qa('[data-moth-reserve]', panel)) {
            const key = input.dataset.mothReserve;
            input.value = Number(settings.reserve[key] || 0);

            input.addEventListener('change', () => {
                settings.reserve[key] = Math.max(0, Number(input.value) || 0);
                input.value = settings.reserve[key];
                saveSettings();
            });
        }

        const hudCheck = q('#moth-ac-hud-check', panel);
        hudCheck.checked = settings.showHud;

        hudCheck.addEventListener('change', () => {
            settings.showHud = hudCheck.checked;
            saveSettings();
            updateUI();
        });

        q('#moth-ac-reset', panel).addEventListener('click', resetStats);

        updateUI();
        return true;
    }

    function installHud() {
        injectStyle();

        if (q('#moth-capture-hud')) return true;

        const palco = q('#palco');
        if (!palco) return false;

        if (getComputedStyle(palco).position === 'static') {
            palco.style.position = 'relative';
        }

        const hud = document.createElement('div');
        hud.id = 'moth-capture-hud';
        hud.innerHTML = `
            <div class="moth-hud-head">
                <span>Capture HUD</span>
                <span class="moth-hud-state" id="moth-hud-status">Idle</span>
            </div>

            <div class="moth-hud-row">
                <div class="moth-hud-cell"><b id="moth-hud-captures">0</b><span>captures</span></div>
                <div class="moth-hud-cell"><b id="moth-hud-used">0</b><span>balls</span></div>
                <div class="moth-hud-cell"><b id="moth-hud-rate">0%</b><span>rate</span></div>
            </div>

            <div class="moth-hud-target" id="moth-hud-target">No target</div>
            <div class="moth-hud-balls" id="moth-hud-balls"></div>
            <div class="moth-hud-protocol" id="moth-hud-protocol"></div>
        `;

        palco.appendChild(hud);
        updateUI();

        return true;
    }

    function formatDuration(ms) {
        const total = Math.max(0, Math.floor(ms / 1000));
        const hours = Math.floor(total / 3600);
        const minutes = Math.floor((total % 3600) / 60);
        const seconds = total % 60;

        if (hours) {
            return [
                hours,
                String(minutes).padStart(2, '0'),
                String(seconds).padStart(2, '0')
            ].join(':');
        }

        return `${minutes}:${String(seconds).padStart(2, '0')}`;
    }

    function setText(selector, value) {
        const el = q(selector);

        if (!el) {
            return;
        }

        const next = String(value);

        if (el.textContent !== next) {
            el.textContent = next;
        }
    }

    function setClass(el, className, enabled) {
        if (
            el &&
            el.classList.contains(className) !== enabled
        ) {
            el.classList.toggle(
                className,
                enabled
            );
        }
    }

    function protocolLabel() {
        if (!protocolHookInstalled) return 'Protocol: hook failed';
        if (!protocolSockets) return 'Protocol: waiting for socket';
        if (!protocolCaptureSignals) return `Protocol: live · ${protocolMessages} msgs`;
        return `Protocol: ${protocolLastType}`;
    }

    function updateUI() {
        const used = totalUsed();
        const denominator = used || stats.attempts;
        const rate = denominator ? (stats.captures / denominator) * 100 : 0;
        const state = currentTargetState();
        const targetText = formatTargetState(state);
        const protocolText = protocolLabel();

        const toggle = q('#moth-ac-toggle');

        if (toggle) {
            const toggleText =
                settings.enabled
                    ? 'ON'
                    : 'OFF';

            if (
                toggle.textContent !==
                toggleText
            ) {
                toggle.textContent =
                    toggleText;
            }

            setClass(
                toggle,
                'on',
                settings.enabled
            );
        }

        setText('#moth-ac-status', stats.status);
        setText('#moth-ac-current', targetText);
        setText('#moth-ac-captures', stats.captures);
        setText('#moth-ac-balls-used', used);
        setText('#moth-ac-rate', `${rate.toFixed(rate >= 10 ? 0 : 1)}%`);
        setText('#moth-ac-protocol', protocolText);

        const hud = q('#moth-capture-hud');

        if (hud) {
            const display =
                settings.showHud
                    ? 'block'
                    : 'none';

            if (
                hud.style.display !==
                display
            ) {
                hud.style.display =
                    display;
            }
        }

        setText('#moth-hud-status', settings.enabled ? stats.status : 'Paused');
        setText('#moth-hud-captures', stats.captures);
        setText('#moth-hud-used', used);
        setText('#moth-hud-rate', `${rate.toFixed(rate >= 10 ? 0 : 1)}%`);
        setText('#moth-hud-target', targetText);
        setText(
            '#moth-hud-balls',
            [
                `P ${stats.used.poke}`,
                `G ${stats.used.great}`,
                `S ${stats.used.super}`,
                `U ${stats.used.ultra}`,
                stats.used.master ? `M ${stats.used.master}` : null,
                `· ${formatDuration(Date.now() - stats.startedAt)}`
            ].filter(Boolean).join('  ')
        );
        setText('#moth-hud-protocol', protocolText);
    }

    // ---------------------------------------------------------------------
    // Bootstrap
    // ---------------------------------------------------------------------

    function bootstrap() {
        installProtocolHook();
        installPanel();
        installHud();

        scanTargets();
        syncInventoryUsage();
        updateUI();

        setInterval(() => {
            installPanel();
            installHud();
            scanTargets();
            syncInventoryUsage();
            updateUI();
        }, 1000);

        if (settings.enabled) tick();

        console.info('[PokéIdle Auto Catch+] v6.0 loaded');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
        bootstrap();
    }
})();

                    ${restockControl('poke', 'Poké')}
                    ${restockControl('great', 'Great')}
                    ${restockControl('super', 'Super')}
                    ${restockControl('ultra', 'Ultra')}
                    ${restockControl('smallPotion', 'Small Potion')}
                    ${restockControl('greatPotion', 'Great Potion')}
                    ${restockControl('revive', 'Revive')}
                </div>

                <div class="moth-ac-grid moth-ac-restock-gold">

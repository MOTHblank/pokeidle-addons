                settings.restock
                    .goldReserve ||
                0
            );

        restockGold.addEventListener(
            'change',
            () => {
                settings.restock
                    .goldReserve =
                        Math.max(
                            0,
                            Number(
                                restockGold.value
                            ) ||
                            0
                        );

                restockGold.value =
                    settings.restock
                        .goldReserve;

                saveSettings();
                maybeRestock();
            }
        );

        const hudCheck = q('#moth-ac-hud-check', panel);
        hudCheck.checked = settings.showHud;

        hudCheck.addEventListener('change', () => {
            settings.showHud = hudCheck.checked;
            saveSettings();
            updateUI();
        });

        q('#moth-ac-reset', panel).addEventListener('click', resetStats);

        updateUI();
        return true;
    }

    function installHud() {
        injectStyle();

        if (q('#moth-capture-hud')) return true;

        const palco = q('#palco');
        if (!palco) return false;

        if (getComputedStyle(palco).position === 'static') {
            palco.style.position = 'relative';
        }

        const hud = document.createElement('div');
        hud.id = 'moth-capture-hud';
        hud.innerHTML = `
            <div class="moth-hud-head">
                <span>Capture HUD</span>
                <span class="moth-hud-state" id="moth-hud-status">Idle</span>
            </div>

            <div class="moth-hud-row">
                <div class="moth-hud-cell"><b id="moth-hud-captures">0</b><span>captures</span></div>
                <div class="moth-hud-cell"><b id="moth-hud-used">0</b><span>balls</span></div>
                <div class="moth-hud-cell"><b id="moth-hud-rate">0%</b><span>rate</span></div>
            </div>

            <div class="moth-hud-target" id="moth-hud-target">No target</div>
            <div class="moth-hud-balls" id="moth-hud-balls"></div>
            <div class="moth-hud-protocol" id="moth-hud-protocol"></div>
        `;

        palco.appendChild(hud);
        updateUI();

        return true;
    }

    function formatDuration(ms) {
        const total = Math.max(0, Math.floor(ms / 1000));
        const hours = Math.floor(total / 3600);
        const minutes = Math.floor((total % 3600) / 60);
        const seconds = total % 60;

        if (hours) {
            return [
                hours,
                String(minutes).padStart(2, '0'),
                String(seconds).padStart(2, '0')
            ].join(':');
        }

        return `${minutes}:${String(seconds).padStart(2, '0')}`;
    }

    function setText(selector, value) {
        const el = q(selector);

        if (!el) {
            return;
        }

        const next = String(value);

        if (el.textContent !== next) {
            el.textContent = next;
        }
    }

    function setClass(el, className, enabled) {
        if (
            el &&
            el.classList.contains(className) !== enabled
        ) {
            el.classList.toggle(
                className,
                enabled
            );
        }
    }

    function protocolLabel() {
        if (!protocolHookInstalled) return 'Protocol: hook failed';
        if (!protocolSockets) return 'Protocol: waiting for socket';
        if (!protocolCaptureSignals) return `Protocol: live · ${protocolMessages} msgs`;
        return `Protocol: ${protocolLastType}`;
    }

    function updateUI() {
        const used = totalUsed();
        const denominator = used || stats.attempts;
        const rate = denominator ? (stats.captures / denominator) * 100 : 0;
        const state = currentTargetState();
        const targetText = formatTargetState(state);
        const protocolText = protocolLabel();

        const toggle = q('#moth-ac-toggle');

        if (toggle) {
            const toggleText =
                settings.enabled
                    ? 'ON'
                    : 'OFF';

            if (
                toggle.textContent !==
                toggleText
            ) {
                toggle.textContent =
                    toggleText;
            }

            setClass(
                toggle,
                'on',
                settings.enabled
            );
        }

        setText('#moth-ac-status', stats.status);
        setText('#moth-ac-current', targetText);
        setText('#moth-ac-captures', stats.captures);
        setText('#moth-ac-balls-used', used);
        setText('#moth-ac-rate', `${rate.toFixed(rate >= 10 ? 0 : 1)}%`);
        setText('#moth-ac-protocol', protocolText);

        setText(
            '#moth-ac-restock-status',
            settings.restock?.enabled
                ? restockLastAction +
                  (
                      stats.restockBought
                          ? ' · +' +
                            stats.restockBought +
                            ' bought'
                          : ''
                  )
                : 'off'
        );

        const hud = q('#moth-capture-hud');

        if (hud) {
            const display =
                settings.showHud
                    ? 'block'
                    : 'none';

            if (
                hud.style.display !==
                display
            ) {
                hud.style.display =
                    display;
            }
        }

        setText('#moth-hud-status', settings.enabled ? stats.status : 'Paused');
        setText('#moth-hud-captures', stats.captures);
        setText('#moth-hud-used', used);
        setText('#moth-hud-rate', `${rate.toFixed(rate >= 10 ? 0 : 1)}%`);
        setText('#moth-hud-target', targetText);
        setText(
            '#moth-hud-balls',
            [
                `P ${stats.used.poke}`,
                `G ${stats.used.great}`,
                `S ${stats.used.super}`,
                `U ${stats.used.ultra}`,
                stats.used.master ? `M ${stats.used.master}` : null,
                `· ${formatDuration(Date.now() - stats.startedAt)}`
            ].filter(Boolean).join('  ')
        );
        setText('#moth-hud-protocol', protocolText);
    }

    // ---------------------------------------------------------------------
    // Bootstrap
    // ---------------------------------------------------------------------

    function bootstrap() {
        installProtocolHook();
        ensureRestockItemCatalog();
        installPanel();
        installHud();

        scanTargets();
        syncInventoryUsage();
        updateUI();

        setInterval(() => {
            installPanel();
            installHud();
            scanTargets();
            syncInventoryUsage();
            updateUI();
        }, 1000);

        if (settings.enabled) tick();

        console.info('[PokéIdle Auto Catch+] v6.1.6 loaded');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
        bootstrap();
    }
})();

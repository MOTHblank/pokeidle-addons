    function installHud() {
        injectStyle();

        if (
            document.getElementById(
                'moth-capture-hud'
            )
        ) {
            return true;
        }

        const palco =
            document.querySelector(
                '#palco'
            );

        if (!palco) {
            return false;
        }

        if (
            getComputedStyle(palco)
                .position === 'static'
        ) {
            palco.style.position =
                'relative';
        }

        const hud =
            document.createElement('div');

        hud.id =
            'moth-capture-hud';

        hud.innerHTML = `
            <div class="moth-hud-head">
                <span>Capture HUD</span>
                <span
                    class="moth-hud-state"
                    id="moth-hud-status"
                >
                    Idle
                </span>
            </div>

            <div class="moth-hud-row">

                <div class="moth-hud-cell">
                    <b id="moth-hud-captures">
                        0
                    </b>
                    <span>captures</span>
                </div>

                <div class="moth-hud-cell">
                    <b id="moth-hud-used">
                        0
                    </b>
                    <span>balls</span>
                </div>

                <div class="moth-hud-cell">
                    <b id="moth-hud-rate">
                        0%
                    </b>

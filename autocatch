    function installPanel() {
        injectStyle();

        if (
            document.getElementById(
                'moth-ac-panel'
            )
        ) {
            return true;
        }

        const host =
            document.querySelector(
                '#auto-corpo'
            );

        if (!host) {
            return false;
        }

        const panel =
            document.createElement(
                'section'
            );

        panel.id =
            'moth-ac-panel';

        panel.innerHTML =
            panelMarkup();

        host.prepend(panel);

        // Main toggle

        panel
            .querySelector(
                '#moth-ac-toggle'
            )
            .addEventListener(
                'click',
                () => {
                    setEnabled(
                        !settings.enabled
                    );
                }
            );

        // Interval

        const interval =
            panel.querySelector(
                '#moth-ac-interval'
            );

        interval.value =
            settings.intervalMs;

        interval.addEventListener(
            'change',
            () => {
                settings.intervalMs =
                    Math.max(
                        250,
                        Math.min(
                            5000,
                            Number(
                                interval.value
                            ) || 650
                        )
                    );

                interval.value =
                    settings.intervalMs;

                saveSettings();

                if (settings.enabled) {
                    schedule();
                }
            }
        );

        // Escalation

        const escalate =
            panel.querySelector(
                '#moth-ac-escalate'
            );

        escalate.value =
            settings.escalateAfter;

        escalate.addEventListener(
            'change',
            () => {
                settings.escalateAfter =
                    Math.max(
                        0,
                        Math.min(
                            100,
                            Number(
                                escalate.value
                            ) || 0
                        )
                    );

                escalate.value =
                    settings.escalateAfter;

                saveSettings();
            }
        );

        // Enabled ball types

        for (
            const checkbox of
            panel.querySelectorAll(
                '[data-moth-use]'
            )
        ) {
            const key =
                checkbox.dataset.mothUse;

            checkbox.checked =
                Boolean(
                    settings.use[key]
                );

            checkbox.addEventListener(
                'change',
                () => {
                    settings.use[key] =
                        checkbox.checked;

                    saveSettings();
                    updateUI();
                }
            );
        }

        // Ball reserves

        for (
            const input of
            panel.querySelectorAll(
                '[data-moth-reserve]'
            )
        ) {
            const key =
                input.dataset.mothReserve;

            input.value =
                Number(
                    settings.reserve[key] ||
                    0
                );

            input.addEventListener(
                'change',
                () => {
                    settings.reserve[key] =
                        Math.max(
                            0,
                            Number(
                                input.value
                            ) || 0
                        );

                    input.value =
                        settings.reserve[key];

                    saveSettings();
                }
            );
        }

        // HUD

        const hudCheck =
            panel.querySelector(
                '#moth-ac-hud-check'
            );

        hudCheck.checked =
            settings.showHud;

        hudCheck.addEventListener(
            'change',
            () => {
                settings.showHud =
                    hudCheck.checked;

                saveSettings();
                updateUI();
            }
        );

        // Reset

        panel
            .querySelector(
                '#moth-ac-reset'
            )
            .addEventListener(
                'click',
                resetStats
            );

        updateUI();

        return true;
    }

    // ---------------------------------------------------------------------
    // Capture HUD

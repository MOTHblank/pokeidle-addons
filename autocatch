// ==UserScript==
// @name         PokéIdle Auto Catch+
// @namespace    moth.pokeidle
// @version      4.2.0
// @description  Configurable auto-catch with capture statistics HUD.
// @match        https://pokeidle.io/*
// @match        https://www.pokeidle.io/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(() => {
    'use strict';

    const SETTINGS_KEY = 'moth-pokeidle-autocatch-v4';

    const DEFAULTS = {
        enabled: false,

        // How often to attempt a throw.
        intervalMs: 650,

        // 0 = keep using the weakest ball forever.
        // Example: 5 = after 5 attempts use the next available tier.
        escalateAfter: 0,

        showHud: true,

        use: {
            poke: true,
            super: true,
            ultra: true,

            // Deliberately disabled by default.
            master: false,
            other: false
        },

        // Never spend below these quantities.
        reserve: {
            poke: 0,
            super: 0,
            ultra: 0,
            master: 1,
            other: 0
        }
    };

    function loadSettings() {
        try {
            const saved =
                JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}');

            return {
                ...DEFAULTS,
                ...saved,
                use: {
                    ...DEFAULTS.use,
                    ...(saved.use || {})
                },
                reserve: {
                    ...DEFAULTS.reserve,
                    ...(saved.reserve || {})
                }
            };
        } catch {
            return structuredClone(DEFAULTS);
        }
    }

    let settings = loadSettings();

    let timer = null;

    let currentTargetSignature = null;
    let currentTargetToken = 0;
    let targetThrows = 0;

    let resolvedTokens = new Set();

    let lastHistoryFingerprint = '';
    let historyObserver = null;
    let sessionObserver = null;
    let observedSessionCaptures = null;
    let sessionCaptureBase = null;

    /*
     * Most recent accepted throw against the current body. Used only as
     * a fallback when the game's capture/session UI does not expose a
     * direct success update.
     */
    let pendingOutcome = null;

    const inventoryBaseline = new Map();

    let stats = freshStats();

    function freshStats() {
        return {
            startedAt: Date.now(),

            attempts: 0,
            captures: 0,
            inferredCaptures: 0,

            used: {
                poke: 0,
                super: 0,
                ultra: 0,
                master: 0,
                other: 0
            },

            status: 'Idle'
        };
    }

    // ---------------------------------------------------------------------
    // Settings
    // ---------------------------------------------------------------------

    function saveSettings() {
        localStorage.setItem(
            SETTINGS_KEY,
            JSON.stringify(settings)
        );
    }

    // ---------------------------------------------------------------------
    // General helpers
    // ---------------------------------------------------------------------

    function normalize(value) {
        return String(value || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase();
    }

    function visible(el) {
        if (!el || !el.isConnected) {
            return false;
        }

        if (
            el.hidden ||
            el.classList?.contains('hidden')
        ) {
            return false;
        }

        const style = getComputedStyle(el);

        if (
            style.display === 'none' ||
            style.visibility === 'hidden' ||
            style.pointerEvents === 'none'
        ) {
            return false;
        }

        /*
         * getClientRects() also catches hidden ancestors, which
         * getComputedStyle(el) alone does not.
         */
        return el.getClientRects().length > 0;
    }

    function fireClick(el) {
        if (!el?.isConnected) {
            return false;
        }

        /*
         * HTMLElement.click() follows the browser's normal activation
         * behavior and is considerably more reliable in Chrome than
         * manually manufacturing PointerEvent/MouseEvent sequences.
         */
        try {
            if (typeof el.click === 'function') {
                el.click();
                return true;
            }
        } catch (_) {}

        /*
         * Fallback for a non-HTMLElement interactive node.
         */
        try {
            return el.dispatchEvent(
                new MouseEvent('click', {
                    bubbles: true,
                    cancelable: true,
                    composed: true,
                    view: window
                })
            );
        } catch (_) {
            return false;
        }
    }

    // ---------------------------------------------------------------------
    // Poké Balls
    // ---------------------------------------------------------------------

    function classifyBall(button) {
        const text = normalize([
            button?.title,
            button?.getAttribute('aria-label'),
            button?.querySelector('img')?.src
        ]
            .filter(Boolean)
            .join(' '));

        if (text.includes('master')) {
            return 'master';
        }

        if (text.includes('ultra')) {
            return 'ultra';
        }

        if (
            text.includes('super') ||
            text.includes('great')
        ) {
            return 'super';
        }

        if (text.includes('poke')) {
            return 'poke';
        }

        return 'other';
    }

    function ballCount(button) {
        const title = button?.title || '';

        const match = title.match(
            /(?:voce tem|você tem)\s+([\d.,]+)/i
        );

        if (!match) {
            return null;
        }

        // Ball counts are integers:
        // 4.972 -> 4972
        const digits = match[1]
            .replace(/\D/g, '');

        return digits
            ? Number(digits)
            : null;
    }

    function ballLabel(button) {
        const title = button?.title || '';

        return (
            title.split('—')[0].trim() ||
            classifyBall(button)
        );
    }

    function ballIdentity(button) {
        const key = classifyBall(button);

        const img = normalize(
            button?.querySelector('img')?.src || ''
        );

        return [
            key,
            normalize(ballLabel(button)),
            img
        ].join('|');
    }

    function getBallButtons() {
        return [
            ...document.querySelectorAll(
                '#caidos-bolas button.caidos-bola'
            )
        ];
    }

    /*
     * Track actual inventory decreases instead of assuming
     * every generated click was accepted by the game.
     */
    function syncInventoryUsage() {
        for (const button of getBallButtons()) {
            const count = ballCount(button);

            if (count === null) {
                continue;
            }

            const id = ballIdentity(button);
            const key = classifyBall(button);

            const previous =
                inventoryBaseline.get(id);

            if (
                previous !== undefined &&
                count < previous
            ) {
                stats.used[key] +=
                    previous - count;
            }

            inventoryBaseline.set(id, count);
        }
    }

    function rankFor(key) {
        return {
            poke: 0,
            super: 1,
            ultra: 2,
            other: 3,
            master: 4
        }[key] ?? 99;
    }

    function getEligibleBalls() {
        return getBallButtons()
            .map((button, index) => {
                const key = classifyBall(button);

                return {
                    button,
                    key,
                    index,
                    count: ballCount(button),
                    rank: rankFor(key)
                };
            })

            .filter(({
                button,
                key,
                count
            }) => {
                if (
                    button.disabled ||
                    !visible(button)
                ) {
                    return false;
                }

                if (!settings.use[key]) {
                    return false;
                }

                const reserve =
                    Number(
                        settings.reserve[key] || 0
                    );

                return (
                    count === null ||
                    count > reserve
                );
            })

            .sort(
                (a, b) =>
                    a.rank - b.rank ||
                    a.index - b.index
            );
    }

    function chooseBall() {
        const eligible =
            getEligibleBalls();

        if (!eligible.length) {
            return null;
        }

        // Weakest ball by default.
        let index = 0;

        /*
         * Optional escalation:
         *
         * escalateAfter = 5
         *
         * throws 0-4  -> Poké
         * throws 5-9  -> Super
         * throws 10+  -> Ultra
         */
        if (settings.escalateAfter > 0) {
            index = Math.floor(
                targetThrows /
                settings.escalateAfter
            );

            index = Math.min(
                index,
                eligible.length - 1
            );
        }

        return eligible[index];
    }

    function selectBall(choice) {
        if (!choice?.button?.isConnected) {
            return false;
        }

        if (
            !choice.button.classList.contains('on')
        ) {
            return fireClick(choice.button);
        }

        return true;
    }

    // ---------------------------------------------------------------------
    // Targets
    // ---------------------------------------------------------------------

    function getTarget() {
        const list =
            document.querySelector('#caidos-lista');

        if (!list) {
            return null;
        }

        for (const child of list.children) {
            if (visible(child)) {
                return child;
            }
        }

        return null;
    }

    function getTargetClickElement(target) {
        if (!target?.isConnected) {
            return null;
        }

        const interactiveSelector = [
            'button:not([disabled])',
            '[role="button"]',
            'a[href]',
            '[data-action]',
            '[onclick]'
        ].join(',');

        /*
         * If the row itself is interactive, use it. Otherwise click the
         * deepest explicit control. Clicking a descendant still bubbles
         * to row-level handlers, so this covers both DOM designs.
         */
        if (target.matches?.(interactiveSelector)) {
            return target;
        }

        return (
            [...target.querySelectorAll(interactiveSelector)]
                .find(visible) ||
            target
        );
    }

    function targetSignature(target) {
        if (!target) {
            return '';
        }

        for (
            const attr of [
                'data-id',
                'data-pokemon-id',
                'data-poke-id',
                'data-uid'
            ]
        ) {
            const value =
                target.getAttribute?.(attr);

            if (value) {
                return `${attr}:${value}`;
            }
        }

        const image = normalize(
            target.querySelector?.('img')?.src || ''
        );

        const text = normalize(
            target.textContent
        )
            .replace(/\s+/g, ' ')
            .trim();

        return `${image}|${text.slice(0, 120)}`;
    }

    // ---------------------------------------------------------------------
    // Capture detection
    // ---------------------------------------------------------------------

    function historyFingerprint() {
        const panel =
            document.querySelector(
                '#capturas-painel'
            );

        if (!panel) {
            return '';
        }

        const text = normalize(
            panel.textContent
        )
            .replace(/\s+/g, ' ')
            .trim();

        const images = [
            ...panel.querySelectorAll('img')
        ]
            .map(img => normalize(img.src))
            .join('|');

        return [
            panel.children.length,
            text,
            images
        ].join('|');
    }

    function signatureStillPresent(signature) {
        const list =
            document.querySelector(
                '#caidos-lista'
            );

        if (
            !list ||
            !signature
        ) {
            return false;
        }

        return [...list.children].some(
            child =>
                targetSignature(child) ===
                signature
        );
    }

    function recordCapture(
        token,
        inferred,
        source = inferred ? 'target removed' : 'game UI'
    ) {
        if (resolvedTokens.has(token)) {
            return;
        }

        resolvedTokens.add(token);

        stats.captures++;

        if (inferred) {
            stats.inferredCaptures++;
        }

        if (
            pendingOutcome?.token === token
        ) {
            pendingOutcome = null;
        }

        currentTargetSignature = null;
        targetThrows = 0;

        stats.status = inferred
            ? `Captured ~ (${source})`
            : `Captured (${source})`;

        updateUI();
    }

    function sessionCaptureCount() {
        const panel =
            document.querySelector(
                '#sessao-painel'
            );

        if (!panel) {
            return null;
        }

        const text = normalize(
            panel.textContent
        )
            .replace(/\s+/g, ' ')
            .trim();

        if (!text) {
            return null;
        }

        /*
         * The session card is localized, so accept the common Portuguese
         * and English labels rather than depending on one exact sentence.
         */
        const patterns = [
            /(?:capturas?|capturados?)\s*[:\-]?\s*([\d.,]+)/i,
            /(?:captures?|caught)\s*[:\-]?\s*([\d.,]+)/i
        ];

        for (const pattern of patterns) {
            const match =
                text.match(pattern);

            if (!match) {
                continue;
            }

            const digits =
                match[1].replace(/\D/g, '');

            if (digits) {
                return Number(digits);
            }
        }

        return null;
    }

    function syncSessionCaptureCount() {
        const total =
            sessionCaptureCount();

        if (total === null) {
            return false;
        }

        if (
            observedSessionCaptures === null
        ) {
            observedSessionCaptures =
                total;

            sessionCaptureBase =
                total;

            return false;
        }

        /*
         * Session reset / new hunt.
         */
        if (
            total <
            observedSessionCaptures
        ) {
            observedSessionCaptures =
                total;

            sessionCaptureBase =
                total;

            return false;
        }

        if (
            total ===
            observedSessionCaptures
        ) {
            return false;
        }

        const delta =
            total -
            observedSessionCaptures;

        observedSessionCaptures =
            total;

        /*
         * A server/session counter is authoritative. Apply every newly
         * observed capture, but resolve the current target token first so
         * a later DOM-removal fallback cannot double count it.
         */
        for (
            let i = 0;
            i < delta;
            i++
        ) {
            if (
                i === 0 &&
                currentTargetToken &&
                !resolvedTokens.has(
                    currentTargetToken
                )
            ) {
                recordCapture(
                    currentTargetToken,
                    false,
                    'session'
                );
            } else {
                stats.captures++;
                stats.status =
                    'Captured (session)';
            }
        }

        updateUI();
        return true;
    }

    function checkPendingOutcome() {
        const pending =
            pendingOutcome;

        if (
            !pending ||
            resolvedTokens.has(
                pending.token
            )
        ) {
            return;
        }

        const age =
            Date.now() -
            pending.sentAt;

        /*
         * Keep the correlation alive much longer than the old 1.45 s
         * polling window. Captures can resolve after the ball animation
         * and network response.
         */
        if (age > 6500) {
            pendingOutcome = null;
            return;
        }

        const history =
            historyFingerprint();

        if (
            history &&
            history !==
                pending.beforeHistory &&
            history !==
                lastHistoryFingerprint
        ) {
            lastHistoryFingerprint =
                history;

            recordCapture(
                pending.token,
                false,
                'history'
            );

            return;
        }

        if (syncSessionCaptureCount()) {
            return;
        }

        if (age < 500) {
            return;
        }

        const list =
            document.querySelector(
                '#caidos-lista'
            );

        const nowCount =
            list?.children.length ?? 0;

        const gone =
            !signatureStillPresent(
                pending.signature
            );

        if (!gone) {
            return;
        }

        /*
         * Only infer a capture if the throw was actually accepted by the
         * game (the chosen ball count went down) and the target vanished
         * shortly afterwards. This is much safer than body disappearance
         * by itself.
         */
        const currentButton =
            getBallButtons().find(
                button =>
                    ballIdentity(button) ===
                    pending.ballIdentity
            );

        const countNow =
            ballCount(currentButton);

        const ballConsumed =
            (
                pending.ballCountBefore !==
                    null &&
                countNow !== null &&
                countNow <
                    pending.ballCountBefore
            ) ||
            (
                pending.ballCountBefore ===
                    null &&
                totalUsed() >
                    pending.usedBefore
            );

        if (
            ballConsumed &&
            nowCount <=
                pending.beforeCount
        ) {
            recordCapture(
                pending.token,
                true,
                'accepted throw + target removed'
            );
        }
    }

    function installCaptureObservers() {
        const historyPanel =
            document.querySelector(
                '#capturas-painel'
            );

        if (
            historyPanel &&
            historyObserver?.target !==
                historyPanel
        ) {
            historyObserver?.observer
                ?.disconnect();

            const observer =
                new MutationObserver(() => {
                    checkPendingOutcome();
                });

            observer.observe(
                historyPanel,
                {
                    childList: true,
                    subtree: true,
                    characterData: true
                }
            );

            historyObserver = {
                observer,
                target: historyPanel
            };
        }

        const sessionPanel =
            document.querySelector(
                '#sessao-painel'
            );

        if (
            sessionPanel &&
            sessionObserver?.target !==
                sessionPanel
        ) {
            sessionObserver?.observer
                ?.disconnect();

            const observer =
                new MutationObserver(() => {
                    syncSessionCaptureCount();
                });

            observer.observe(
                sessionPanel,
                {
                    childList: true,
                    subtree: true,
                    characterData: true
                }
            );

            sessionObserver = {
                observer,
                target: sessionPanel
            };

            syncSessionCaptureCount();
        }
    }

    function monitorOutcome({
        target,
        signature,
        token,
        beforeHistory,
        beforeCount,
        ballIdentity: thrownBallIdentity,
        ballCountBefore,
        usedBefore
    }) {
        pendingOutcome = {
            target,
            signature,
            token,
            beforeHistory,
            beforeCount,
            ballIdentity:
                thrownBallIdentity,
            ballCountBefore,
            usedBefore,
            sentAt: Date.now()
        };

        /*
         * Mutation observers normally resolve this immediately. These
         * delayed checks cover clients that batch UI updates.
         */
        for (
            const delay of [
                250,
                500,
                900,
                1400,
                2200,
                3200,
                4500,
                6200
            ]
        ) {
            setTimeout(
                checkPendingOutcome,
                delay
            );
        }
    }

    // ---------------------------------------------------------------------
    // Statistics
    // ---------------------------------------------------------------------

    function resetStats() {
        stats = freshStats();

        inventoryBaseline.clear();

        resolvedTokens =
            new Set();

        currentTargetSignature =
            null;

        targetThrows = 0;

        lastHistoryFingerprint =
            historyFingerprint();

        observedSessionCaptures =
            null;

        sessionCaptureBase =
            null;

        pendingOutcome =
            null;

        installCaptureObservers();
        syncSessionCaptureCount();

        syncInventoryUsage();
        updateUI();
    }

    function totalUsed() {
        return Object
            .values(stats.used)
            .reduce(
                (sum, value) =>
                    sum + value,
                0
            );
    }

    // ---------------------------------------------------------------------
    // Automation loop
    // ---------------------------------------------------------------------

    function setEnabled(value) {
        settings.enabled =
            Boolean(value);

        saveSettings();

        clearTimeout(timer);
        timer = null;

        stats.status =
            settings.enabled
                ? 'Starting'
                : 'Paused';

        updateUI();

        if (settings.enabled) {
            tick();
        }
    }

    function schedule() {
        clearTimeout(timer);
        timer = null;

        if (!settings.enabled) {
            return;
        }

        timer = setTimeout(
            tick,
            Math.max(
                250,
                Number(
                    settings.intervalMs
                ) || 650
            )
        );
    }

    function tick() {
        timer = null;

        if (!settings.enabled) {
            return;
        }

        installPanel();
        installHud();

        syncInventoryUsage();

        const fallenPanel =
            document.querySelector('#caidos');

        const target = getTarget();

        if (
            !fallenPanel ||
            fallenPanel.classList.contains(
                'hidden'
            ) ||
            !target
        ) {
            stats.status =
                'Waiting for target';

            updateUI();
            schedule();

            return;
        }

        const signature =
            targetSignature(target);

        /*
         * New defeated Pokémon.
         */
        if (
            signature !==
            currentTargetSignature
        ) {
            currentTargetSignature =
                signature;

            currentTargetToken++;
            targetThrows = 0;
        }

        const choice = chooseBall();

        if (!choice) {
            stats.status =
                'No allowed balls';

            updateUI();
            schedule();

            return;
        }

        selectBall(choice);

        const list =
            document.querySelector(
                '#caidos-lista'
            );

        const beforeHistory =
            historyFingerprint();

        const beforeCount =
            list?.children.length ?? 0;

        const token =
            currentTargetToken;

        /*
         * Let the game's selected-ball class settle. Chrome can commit
         * the button state on a later task, so 160 ms is deliberately
         * less aggressive than the old 90 ms.
         */
        const chosenIdentity =
            ballIdentity(choice.button);

        const countBeforeThrow =
            choice.count;

        setTimeout(() => {
            if (
                !settings.enabled ||
                !target.isConnected
            ) {
                return;
            }

            const clickTarget =
                getTargetClickElement(target);

            if (!clickTarget) {
                stats.status =
                    'Target has no clickable control';

                updateUI();
                return;
            }

            const sent =
                fireClick(clickTarget);

            if (!sent) {
                stats.status =
                    'Target click failed';

                updateUI();
                return;
            }

            stats.attempts++;
            targetThrows++;

            stats.status =
                `Throwing ${ballLabel(
                    choice.button
                )}`;

            monitorOutcome({
                target,
                signature,
                token,
                beforeHistory,
                beforeCount,
                ballIdentity:
                    chosenIdentity,
                ballCountBefore:
                    countBeforeThrow,
                usedBefore:
                    totalUsed()
            });

            /*
             * Confirm that Chrome/game accepted the throw by watching the
             * selected ball inventory. This does not affect gameplay; it
             * only makes failures visible in the HUD.
             */
            setTimeout(() => {
                syncInventoryUsage();

                if (
                    countBeforeThrow !== null &&
                    target.isConnected
                ) {
                    const currentButton =
                        getBallButtons().find(
                            button =>
                                ballIdentity(button) ===
                                chosenIdentity
                        );

                    const countAfterThrow =
                        ballCount(currentButton);

                    if (
                        countAfterThrow !== null &&
                        countAfterThrow >=
                            countBeforeThrow
                    ) {
                        stats.status =
                            'Click sent · ball not consumed';
                    }
                }

                updateUI();
            }, 450);

            updateUI();
        }, 160);

        schedule();
    }

    // ---------------------------------------------------------------------
    // Styling
    // ---------------------------------------------------------------------

    function injectStyle() {
        if (
            document.getElementById(
                'moth-ac-style'
            )
        ) {
            return;
        }

        const style =
            document.createElement('style');

        style.id =
            'moth-ac-style';

        style.textContent = `
            #moth-ac-panel {
                margin: 8px 0 10px;
                padding: 9px;

                border:
                    1px solid
                    rgba(255,255,255,.14);

                border-radius: 8px;

                background:
                    rgba(18,15,18,.72);

                color: #f4edf0;

                font:
                    12px/1.3
                    system-ui,
                    sans-serif;
            }

            #moth-ac-panel * {
                box-sizing: border-box;
            }

            #moth-ac-panel button,
            #moth-ac-panel input {
                font: inherit;
            }

            .moth-ac-head {
                display: flex;
                align-items: center;
                gap: 8px;

                margin-bottom: 8px;
            }

            .moth-ac-title {
                font-weight: 750;
                font-size: 13px;
            }

            .moth-ac-status {
                min-width: 0;
                flex: 1;

                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;

                color: #b9adb2;
                font-size: 11px;
            }

            .moth-ac-toggle {
                border:
                    1px solid
                    rgba(255,255,255,.18);

                border-radius: 999px;

                padding: 4px 9px;

                color: white;
                background: #5b3038;

                cursor: pointer;
                font-weight: 700;
            }

            .moth-ac-toggle.on {
                background: #23683d;
            }

            .moth-ac-stats {
                display: grid;

                grid-template-columns:
                    repeat(
                        3,
                        minmax(0, 1fr)
                    );

                gap: 5px;

                margin-bottom: 8px;
            }

            .moth-ac-stat {
                padding: 5px 6px;

                border-radius: 6px;

                background:
                    rgba(255,255,255,.06);

                text-align: center;
            }

            .moth-ac-stat b {
                display: block;
                font-size: 14px;
            }

            .moth-ac-stat span {
                color: #aaa0a4;
                font-size: 10px;
            }

            .moth-ac-grid {
                display: grid;

                grid-template-columns:

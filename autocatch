// ==UserScript==
// @name         PokéIdle Auto Catch+
// @namespace    moth.pokeidle
// @version      5.0.0
// @description  Configurable auto-catch with protocol-backed capture stats and per-target state.
// @match        https://pokeidle.io/*
// @match        https://www.pokeidle.io/*
// @grant        unsafeWindow
// @run-at       document-start
// ==/UserScript==

(() => {
    'use strict';

    const SETTINGS_KEY = 'moth-pokeidle-autocatch-v4';
    const page = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
    const q = (selector, root = document) => root.querySelector(selector);
    const qa = (selector, root = document) => [...root.querySelectorAll(selector)];

    const DEFAULTS = {
        enabled: false,
        intervalMs: 650,
        showHud: true,
        use: {
            poke: true,
            super: true,
            ultra: true,
            master: false,
            other: false
        },
        reserve: {
            poke: 0,
            super: 0,
            ultra: 0,
            master: 1,
            other: 0
        }
    };

    function loadSettings() {
        try {
            const saved = JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}');

            // escalation existed in v4; intentionally ignore it from now on.
            return {
                ...DEFAULTS,
                ...saved,
                use: {
                    ...DEFAULTS.use,
                    ...(saved.use || {})
                },
                reserve: {
                    ...DEFAULTS.reserve,
                    ...(saved.reserve || {})
                }
            };
        } catch {
            return structuredClone(DEFAULTS);
        }
    }

    let settings = loadSettings();
    let timer = null;

    const inventoryBaseline = new Map();
    const targetStates = new Map();
    const recentProtocolFingerprints = new Map();

    let stats = freshStats();
    let protocolHookInstalled = false;
    let protocolSockets = 0;
    let protocolMessages = 0;
    let protocolCaptureSignals = 0;
    let protocolLastType = 'waiting';

    function freshStats() {
        return {
            startedAt: Date.now(),
            attempts: 0,
            captures: 0,
            used: {
                poke: 0,
                super: 0,
                ultra: 0,
                master: 0,
                other: 0
            },
            status: 'Idle'
        };
    }

    function saveSettings() {
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
    }

    function normalize(value) {
        return String(value ?? '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .replace(/\s+/g, ' ')
            .trim();
    }

    function visible(el) {
        if (!el?.isConnected || el.hidden || el.classList?.contains('hidden')) return false;

        const style = getComputedStyle(el);
        if (
            style.display === 'none' ||
            style.visibility === 'hidden' ||
            style.pointerEvents === 'none'
        ) return false;

        return el.getClientRects().length > 0;
    }

    function fireClick(el) {
        if (!el?.isConnected) return false;

        try {
            if (typeof el.click === 'function') {
                el.click();
                return true;
            }
        } catch {}

        try {
            return el.dispatchEvent(new MouseEvent('click', {
                bubbles: true,
                cancelable: true,
                composed: true,
                view: window
            }));
        } catch {
            return false;
        }
    }

    // ---------------------------------------------------------------------
    // Ball inventory
    // ---------------------------------------------------------------------

    function classifyBall(button) {
        const text = normalize([
            button?.title,
            button?.getAttribute('aria-label'),
            button?.querySelector('img')?.src
        ].filter(Boolean).join(' '));

        if (text.includes('master')) return 'master';
        if (text.includes('ultra')) return 'ultra';
        if (text.includes('super') || text.includes('great')) return 'super';
        if (text.includes('poke')) return 'poke';
        return 'other';
    }

    function ballCount(button) {
        const title = button?.title || '';
        const match = title.match(/(?:voce tem|você tem|you have|tienes)\s+([\d.,]+)/i);
        if (!match) return null;

        const digits = match[1].replace(/\D/g, '');
        return digits ? Number(digits) : null;
    }

    function ballLabel(button) {
        const title = button?.title || '';
        return title.split('—')[0].trim() || classifyBall(button);
    }

    function ballIdentity(button) {
        return [
            classifyBall(button),
            normalize(ballLabel(button)),
            normalize(button?.querySelector('img')?.src || '')
        ].join('|');
    }

    function getBallButtons() {
        return qa('#caidos-bolas button.caidos-bola');
    }

    function syncInventoryUsage() {
        for (const button of getBallButtons()) {
            const count = ballCount(button);
            if (count === null) continue;

            const id = ballIdentity(button);
            const key = classifyBall(button);
            const previous = inventoryBaseline.get(id);

            if (previous !== undefined && count < previous) {
                stats.used[key] += previous - count;
            }

            inventoryBaseline.set(id, count);
        }
    }

    function totalUsed() {
        return Object.values(stats.used).reduce((sum, value) => sum + value, 0);
    }

    function rankFor(key) {
        return {
            poke: 0,
            super: 1,
            ultra: 2,
            other: 3,
            master: 4
        }[key] ?? 99;
    }

    function getEligibleBalls() {
        return getBallButtons()
            .map((button, index) => ({
                button,
                key: classifyBall(button),
                index,
                count: ballCount(button),
                rank: rankFor(classifyBall(button))
            }))
            .filter(({ button, key, count }) => {
                if (button.disabled || !visible(button) || !settings.use[key]) return false;

                const reserve = Number(settings.reserve[key] || 0);
                return count === null || count > reserve;
            })
            .sort((a, b) => a.rank - b.rank || a.index - b.index);
    }

    function chooseBall() {
        // v5 intentionally has no escalation. Always use the weakest
        // enabled ball that is above its configured reserve.
        return getEligibleBalls()[0] || null;
    }

    function selectBall(choice) {
        if (!choice?.button?.isConnected) return false;

        if (!choice.button.classList.contains('on')) {
            return fireClick(choice.button);
        }

        return true;
    }

    // ---------------------------------------------------------------------
    // Per-target state
    // ---------------------------------------------------------------------

    function targetProtocolIds(target) {
        const ids = new Set();

        for (const attr of [
            'data-id',
            'data-pokemon-id',
            'data-poke-id',
            'data-uid',
            'data-caido-id',
            'data-corpo-id',
            'data-target-id'
        ]) {
            const value = target?.getAttribute?.(attr);
            if (value) ids.add(String(value));
        }

        if (target?.dataset) {
            for (const [key, value] of Object.entries(target.dataset)) {
                if (value && /id$/i.test(key)) ids.add(String(value));
            }
        }

        return ids;
    }

    function targetInstanceId(target) {
        /*
         * Only identifiers that are likely to identify this fallen body,
         * not the Pokémon species. data-pokemon-id/data-poke-id remain
         * useful for protocol matching but are not safe map keys when two
         * identical species are on the floor at the same time.
         */
        for (const attr of [
            'data-caido-id',
            'data-corpo-id',
            'data-target-id',
            'data-uid',
            'data-id'
        ]) {
            const value = target?.getAttribute?.(attr);
            if (value) return String(value);
        }

        return null;
    }

    function targetName(target) {
        const explicit = [
            target?.getAttribute?.('data-name'),
            target?.getAttribute?.('data-pokemon-name'),
            target?.getAttribute?.('aria-label'),
            target?.getAttribute?.('title'),
            target?.querySelector?.('img')?.alt,
            target?.querySelector?.('[data-nome]')?.getAttribute('data-nome')
        ].find(Boolean);

        if (explicit) return String(explicit).trim();

        const text = String(target?.textContent || '')
            .replace(/\s+/g, ' ')
            .trim();

        if (!text) return 'Pokémon';

        // Avoid turning the whole card into the HUD label.
        return text.split(/[·•|—\n]/)[0].trim().slice(0, 36) || 'Pokémon';
    }

    function fallbackTargetSignature(target) {
        return [
            normalize(target?.querySelector?.('img')?.src || ''),
            normalize(targetName(target))
        ].join('|');
    }

    function scanTargets() {
        const list = q('#caidos-lista');
        if (!list) return [];

        const occurrences = new Map();
        const now = Date.now();
        const entries = [];

        for (const element of [...list.children]) {
            if (!visible(element)) continue;

            const ids = targetProtocolIds(element);
            const strongId = targetInstanceId(element);
            const base = strongId ? 'id:' + strongId : fallbackTargetSignature(element);

            const occurrence = occurrences.get(base) || 0;
            occurrences.set(base, occurrence + 1);

            const key = strongId ? base : `${base}#${occurrence}`;

            let state = targetStates.get(key);

            if (!state) {
                state = {
                    key,
                    ids,
                    name: targetName(element),
                    element,
                    firstSeenAt: now,
                    lastSeenAt: now,
                    lastAttemptAt: 0,
                    throws: 0,
                    lastBallKey: null,
                    lastBallLabel: null,
                    lastResult: null,
                    captured: false,
                    capturedAt: 0
                };

                targetStates.set(key, state);
            } else {
                state.element = element;
                state.ids = ids;
                state.name = targetName(element) || state.name;
                state.lastSeenAt = now;
            }

            entries.push(state);
        }

        pruneTargetStates(now);
        return entries;
    }

    function pruneTargetStates(now = Date.now()) {
        for (const [key, state] of targetStates) {
            const unseenFor = now - state.lastSeenAt;
            const attemptAge = state.lastAttemptAt ? now - state.lastAttemptAt : Infinity;

            if (
                (state.captured && unseenFor > 2000) ||
                (unseenFor > 8000 && attemptAge > 12000) ||
                unseenFor > 45000
            ) {
                targetStates.delete(key);
            }
        }

        for (const [fingerprint, time] of recentProtocolFingerprints) {
            if (now - time > 10000) recentProtocolFingerprints.delete(fingerprint);
        }
    }

    function getTargetClickElement(target) {
        if (!target?.isConnected) return null;

        const selector = [
            'button:not([disabled])',
            '[role="button"]',
            'a[href]',
            '[data-action]',
            '[onclick]'
        ].join(',');

        if (target.matches?.(selector)) return target;

        return qa(selector, target).find(visible) || target;
    }

    function currentTargetState() {
        const states = [...targetStates.values()];

        return states
            .filter(state => state.lastAttemptAt > 0 && !state.captured)
            .sort((a, b) => b.lastAttemptAt - a.lastAttemptAt)[0]
            || states.find(state => !state.captured)
            || null;
    }

    function formatTargetState(state) {
        if (!state) return 'No target';

        const parts = [
            state.name || 'Pokémon',
            `${state.throws} throw${state.throws === 1 ? '' : 's'}`
        ];

        if (state.lastBallLabel) parts.push(state.lastBallLabel);
        if (state.captured) parts.push('captured');

        return parts.join(' · ');
    }

    // ---------------------------------------------------------------------
    // Authoritative WebSocket capture result
    // ---------------------------------------------------------------------

    function primitive(value) {
        return (
            value === null ||
            ['string', 'number', 'boolean'].includes(typeof value)
        );
    }

    function outcomeValue(value) {
        if (typeof value === 'boolean') return value;
        if (value === 1 || value === '1') return true;
        if (value === 0 || value === '0') return false;

        const text = normalize(value);

        if (/^(success|successful|sucesso|captured|caught|capturado|capturada|capturou|pegou|ok)$/.test(text)) {
            return true;
        }

        if (/^(fail|failed|failure|falha|falhou|escaped|escape|fugiu|nao|não)$/.test(text)) {
            return false;
        }

        return null;
    }

    function captureCandidateFromObject(object, path) {
        if (!object || typeof object !== 'object' || Array.isArray(object)) return null;

        const entries = Object.entries(object);
        const normalizedEntries = entries.map(([key, value]) => [
            normalize(key),
            primitive(value) ? normalize(value) : ''
        ]);

        const context = normalizedEntries
            .flatMap(([key, value]) => [key, value])
            .join(' ');

        const captureContext = /captur|capture|caught|catch/.test(context);
        const ballContext = /poke.?ball|pokeball|bola|ball/.test(context);

        let success = null;
        let explicitCaptureOutcome = false;

        for (const [rawKey, value] of entries) {
            const key = normalize(rawKey);

            if (
                /^(capturou|capturado|capturada|captured|caught)$/.test(key)
            ) {
                const parsed = outcomeValue(value);
                if (parsed !== null) {
                    success = parsed;
                    explicitCaptureOutcome = true;
                }
            }

            if (
                /^(success|sucesso|ok|resultado|result|status|estado)$/.test(key)
            ) {
                const parsed = outcomeValue(value);
                if (parsed !== null && captureContext) success = parsed;
            }

            if (
                /^(tipo|type|evento|event|acao|action|op|kind)$/.test(key)
            ) {
                const type = normalize(value);

                if (/capturad|caught|capture.?success|captura.?sucesso/.test(type)) {
                    success = true;
                    explicitCaptureOutcome = true;
                } else if (/captur.*(?:fail|falh)|capture.*fail/.test(type)) {
                    success = false;
                    explicitCaptureOutcome = true;
                }
            }
        }

        if (
            success === null ||
            (!captureContext && !explicitCaptureOutcome) ||
            (!captureContext && ballContext && !explicitCaptureOutcome)
        ) {
            return null;
        }

        const ids = new Set();
        let name = '';
        let type = '';

        for (const [rawKey, value] of entries) {
            if (!primitive(value)) continue;

            const key = normalize(rawKey);

            if (
                /(?:^|_)(?:id|uid)$/.test(key) ||
                /(?:pokemon|poke|caido|corpo|alvo|target).*id/.test(key)
            ) {
                if (value !== null && value !== '') ids.add(String(value));
            }

            if (
                !name &&
                /^(?:nome|name|species|especie|pokemon_name|pokemon_nome)$/.test(key)
            ) {
                name = String(value);
            }

            if (
                !type &&
                /^(?:tipo|type|evento|event|acao|action|op|kind)$/.test(key)
            ) {
                type = String(value);
            }
        }

        return {
            success,
            ids,
            name,
            type: type || path,
            path
        };
    }

    function findCaptureCandidates(value, path = 'root', depth = 0, out = []) {
        if (depth > 7 || value == null) return out;

        if (Array.isArray(value)) {
            for (let i = 0; i < value.length; i++) {
                findCaptureCandidates(value[i], `${path}[${i}]`, depth + 1, out);
            }

            return out;
        }

        if (typeof value !== 'object') return out;

        const candidate = captureCandidateFromObject(value, path);
        if (candidate) out.push(candidate);

        for (const [key, child] of Object.entries(value)) {
            if (child && typeof child === 'object') {
                findCaptureCandidates(child, `${path}.${key}`, depth + 1, out);
            }
        }

        return out;
    }

    function decodeProtocolData(data) {
        if (typeof data === 'string') {
            try {
                return JSON.parse(data);
            } catch {
                return null;
            }
        }

        if (data instanceof ArrayBuffer) {
            try {
                return JSON.parse(new TextDecoder().decode(data));
            } catch {
                return null;
            }
        }

        return null;
    }

    function candidateFingerprint(candidate) {
        return [
            candidate.success ? '1' : '0',
            normalize(candidate.type),
            [...candidate.ids].sort().join(','),
            normalize(candidate.name)
        ].join('|');
    }

    function matchTargetForProtocol(candidate) {
        const now = Date.now();

        let states = [...targetStates.values()]
            .filter(state =>
                !state.captured &&
                state.lastAttemptAt > 0 &&
                now - state.lastAttemptAt < 12000
            );

        if (!states.length) return null;

        if (candidate.ids.size) {
            const exact = states.find(state =>
                [...candidate.ids].some(id => state.ids.has(id))
            );

            if (exact) return exact;
        }

        const candidateName = normalize(candidate.name);

        if (candidateName) {
            const named = states
                .filter(state => {
                    const stateName = normalize(state.name);
                    return (
                        stateName === candidateName ||
                        stateName.includes(candidateName) ||
                        candidateName.includes(stateName)
                    );
                })
                .sort((a, b) => b.lastAttemptAt - a.lastAttemptAt)[0];

            if (named) return named;
        }

        // The result is still authoritative; only target correlation falls
        // back to the most recent unresolved throw.
        return states.sort((a, b) => b.lastAttemptAt - a.lastAttemptAt)[0];
    }

    function handleCaptureCandidate(candidate) {
        const now = Date.now();
        const fingerprint = candidateFingerprint(candidate);
        const previous = recentProtocolFingerprints.get(fingerprint);

        // One server result may be represented more than once in nested
        // payload objects. De-duplicate identical semantic results.
        if (previous && now - previous < 1800) return;
        recentProtocolFingerprints.set(fingerprint, now);

        protocolCaptureSignals++;
        protocolLastType = candidate.type || candidate.path || 'capture';

        const state = matchTargetForProtocol(candidate);

        if (!state) {
            stats.status = candidate.success
                ? 'Capture signal received · no matching target'
                : 'Capture failure signal · no matching target';
            updateUI();
            return;
        }

        state.lastResult = candidate.success ? 'captured' : 'failed';

        if (!candidate.success) {
            stats.status = `${state.name} · capture failed · ${state.throws} throws`;
            updateUI();
            return;
        }

        if (state.captured) return;

        state.captured = true;
        state.capturedAt = now;
        stats.captures++;
        stats.status = `${state.name} · captured · ${state.throws} throws`;

        updateUI();
    }

    function inspectProtocolMessage(data) {
        protocolMessages++;

        const decoded = decodeProtocolData(data);
        if (!decoded) return;

        for (const candidate of findCaptureCandidates(decoded)) {
            handleCaptureCandidate(candidate);
        }
    }

    function attachProtocolSocket(socket) {
        protocolSockets++;

        socket.addEventListener('message', event => {
            if (typeof Blob !== 'undefined' && event.data instanceof Blob) {
                event.data.text()
                    .then(inspectProtocolMessage)
                    .catch(() => {});
                return;
            }

            inspectProtocolMessage(event.data);
        });
    }

    function installProtocolHook() {
        if (protocolHookInstalled) return true;

        const NativeWebSocket = page.WebSocket;
        if (typeof NativeWebSocket !== 'function') return false;

        if (page.__mothAutoCatchWebSocketHook) {
            protocolHookInstalled = true;
            return true;
        }

        const WrappedWebSocket = new Proxy(NativeWebSocket, {
            construct(target, args) {
                const socket = Reflect.construct(target, args, target);
                attachProtocolSocket(socket);
                return socket;
            }
        });

        try {
            page.WebSocket = WrappedWebSocket;
            page.__mothAutoCatchWebSocketHook = true;
            protocolHookInstalled = page.WebSocket === WrappedWebSocket;

            if (protocolHookInstalled) {
                console.info('[PokéIdle Auto Catch+] WebSocket capture hook installed');
            }
        } catch (error) {
            console.warn('[PokéIdle Auto Catch+] WebSocket hook failed', error);
            protocolHookInstalled = false;
        }

        return protocolHookInstalled;
    }

    // Install before PokéIdle creates its socket.
    installProtocolHook();

    // ---------------------------------------------------------------------
    // Automation
    // ---------------------------------------------------------------------

    function setEnabled(value) {
        settings.enabled = Boolean(value);
        saveSettings();

        clearTimeout(timer);
        timer = null;

        stats.status = settings.enabled ? 'Starting' : 'Paused';
        updateUI();

        if (settings.enabled) tick();
    }

    function schedule() {
        clearTimeout(timer);
        timer = null;

        if (!settings.enabled) return;

        timer = setTimeout(
            tick,
            Math.max(250, Number(settings.intervalMs) || 650)
        );
    }

    function tick() {
        timer = null;

        if (!settings.enabled) return;

        installPanel();
        installHud();
        syncInventoryUsage();

        const fallenPanel = q('#caidos');
        const states = scanTargets();
        const state = states.find(item => !item.captured);

        if (
            !fallenPanel ||
            fallenPanel.classList.contains('hidden') ||
            !state
        ) {
            stats.status = 'Waiting for target';
            updateUI();
            schedule();
            return;
        }

        const choice = chooseBall();

        if (!choice) {
            stats.status = 'No allowed balls';
            updateUI();
            schedule();
            return;
        }

        selectBall(choice);

        const targetElement = state.element;
        const ballId = ballIdentity(choice.button);
        const ballBefore = choice.count;
        const ballName = ballLabel(choice.button);

        setTimeout(() => {
            if (
                !settings.enabled ||
                state.captured ||
                !targetElement?.isConnected
            ) return;

            const clickTarget = getTargetClickElement(targetElement);

            if (!clickTarget) {
                stats.status = 'Target has no clickable control';
                updateUI();
                return;
            }

            if (!fireClick(clickTarget)) {
                stats.status = 'Target click failed';
                updateUI();
                return;
            }

            const now = Date.now();

            state.throws++;
            state.lastAttemptAt = now;
            state.lastBallKey = choice.key;
            state.lastBallLabel = ballName;
            state.lastBallIdentity = ballId;
            state.lastBallCountBefore = ballBefore;
            state.lastResult = 'pending';

            stats.attempts++;
            stats.status = formatTargetState(state);

            /*
             * Ball inventory is still useful for "balls used" statistics,
             * but it no longer decides whether a capture succeeded.
             */
            setTimeout(() => {
                syncInventoryUsage();

                if (
                    ballBefore !== null &&
                    !state.captured
                ) {
                    const currentButton = getBallButtons().find(
                        button => ballIdentity(button) === ballId
                    );

                    const after = ballCount(currentButton);

                    if (after !== null && after >= ballBefore) {
                        state.lastResult = 'not-consumed';
                        stats.status =
                            `${state.name} · click sent · ball not consumed`;
                    }
                }

                updateUI();
            }, 450);

            updateUI();
        }, 160);

        schedule();
    }

    function resetStats() {
        stats = freshStats();
        inventoryBaseline.clear();
        targetStates.clear();
        recentProtocolFingerprints.clear();

        syncInventoryUsage();
        updateUI();
    }

    // ---------------------------------------------------------------------
    // UI
    // ---------------------------------------------------------------------

    function injectStyle() {
        if (q('#moth-ac-style')) return;

        const style = document.createElement('style');
        style.id = 'moth-ac-style';
        style.textContent = `
            #moth-ac-panel {
                margin: 8px 0 10px;
                padding: 9px;
                border: 1px solid rgba(255,255,255,.14);
                border-radius: 8px;
                background: rgba(18,15,18,.72);
                color: #f4edf0;
                font: 12px/1.3 system-ui,sans-serif;
            }

            #moth-ac-panel * { box-sizing: border-box; }
            #moth-ac-panel button,
            #moth-ac-panel input { font: inherit; }

            .moth-ac-head {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 7px;
            }

            .moth-ac-title {
                font-weight: 750;
                font-size: 13px;
            }

            .moth-ac-status {
                min-width: 0;
                flex: 1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                color: #b9adb2;
                font-size: 10px;
            }

            .moth-ac-toggle {
                border: 1px solid rgba(255,255,255,.18);
                border-radius: 999px;
                padding: 4px 9px;
                color: white;
                background: #5b3038;
                cursor: pointer;
                font-weight: 700;
            }

            .moth-ac-toggle.on { background: #23683d; }

            .moth-ac-current {
                margin-bottom: 7px;
                padding: 5px 7px;
                border-radius: 5px;
                background: rgba(255,255,255,.045);
                color: #d7cdd1;
                font-size: 10px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .moth-ac-stats {
                display: grid;
                grid-template-columns: repeat(3,minmax(0,1fr));
                gap: 5px;
                margin-bottom: 7px;
            }

            .moth-ac-stat {
                padding: 5px 6px;
                border-radius: 6px;
                background: rgba(255,255,255,.06);
                text-align: center;
            }

            .moth-ac-stat b {
                display: block;
                font-size: 14px;
            }

            .moth-ac-stat span {
                color: #aaa0a4;
                font-size: 9px;
            }

            .moth-ac-grid {
                display: grid;
                grid-template-columns: 1fr 72px;
                gap: 5px 8px;
                align-items: center;
            }

            .moth-ac-grid input[type="number"],
            .moth-ac-ball input[type="number"] {
                padding: 3px 5px;
                border-radius: 5px;
                border: 1px solid rgba(255,255,255,.14);
                color: white;
                background: rgba(0,0,0,.22);
            }

            .moth-ac-grid input[type="number"] { width: 72px; }

            .moth-ac-balls {
                display: grid;
                grid-template-columns: repeat(2,minmax(0,1fr));
                gap: 4px 8px;
                margin-top: 7px;
            }

            .moth-ac-ball {
                display: grid;
                grid-template-columns: auto 1fr 54px;
                align-items: center;
                gap: 4px;
                min-width: 0;
            }

            .moth-ac-ball span {
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .moth-ac-ball input[type="number"] { width: 54px; }

            .moth-ac-foot {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-top: 7px;
                padding-top: 6px;
                border-top: 1px solid rgba(255,255,255,.08);
                color: #aaa0a4;
                font-size: 10px;
            }

            .moth-ac-foot label {
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .moth-ac-reset {
                margin-left: auto;
                padding: 3px 7px;
                border: 1px solid rgba(255,255,255,.15);
                border-radius: 5px;
                color: #ddd;
                background: rgba(255,255,255,.05);
                cursor: pointer;
            }

            #moth-capture-hud {
                position: absolute;
                top: 42px;
                right: 8px;
                z-index: 45;
                min-width: 174px;
                max-width: 245px;
                padding: 7px 8px;
                border: 1px solid rgba(255,255,255,.18);
                border-radius: 7px;
                background: rgba(18,16,20,.82);
                color: white;
                font: 11px/1.25 system-ui,sans-serif;
                pointer-events: none;
                backdrop-filter: blur(3px);
            }

            .moth-hud-head {
                display: flex;
                justify-content: space-between;
                gap: 8px;
                margin-bottom: 5px;
                font-weight: 700;
            }

            .moth-hud-state {
                color: #aab0b4;
                font-weight: 500;
            }

            .moth-hud-row {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 4px;
            }

            .moth-hud-cell {
                padding: 4px;
                border-radius: 4px;
                background: rgba(255,255,255,.07);
                text-align: center;
            }

            .moth-hud-cell b {
                display: block;
                font-size: 13px;
            }

            .moth-hud-cell span {
                color: #aaa0a4;
                font-size: 9px;
            }

            .moth-hud-target {
                margin-top: 5px;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
                color: #ded4d8;
                font-size: 10px;
            }

            .moth-hud-balls,
            .moth-hud-protocol {
                margin-top: 4px;
                color: #a99fa3;
                text-align: center;
                font-size: 9px;
            }
        `;

        (document.head || document.documentElement).appendChild(style);
    }

    function ballControl(key, label) {
        return `
            <label class="moth-ac-ball" title="Enable this ball type and keep this reserve.">
                <input type="checkbox" data-moth-use="${key}">
                <span>${label}</span>
                <input type="number" min="0" step="1" data-moth-reserve="${key}" title="Reserve">
            </label>
        `;
    }

    function panelMarkup() {
        return `
            <div class="moth-ac-head">
                <span class="moth-ac-title">Auto Catch+</span>
                <span class="moth-ac-status" id="moth-ac-status">Idle</span>
                <button type="button" class="moth-ac-toggle" id="moth-ac-toggle">OFF</button>
            </div>

            <div class="moth-ac-current" id="moth-ac-current">No target</div>

            <div class="moth-ac-stats">
                <div class="moth-ac-stat"><b id="moth-ac-captures">0</b><span>captures</span></div>
                <div class="moth-ac-stat"><b id="moth-ac-balls-used">0</b><span>balls used</span></div>
                <div class="moth-ac-stat"><b id="moth-ac-rate">0%</b><span>success</span></div>
            </div>

            <div class="moth-ac-grid">
                <label for="moth-ac-interval">Throw interval</label>
                <input id="moth-ac-interval" type="number" min="250" max="5000" step="50">
            </div>

            <div class="moth-ac-balls">
                ${ballControl('poke', 'Poké')}
                ${ballControl('super', 'Super')}
                ${ballControl('ultra', 'Ultra')}
                ${ballControl('master', 'Master')}
            </div>

            <div class="moth-ac-foot">
                <label><input id="moth-ac-hud-check" type="checkbox"> HUD</label>
                <span id="moth-ac-protocol">Protocol: loading</span>
                <button type="button" class="moth-ac-reset" id="moth-ac-reset">Reset stats</button>
            </div>
        `;
    }

    function installPanel() {
        injectStyle();

        if (q('#moth-ac-panel')) return true;

        const host = q('#auto-corpo');
        if (!host) return false;

        const panel = document.createElement('section');
        panel.id = 'moth-ac-panel';
        panel.innerHTML = panelMarkup();
        host.prepend(panel);

        q('#moth-ac-toggle', panel).addEventListener('click', () => {
            setEnabled(!settings.enabled);
        });

        const interval = q('#moth-ac-interval', panel);
        interval.value = settings.intervalMs;

        interval.addEventListener('change', () => {
            settings.intervalMs = Math.max(
                250,
                Math.min(5000, Number(interval.value) || 650)
            );

            interval.value = settings.intervalMs;
            saveSettings();

            if (settings.enabled) schedule();
        });

        for (const checkbox of qa('[data-moth-use]', panel)) {
            const key = checkbox.dataset.mothUse;
            checkbox.checked = Boolean(settings.use[key]);

            checkbox.addEventListener('change', () => {
                settings.use[key] = checkbox.checked;
                saveSettings();
                updateUI();
            });
        }

        for (const input of qa('[data-moth-reserve]', panel)) {
            const key = input.dataset.mothReserve;
            input.value = Number(settings.reserve[key] || 0);

            input.addEventListener('change', () => {
                settings.reserve[key] = Math.max(0, Number(input.value) || 0);
                input.value = settings.reserve[key];
                saveSettings();
            });
        }

        const hudCheck = q('#moth-ac-hud-check', panel);
        hudCheck.checked = settings.showHud;

        hudCheck.addEventListener('change', () => {
            settings.showHud = hudCheck.checked;
            saveSettings();
            updateUI();
        });

        q('#moth-ac-reset', panel).addEventListener('click', resetStats);

        updateUI();
        return true;
    }

    function installHud() {
        injectStyle();

        if (q('#moth-capture-hud')) return true;

        const palco = q('#palco');
        if (!palco) return false;

        if (getComputedStyle(palco).position === 'static') {
            palco.style.position = 'relative';
        }

        const hud = document.createElement('div');
        hud.id = 'moth-capture-hud';
        hud.innerHTML = `
            <div class="moth-hud-head">
                <span>Capture HUD</span>
                <span class="moth-hud-state" id="moth-hud-status">Idle</span>
            </div>

            <div class="moth-hud-row">
                <div class="moth-hud-cell"><b id="moth-hud-captures">0</b><span>captures</span></div>
                <div class="moth-hud-cell"><b id="moth-hud-used">0</b><span>balls</span></div>
                <div class="moth-hud-cell"><b id="moth-hud-rate">0%</b><span>rate</span></div>
            </div>

            <div class="moth-hud-target" id="moth-hud-target">No target</div>
            <div class="moth-hud-balls" id="moth-hud-balls"></div>
            <div class="moth-hud-protocol" id="moth-hud-protocol"></div>
        `;

        palco.appendChild(hud);
        updateUI();

        return true;
    }

    function formatDuration(ms) {
        const total = Math.max(0, Math.floor(ms / 1000));
        const hours = Math.floor(total / 3600);
        const minutes = Math.floor((total % 3600) / 60);
        const seconds = total % 60;

        if (hours) {
            return [
                hours,
                String(minutes).padStart(2, '0'),
                String(seconds).padStart(2, '0')
            ].join(':');
        }

        return `${minutes}:${String(seconds).padStart(2, '0')}`;
    }

    function setText(selector, value) {
        const el = q(selector);
        if (el) el.textContent = String(value);
    }

    function protocolLabel() {
        if (!protocolHookInstalled) return 'Protocol: hook failed';
        if (!protocolSockets) return 'Protocol: waiting for socket';
        if (!protocolCaptureSignals) return `Protocol: live · ${protocolMessages} msgs`;
        return `Protocol: ${protocolLastType}`;
    }

    function updateUI() {
        const used = totalUsed();
        const denominator = used || stats.attempts;
        const rate = denominator ? (stats.captures / denominator) * 100 : 0;
        const state = currentTargetState();
        const targetText = formatTargetState(state);
        const protocolText = protocolLabel();

        const toggle = q('#moth-ac-toggle');

        if (toggle) {
            toggle.textContent = settings.enabled ? 'ON' : 'OFF';
            toggle.classList.toggle('on', settings.enabled);
        }

        setText('#moth-ac-status', stats.status);
        setText('#moth-ac-current', targetText);
        setText('#moth-ac-captures', stats.captures);
        setText('#moth-ac-balls-used', used);
        setText('#moth-ac-rate', `${rate.toFixed(rate >= 10 ? 0 : 1)}%`);
        setText('#moth-ac-protocol', protocolText);

        const hud = q('#moth-capture-hud');

        if (hud) {
            hud.style.display = settings.showHud ? 'block' : 'none';
        }

        setText('#moth-hud-status', settings.enabled ? stats.status : 'Paused');
        setText('#moth-hud-captures', stats.captures);
        setText('#moth-hud-used', used);
        setText('#moth-hud-rate', `${rate.toFixed(rate >= 10 ? 0 : 1)}%`);
        setText('#moth-hud-target', targetText);
        setText(
            '#moth-hud-balls',
            [
                `P ${stats.used.poke}`,
                `S ${stats.used.super}`,
                `U ${stats.used.ultra}`,
                stats.used.master ? `M ${stats.used.master}` : null,
                `· ${formatDuration(Date.now() - stats.startedAt)}`
            ].filter(Boolean).join('  ')
        );
        setText('#moth-hud-protocol', protocolText);
    }

    // ---------------------------------------------------------------------
    // Bootstrap
    // ---------------------------------------------------------------------

    function bootstrap() {
        installProtocolHook();
        installPanel();
        installHud();

        scanTargets();
        syncInventoryUsage();
        updateUI();

        setInterval(() => {
            installPanel();
            installHud();
            scanTargets();
            syncInventoryUsage();
            updateUI();
        }, 1000);

        if (settings.enabled) tick();

        console.info('[PokéIdle Auto Catch+] v5 loaded');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
        bootstrap();
    }
})();

    // ---------------------------------------------------------------------
    // UI update
    // ---------------------------------------------------------------------

    function formatDuration(ms) {
        const total =
            Math.max(
                0,
                Math.floor(ms / 1000)
            );

        const hours =
            Math.floor(total / 3600);

        const minutes =
            Math.floor(
                (total % 3600) / 60
            );

        const seconds =
            total % 60;

        if (hours) {
            return [
                hours,
                String(minutes).padStart(
                    2,
                    '0'
                ),
                String(seconds).padStart(
                    2,
                    '0'
                )
            ].join(':');
        }

        return (
            `${minutes}:` +
            String(seconds).padStart(
                2,
                '0'
            )
        );
    }

    function setText(
        selector,
        value
    ) {
        const el =
            document.querySelector(
                selector
            );

        if (el) {
            el.textContent =
                String(value);
        }
    }

    function updateUI() {
        const used =
            totalUsed();

        /*
         * Prefer actual inventory consumption.
         * If unavailable, fall back to click attempts.
         */
        const denominator =
            used ||
            stats.attempts;

        const rate =
            denominator
                ? (
                    stats.captures /
                    denominator
                ) * 100
                : 0;

        /*
         * "~" means at least one capture had
         * to be inferred from target removal.
         */
        const capturesText =
            stats.inferredCaptures
                ? `${stats.captures}~`
                : String(
                    stats.captures
                );

        const toggle =
            document.querySelector(
                '#moth-ac-toggle'
            );

        if (toggle) {
            toggle.textContent =
                settings.enabled
                    ? 'ON'
                    : 'OFF';

            toggle.classList.toggle(
                'on',
                settings.enabled
            );
        }

        setText(
            '#moth-ac-status',
            stats.status
        );

        setText(
            '#moth-ac-captures',
            capturesText
        );

        setText(
            '#moth-ac-balls-used',
            used
        );

        setText(
            '#moth-ac-rate',
            `${rate.toFixed(
                rate >= 10
                    ? 0
                    : 1
            )}%`
        );

        const hud =
            document.querySelector(
                '#moth-capture-hud'
            );

        if (hud) {
            hud.style.display =
                settings.showHud
                    ? 'block'
                    : 'none';
        }

        setText(
            '#moth-hud-status',
            settings.enabled
                ? stats.status
                : 'Paused'
        );

        setText(
            '#moth-hud-captures',
            capturesText
        );

        setText(
            '#moth-hud-used',
            used
        );

        setText(
            '#moth-hud-rate',
            `${rate.toFixed(
                rate >= 10
                    ? 0
                    : 1
            )}%`
        );

        const balls = [
            `P ${stats.used.poke}`,
            `S ${stats.used.super}`,
            `U ${stats.used.ultra}`,

            stats.used.master
                ? `M ${stats.used.master}`
                : null,

            `· ${
                formatDuration(
                    Date.now() -
                    stats.startedAt
                )
            }`
        ]
            .filter(Boolean)
            .join('  ');

        setText(
            '#moth-hud-balls',
            balls
        );

        const panel =
            document.querySelector(
                '#moth-ac-panel'
            );

        if (panel) {
            panel.title =
                stats.inferredCaptures
                    ? (
                        '~ means ' +
                        `${stats.inferredCaptures} ` +
                        'capture(s) were inferred.'
                    )
                    : '';
        }
    }

    // ---------------------------------------------------------------------
    // Bootstrap
    // ---------------------------------------------------------------------

    function bootstrap() {
        installPanel();
        installHud();
        installCaptureObservers();

        lastHistoryFingerprint =
            historyFingerprint();

        syncSessionCaptureCount();
        syncInventoryUsage();
        updateUI();

        /*
         * Keeps the addon alive if the site's UI
         * is rebuilt/moved dynamically.
         */
        setInterval(() => {
            installPanel();
            installHud();
            installCaptureObservers();

            syncSessionCaptureCount();
            checkPendingOutcome();
            syncInventoryUsage();
            updateUI();
        }, 1000);

        if (settings.enabled) {
            tick();
        }
    }

    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            bootstrap,
            { once: true }
        );
    } else {
        bootstrap();
    }
})();

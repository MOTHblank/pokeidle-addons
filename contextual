// ==UserScript==
// @name         PokéIdle Contextual Quick Actions
// @namespace    moth.pokeidle
// @version      1.1.0
// @description  Small context-aware quick navigation palette for PokéIdle.
// @match        https://pokeidle.io/*
// @match        https://www.pokeidle.io/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(() => {
    'use strict';

    const BUTTON_ID = 'moth-quick-actions-button';
    const PANEL_ID = 'moth-quick-actions-panel';
    const STYLE_ID = 'moth-quick-actions-style';
    const STORAGE_KEY = 'moth-pokeidle-quick-actions-v2';

    const q = (selector, root = document) => root.querySelector(selector);

    function visible(el) {
        if (!el || !el.isConnected || el.classList.contains('hidden')) return false;
        const style = getComputedStyle(el);
        return style.display !== 'none' && style.visibility !== 'hidden';
    }

    function loadPrefs() {
        try {
            return { shortcut: true, ...JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') };
        } catch {
            return { shortcut: true };
        }
    }

    const prefs = loadPrefs();

    function savePrefs() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
    }

    function clickSelector(selector) {
        const el = q(selector);
        if (!el) return false;
        el.click();
        closeMenu();
        return true;
    }

    function openModal(name) {
        return clickSelector(`[data-modal="${name}"]`);
    }

    function currentContext() {
        if (visible(q('#hunt-saida'))) return 'hunt';

        if (
            visible(q('#pvp-mini')) ||
            visible(q('#pvp-fila-pill')) ||
            visible(q('#pvp-tick'))
        ) return 'pvp';

        if (
            visible(q('#centro-dpad')) ||
            visible(q('#centro-curar')) ||
            visible(q('#centro-tm'))
        ) return 'center';

        if (visible(q('#modal'))) return 'modal';
        return 'general';
    }

    const contextLabels = {
        hunt: 'Hunt',
        pvp: 'PvP',
        center: 'Centro',
        modal: 'Menu aberto',
        general: 'Geral'
    };

    function action(id, label, hint, run, available = () => true) {
        return { id, label, hint, run, available };
    }

    const ACTIONS = {
        captures: action(
            'captures', 'Capturas', 'Histórico da sessão',
            () => clickSelector('#cena-capturas'),
            () => visible(q('#cena-capturas'))
        ),
        session: action(
            'session', 'Sessão', 'Estatísticas da hunt',
            () => clickSelector('#cena-sessao'),
            () => visible(q('#cena-sessao'))
        ),
        inventory: action(
            'inventory', 'Inventário', 'Bolas e itens',
            () => clickSelector('#btn-bolsa'),
            () => !!q('#btn-bolsa')
        ),
        map: action(
            'map', 'Mapa', 'Escolher área',
            () => openModal('mapa'),
            () => !!q('[data-modal="mapa"]')
        ),
        pokedex: action(
            'pokedex', 'Pokédex', 'Coleção e espécies',
            () => openModal('pokedex'),
            () => !!q('[data-modal="pokedex"]')
        ),
        market: action(
            'market', 'Market', 'Abrir mercado',
            () => openModal('market'),
            () => !!q('[data-modal="market"]')
        ),
        pvp: action(
            'pvp', 'PvP', 'Abrir painel PvP',
            () => openModal('pvp'),
            () => !!q('[data-modal="pvp"]')
        ),
        ranking: action(
            'ranking', 'Ranks', 'Ranking',
            () => openModal('ranking'),
            () => !!q('[data-modal="ranking"]')
        ),
        popup: action(
            'popup', 'Pop-up', 'Acompanhar a hunt',
            () => clickSelector('#hunt-popup'),
            () => visible(q('#hunt-popup'))
        ),
        center: action(
            'center', 'Centro Pokémon', 'Sair da hunt',
            () => clickSelector('#ir-centro'),
            () => visible(q('#ir-centro'))
        ),
        team: action(
            'team', 'Equipe', 'Abrir painel da equipe',
            () => {
                const toggle = q('#btn-equipe-toggle');
                const panel = toggle?.closest('.painel');
                if (!panel) return;
                if (toggle.getAttribute('aria-expanded') === 'false') toggle.click();
                panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
                closeMenu();
            },
            () => !!q('#btn-equipe-toggle')
        ),
        settings: action(
            'settings', 'Configurações', 'Preferências',
            () => clickSelector('#btn-config'),
            () => !!q('#btn-config')
        ),
        closeModal: action(
            'closeModal', 'Fechar', 'Voltar ao jogo',
            () => clickSelector('#modal-fechar'),
            () => visible(q('#modal')) && !!q('#modal-fechar')
        ),
        autoCatch: action(
            'autoCatch', 'Auto Catch', 'Alternar captura automática',
            () => clickSelector('#moth-ac-toggle'),
            () => !!q('#moth-ac-toggle')
        ),
        captureHud: action(
            'captureHud', 'Capture HUD', 'Mostrar / ocultar',
            () => {
                const check = q('#moth-ac-hud-check');
                if (!check) return;
                check.click();
                closeMenu();
            },
            () => !!q('#moth-ac-hud-check')
        ),
        performance: action(
            'performance', 'Performance+', 'Abrir controles',
            () => clickSelector('#moth-performance-trigger'),
            () => !!q('#moth-performance-trigger')
        )
    };

    const BY_CONTEXT = {
        hunt: ['captures', 'session', 'inventory', 'map', 'popup', 'center', 'autoCatch', 'captureHud', 'performance'],
        pvp: ['pvp', 'team', 'inventory', 'ranking', 'map', 'performance', 'settings'],
        center: ['map', 'inventory', 'team', 'pokedex', 'market', 'pvp', 'performance', 'settings'],
        modal: ['closeModal', 'map', 'inventory', 'pokedex', 'market', 'pvp'],
        general: ['map', 'inventory', 'pokedex', 'market', 'pvp', 'team', 'performance', 'settings']
    };

    function injectStyle() {
        if (q('#' + STYLE_ID)) return;

        const style = document.createElement('style');
        style.id = STYLE_ID;
        style.textContent = `
            #${BUTTON_ID} {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 5px !important;
                min-width: 0 !important;
                width: auto !important;
                height: auto !important;
                min-height: 30px !important;
                padding: 5px 9px !important;
                margin: 0 !important;
                border: 1px solid rgba(255,255,255,.18) !important;
                border-radius: 6px !important;
                background: rgba(49,36,42,.88) !important;
                color: #fff !important;
                font: 700 11px/1 system-ui,sans-serif !important;
                cursor: pointer !important;
                opacity: 1 !important;
                visibility: visible !important;
                position: relative !important;
                z-index: 20 !important;
            }

            #${BUTTON_ID}::before {
                content: "⚡";
                font-size: 11px;
            }

            #${PANEL_ID} {
                position: fixed !important;
                z-index: 2147483647 !important;
                width: 265px !important;
                padding: 9px !important;
                border: 1px solid rgba(255,255,255,.18) !important;
                border-radius: 9px !important;
                background: rgba(24,18,22,.98) !important;
                color: #f5eef1 !important;
                box-shadow: 0 10px 32px rgba(0,0,0,.5) !important;
                font: 11px/1.25 system-ui,sans-serif !important;
            }

            #${PANEL_ID}[hidden] { display: none !important; }

            #${PANEL_ID} * { box-sizing: border-box !important; }

            #${PANEL_ID} .mqa-head {
                display: flex;
                align-items: center;
                gap: 7px;
                margin-bottom: 7px;
            }

            #${PANEL_ID} .mqa-head strong {
                flex: 1;
                font-size: 12px;
            }

            #${PANEL_ID} .mqa-context {
                color: #b7abb0;
                font-size: 10px;
            }

            #${PANEL_ID} .mqa-close {
                all: unset;
                cursor: pointer;
                padding: 2px 5px;
                color: #bbb;
                font-size: 16px;
            }

            #${PANEL_ID} .mqa-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 5px;
            }

            #${PANEL_ID} .mqa-action {
                all: unset;
                display: block;
                min-width: 0;
                padding: 7px 8px;
                border: 1px solid rgba(255,255,255,.09);
                border-radius: 6px;
                background: rgba(255,255,255,.045);
                color: #f2eaed;
                cursor: pointer;
            }

            #${PANEL_ID} .mqa-action:hover {
                background: rgba(255,255,255,.1);
            }

            #${PANEL_ID} .mqa-action b {
                display: block;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
                font-size: 10px;
            }

            #${PANEL_ID} .mqa-action span {
                display: block;
                margin-top: 2px;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
                color: #9f9599;
                font-size: 9px;
            }

            #${PANEL_ID} .mqa-foot {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 8px;
                margin-top: 7px;
                padding-top: 6px;
                border-top: 1px solid rgba(255,255,255,.07);
                color: #91868b;
                font-size: 9px;
            }
        `;

        (document.head || document.documentElement).appendChild(style);
    }

    function ensurePanel() {
        let panel = q('#' + PANEL_ID);
        if (panel) return panel;

        panel = document.createElement('div');
        panel.id = PANEL_ID;
        panel.hidden = true;
        panel.innerHTML = `
            <div class="mqa-head">
                <strong>Quick Actions</strong>
                <span class="mqa-context">Geral</span>
                <button type="button" class="mqa-close" title="Fechar">×</button>
            </div>
            <div class="mqa-grid"></div>
            <div class="mqa-foot">
                <span>Shift+Q</span>
                <label><input class="mqa-shortcut" type="checkbox"> atalho</label>
            </div>
        `;

        document.body.appendChild(panel);
        panel.querySelector('.mqa-close').addEventListener('click', closeMenu);

        const shortcut = panel.querySelector('.mqa-shortcut');
        shortcut.checked = prefs.shortcut;
        shortcut.addEventListener('change', () => {
            prefs.shortcut = shortcut.checked;
            savePrefs();
        });

        return panel;
    }

    function ensureButton() {
        if (!document.body) return false;
        injectStyle();
        ensurePanel();

        let button = q('#' + BUTTON_ID);
        if (button) return true;

        const host = q('.menu-topo') || q('.painel-cab-auto') || q('#p-auto .painel-cab');
        if (!host) return false;

        button = document.createElement('button');
        button.type = 'button';
        button.id = BUTTON_ID;
        button.textContent = 'Quick';
        button.title = 'Quick Actions loaded — Shift+Q';
        button.addEventListener('click', event => {
            event.preventDefault();
            event.stopPropagation();
            toggleMenu();
        });

        const collapse = host.querySelector('#btn-auto-toggle');
        if (collapse) host.insertBefore(button, collapse);
        else host.appendChild(button);

        return true;
    }

    function positionPanel() {
        const button = q('#' + BUTTON_ID);
        const panel = q('#' + PANEL_ID);
        if (!button || !panel || panel.hidden) return;

        const rect = button.getBoundingClientRect();
        const width = 265;
        const left = Math.max(8, Math.min(window.innerWidth - width - 8, rect.left));

        panel.style.left = left + 'px';

        const below = rect.bottom + 6;
        if (below + panel.offsetHeight <= window.innerHeight - 8) {
            panel.style.top = below + 'px';
            panel.style.bottom = 'auto';
        } else {
            panel.style.top = 'auto';
            panel.style.bottom = Math.max(8, window.innerHeight - rect.top + 6) + 'px';
        }
    }

    function dynamicLabel(item) {
        if (item.id === 'autoCatch') {
            const on = q('#moth-ac-toggle')?.textContent?.trim().toUpperCase() === 'ON';
            return `Auto Catch: ${on ? 'ON' : 'OFF'}`;
        }
        if (item.id === 'captureHud') {
            return `Capture HUD: ${q('#moth-ac-hud-check')?.checked ? 'ON' : 'OFF'}`;
        }
        return item.label;
    }

    function renderActions() {
        const panel = ensurePanel();
        const context = currentContext();
        panel.querySelector('.mqa-context').textContent = contextLabels[context] || 'Geral';

        const grid = panel.querySelector('.mqa-grid');
        grid.replaceChildren();

        const items = (BY_CONTEXT[context] || BY_CONTEXT.general)
            .map(id => ACTIONS[id])
            .filter(item => item && item.available());

        for (const item of items) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'mqa-action';

            const strong = document.createElement('b');
            strong.textContent = dynamicLabel(item);

            const hint = document.createElement('span');
            hint.textContent = item.hint;

            button.append(strong, hint);
            button.addEventListener('click', item.run);
            grid.appendChild(button);
        }
    }

    function openMenu() {
        if (!ensureButton()) return;
        const panel = ensurePanel();
        renderActions();
        panel.hidden = false;
        positionPanel();
    }

    function closeMenu() {
        const panel = q('#' + PANEL_ID);
        if (panel) panel.hidden = true;
    }

    function toggleMenu() {
        const panel = ensurePanel();
        if (panel.hidden) openMenu();
        else closeMenu();
    }

    function isTyping(target) {
        return target instanceof HTMLElement &&
            !!target.closest('input,textarea,select,[contenteditable="true"]');
    }

    document.addEventListener('keydown', event => {
        if (!prefs.shortcut || isTyping(event.target)) return;

        if (
            event.shiftKey &&
            !event.ctrlKey &&
            !event.altKey &&
            !event.metaKey &&
            event.code === 'KeyQ'
        ) {
            event.preventDefault();
            toggleMenu();
        } else if (event.key === 'Escape') {
            closeMenu();
        }
    }, true);

    document.addEventListener('pointerdown', event => {
        const panel = q('#' + PANEL_ID);
        const button = q('#' + BUTTON_ID);
        if (!panel || panel.hidden) return;
        if (!panel.contains(event.target) && !button?.contains(event.target)) closeMenu();
    }, true);

    window.addEventListener('resize', positionPanel, { passive: true });
    window.addEventListener('scroll', positionPanel, { passive: true, capture: true });

    function bootstrap() {
        ensureButton();
        setInterval(() => {
            ensureButton();
            if (!q('#' + PANEL_ID)?.hidden) {
                renderActions();
                positionPanel();
            }
        }, 1200);
        console.info('[PokéIdle Quick Actions] loaded');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
        bootstrap();
    }
})();

                bike: null,
                gold: null,
                diamonds: null,
                gems: null,
                ballsTotal: null,
                itemsTotal: null,
                alive: 0,
                hp: 0,
                maxHp: 0,
                team: 0,
                teamSlots: '',
                automation: null,
                tutorialSeen: null,
                skinsWorn: 0,
                escapeRope: null
            };
        }

        const pokemons =
            Array.isArray(state.pokemons)
                ? state.pokemons
                : [];

        const team =
            pokemons
                .filter(
                    pokemon =>
                        pokemon.slot != null
                )
                .sort(
                    (a, b) =>
                        Number(a.slot) -
                        Number(b.slot)
                );

        return {
            scene:
                sceneLabel(state),
            noCentro:
                Boolean(state.noCentro),
            huntSlug:
                state.huntSlug != null
                    ? state.huntSlug
                    : null,
            casaDentro:
                state.casa &&
                state.casa.dentro != null
                    ? state.casa.dentro
                    : null,
            bossArena:
                Boolean(
                    state.boss &&
                    state.boss.arena
                ),
            mistico:
                Boolean(state.mistico),
            activeId:
                state.activeId != null
                    ? state.activeId
                    : null,
            bike:
                state.bicicleta &&
                state.bicicleta.equipada != null
                    ? state.bicicleta.equipada
                    : null,
            gold:
                state.gold != null
                    ? Number(state.gold)
                    : null,
            diamonds:
                state.diamonds != null
                    ? Number(state.diamonds)
                    : null,
            gems:
                state.gems != null
                    ? Number(state.gems)
                    : state.gemas != null
                        ? Number(state.gemas)
                        : null,
            ballsTotal:
                state.balls &&
                typeof state.balls === 'object'
                    ? Object.values(state.balls)
                        .reduce(
                            (sum, value) =>
                                sum +
                                Math.max(
                                    0,
                                    Number(value) || 0
                                ),
                            0
                        )
                    : null,
            itemsTotal:
                state.items &&
                typeof state.items === 'object'
                    ? Object.values(state.items)
                        .reduce(
                            (sum, value) =>
                                sum +
                                Math.max(
                                    0,
                                    Number(value) || 0
                                ),
                            0
                        )
                    : null,
            alive:
                pokemons.filter(
                    pokemon =>
                        Number(pokemon.hp || 0) > 0

    function firstOwnedBallId() {
        const balls =
            runtime.gameState &&
            runtime.gameState.balls;

        if (
            !balls ||
            typeof balls !== 'object'
        ) {
            return null;
        }

        const entry =
            Object.entries(balls)
                .map(
                    ([id, count]) => ({
                        id: Number(id),
                        count: Number(count) || 0
                    })
                )
                .filter(
                    row =>
                        Number.isFinite(row.id) &&
                        row.count > 0
                )
                .sort(
                    (a, b) =>
                        a.id - b.id
                )[0];

        return entry
            ? entry.id
            : null;
    }

    function unskinnedPokemon() {

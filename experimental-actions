            () => {
                ensureButton();
                updateUI();
            },
            1000
        );

        console.info(
            '[PokéIdle Experimental Actions] v1.1.0 loaded'
        );
    }

    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            bootstrap,
            {
                once: true
            }
        );
    } else {
        bootstrap();
    }
})();

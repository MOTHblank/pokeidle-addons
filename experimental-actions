            }

            html +=
                '</section>';
        }

        html +=
            '<div class="mea-live" data-mea-live hidden></div>';

        html +=
            '<div class="mea-log-head">' +
            '<b>Probe history</b>' +
            '<button type="button" class="mea-copy" data-mea-copy>Copy last</button>' +
            '<button type="button" class="mea-clear" data-mea-clear>Clear</button>' +

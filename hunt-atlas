    function pokemonPower(
        pokemon
    ) {
        const direct =
            Number(
                pokemon?.poder
            );

        if (
            Number.isFinite(direct) &&
            direct > 0
        ) {
            return direct;
        }

        const stats =
            pokemon?.stats || {};

        return [
            stats.hp,
            stats.atk,
            stats.def,
            stats.spAtk,
            stats.spDef,
            stats.speed
        ]
            .map(Number)
            .filter(Number.isFinite)
            .reduce(
                (sum, value) =>
                    sum + value,
                0
            );
    }

    function refreshStrongestPokemon() {
        const owned =
            [...state.pokemons.values()];

        state.strongestPokemon =
            owned
                .sort(
                    (a, b) =>
                        pokemonPower(b) -
                            pokemonPower(a) ||
                        Number(b.level || 0) -
                            Number(a.level || 0)
                )[0] || null;
    }

    function strongestSignature() {
        const pokemon =
            state.strongestPokemon;

        if (!pokemon) {
            return null;
        }

        return [
            pokemon.id,
            pokemon.speciesId,
            pokemon.level,
            Math.round(
                pokemonPower(pokemon)
            )
        ].join(':');
    }

    function currentStrongestActive() {
        const strongest =
            state.strongestPokemon;

        if (!strongest) {
            return false;
        }

        return (
            Number(state.activePokemonId) ===
            Number(strongest.id)
        );
    }

    function formatRate(
        value
    ) {
        const n =
            Number(value);

        if (
            !Number.isFinite(n) ||
            n <= 0
        ) {
            return '—';
        }

        if (n >= 1000000) {
            return (
                n / 1000000
            ).toFixed(
                n >= 10000000
                    ? 0
                    : 1
            ) + 'm';
        }

        if (n >= 1000) {
            return (
                n / 1000
            ).toFixed(
                n >= 100000
                    ? 0
                    : 1
            ) + 'k';
        }

        return Math.round(n)
            .toLocaleString();
    }

    function updateXpObservation(
        gameState
    ) {
        const now =
            Date.now();

        const nextXp =
            Number(
                gameState?.xp
            );

        const nextLevel =
            Number(
                gameState?.level
            );

        const nextThreshold =
            Number(
                gameState?.xpProximo
            );

        const nextNoCentro =
            gameState?.noCentro ===
                undefined
                ? state.trainerNoCentro
                : Boolean(
                    gameState.noCentro
                );

        if (
            state.trainerSampleAt &&
            state.currentHuntSlug &&
            !state.trainerNoCentro &&
            !nextNoCentro &&
            currentStrongestActive()
        ) {
            const elapsed =
                Math.min(
                    15000,
                    Math.max(
                        0,
                        now -
                            state.trainerSampleAt
                    )
                );

            let gained = 0;

            if (
                Number.isFinite(
                    state.trainerXp
                ) &&
                Number.isFinite(
                    nextXp
                )
            ) {
                if (
                    nextXp >=
                    state.trainerXp
                ) {
                    gained =
                        nextXp -
                        state.trainerXp;
                } else if (
                    Number.isFinite(
                        state.trainerXpNext
                    ) &&
                    Number.isFinite(
                        nextLevel
                    ) &&
                    Number.isFinite(
                        state.trainerLevel
                    ) &&
                    nextLevel >
                        state.trainerLevel
                ) {
                    gained =
                        Math.max(
                            0,
                            state.trainerXpNext -
                                state.trainerXp
                        ) +
                        Math.max(
                            0,
                            nextXp
                        );
                }
            }

            const key =
                state.currentHuntSlug;

            const strongest =
                state.strongestPokemon;

            const record = {
                activeMs: 0,
                xpGain: 0,
                samples: 0,
                pokemonId:
                    strongest?.id || null,
                pokemonSpeciesId:
                    strongest?.speciesId || null,
                pokemonLevel:
                    Number(
                        strongest?.level ||
                        0
                    ),
                pokemonPower:
                    pokemonPower(
                        strongest
                    ),
                updatedAt:
                    now,
                ...(state.huntPerf.get(
                    key
                ) || {})
            };

            record.activeMs =
                Number(
                    record.activeMs ||
                    0
                ) +
                elapsed;

            record.xpGain =
                Number(
                    record.xpGain ||
                    0
                ) +
                Math.max(
                    0,
                    gained
                );

            record.samples =
                Number(
                    record.samples ||
                    0
                ) +
                1;

            record.pokemonId =
                strongest?.id || null;

            record.pokemonSpeciesId =
                strongest?.speciesId ||
                null;

            record.pokemonLevel =
                Number(
                    strongest?.level ||
                    0
                );

            record.pokemonPower =
                pokemonPower(
                    strongest
                );

            record.updatedAt =
                now;

            state.huntPerf.set(
                key,
                record
            );

            if (
                record.samples % 8 === 0
            ) {
                savePerformance();
            }
        }

        if (
            Number.isFinite(
                nextXp
            )
        ) {
            state.trainerXp =
                nextXp;
        }

        if (
            Number.isFinite(
                nextLevel
            )
        ) {
            state.trainerLevel =
                nextLevel;
        }

        if (
            Number.isFinite(
                nextThreshold
            )
        ) {
            state.trainerXpNext =
                nextThreshold;
        }

        state.trainerNoCentro =
            nextNoCentro;

        state.trainerSampleAt =
            now;
    }


    // Navigation through PokéIdle's own map UI
    // ------------------------------------------------------------------

    function wait(
        ms
    ) {
        return new Promise(
            resolve =>
                setTimeout(
                    resolve,
                    ms
                )
        );
    }

    async function waitFor(
        predicate,
        timeout = 2500,
        step = 50
    ) {
        const started =
            Date.now();

        while (
            Date.now() -
            started <
            timeout
        ) {
            const value =
                predicate();

            if (value) {
                return value;
            }

            await wait(step);
        }

        return null;
    }

    function elementLooksLocked(
        el
    ) {
        const classes =
            normalize(
                el.className
            );

        return Boolean(
            el.disabled ||
            el.getAttribute(
                'aria-disabled'
            ) === 'true' ||
            /locked|bloquead|travado|indisponivel|disabled/.test(
                classes
            )
        );
    }

    function huntCandidateScore(
        element,
        hunt
    ) {
        const slug =
            normalize(
                hunt.slug
            );

        const name =
            normalize(
                hunt.nome
            );

        const area =
            normalize(
                hunt.area
            );

        const text =
            normalize(
                element.textContent
            );

        const title =
            normalize(
                element.getAttribute(
                    'title'
                )
            );

        const href =
            normalize(
                element.getAttribute(
                    'href'
                )
            );

        const attrs =
            [
                ...element.attributes
            ]
                .map(
                    attr =>
                        normalize(
                            attr.value
                        )
                )
                .join(' ');

        let score = 0;

        if (
            slug &&
            attrs.split(/\s+/)
                .includes(slug)
        ) {
            score += 120;
        } else if (
            slug &&
            attrs.includes(slug)
        ) {
            score += 80;
        }

        if (
            slug &&
            href.includes(slug)
        ) {
            score += 80;
        }

        if (
            name &&
            text === name
        ) {
            score += 70;
        } else if (
            name &&
            text.includes(name)
        ) {
            score += 45;
        }

        if (
            name &&
            title.includes(name)
        ) {
            score += 40;
        }

        if (
            area &&
            text.includes(area)
        ) {
            score += 10;
        }

        return score;
    }

    function findHuntElement(
        root,
        hunt
    ) {
        const candidates =
            qa(
                [
                    'button',
                    'a',
                    '[role="button"]',
                    '[data-slug]',
                    '[data-hunt]',
                    '[data-hunt-slug]'
                ].join(','),
                root
            );

        return candidates
            .map(
                element => ({
                    element,
                    score:
                        huntCandidateScore(
                            element,
                            hunt
                        )
                })
            )
            .filter(
                candidate =>
                    candidate.score >=
                    40
            )
            .sort(
                (a, b) =>
                    b.score -
                    a.score
            )[0]
            ?.element ||
            null;
    }

    function findAreaElement(
        root,
        area
    ) {
        const wanted =
            normalize(area);

        if (!wanted) {
            return null;
        }

        return qa(
            'button,a,[role="button"]',
            root
        ).find(
            el =>
                normalize(
                    el.textContent
                ) === wanted ||
                normalize(
                    el.getAttribute(
                        'data-area'
                    )
                ) === wanted
        ) || null;
    }

    async function navigateToHunt(
        hunt
    ) {
        if (
            !isUnlocked(hunt)
        ) {
            state.status =
                `${hunt.nome} is locked — requires level ${hunt.nivel}.`;

            queueRender();
            return;
        }

        if (
            hunt.slug ===
            state.currentHuntSlug
        ) {
            state.status =
                `Already hunting in ${hunt.nome}.`;

            queueRender();
            return;
        }

        state.status =
            `Opening map for ${hunt.nome}…`;

        queueRender();

        const mapButton =
            q(
                '[data-modal="mapa"]'
            );

        if (!mapButton) {
            state.status =
                'Could not find PokéIdle’s Map button.';

            queueRender();
            return;
        }

        mapButton.click();

        const modalBody =
            await waitFor(
                () => {
                    const modal =
                        q('#modal');

                    const body =
                        q(
                            '#modal-corpo'
                        );

                    if (
                        modal &&
                        body &&
                        getComputedStyle(
                            modal
                        ).display !==
                            'none'
                    ) {
                        return body;
                    }

                    return null;
                },
                2500
            );

        if (!modalBody) {
            state.status =
                'Map did not open.';

            queueRender();
            return;
        }

        let candidate =
            findHuntElement(
                modalBody,
                hunt
            );

        if (!candidate) {
            const areaElement =
                findAreaElement(
                    modalBody,
                    hunt.area
                );

            if (areaElement) {
                areaElement.click();
                await wait(180);

                candidate =
                    findHuntElement(
                        modalBody,
                        hunt
                    );
            }
        }

        if (!candidate) {
            state.status =
                `Map opened, but Atlas could not identify “${hunt.nome}” yet. Use Explorer → Inspect next click on that hunt once and export the report; the catalog/filtering side is already working.`;

            queueRender();
            return;
        }

        if (
            elementLooksLocked(
                candidate
            )
        ) {
            state.lockOverrides.set(
                hunt.slug,
                false
            );

            state.status =
                `${hunt.nome} is locked by the game.`;

            queueRender();
            return;
        }

        state.lockOverrides.set(
            hunt.slug,
            true
        );

        candidate.click();

        state.status =
            `Traveling to ${hunt.nome}…`;

        state.drawerOpen =
            false;

        queueRender();
    }


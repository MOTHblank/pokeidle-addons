    function normalize(value) {
        return String(value ?? '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .replace(/\s+/g, ' ')
            .trim();
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function loadFilters() {
        const defaults = {
            search: '',
            region: 'all',
            type: 'all',
            weakness: 'all',
            availability: 'unlocked',
            captured: 'all',
            sort: 'xp'
        };

        try {
            return {
                ...defaults,
                ...JSON.parse(
                    localStorage.getItem(
                        FILTER_KEY
                    ) || '{}'
                )
            };
        } catch {
            return defaults;
        }
    }

    function saveFilters() {

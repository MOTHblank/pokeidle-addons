    function beginInspectNextClick() {
        if (state.inspecting) {
            return;
        }

        state.inspecting = true;
        updateUI();

        inspectorHandler =
            event => {
                const target =
                    event.target;

                if (
                    target instanceof Element &&
                    target.closest(
                        '#' + ROOT_ID
                    )
                ) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                const inspection =
                    inspectElement(
                        target
                    );

                state.lastInspection =
                    inspection;

                if (inspection) {
                    state.inspections.unshift(
                        inspection
                    );

                    state.inspections =
                        state.inspections.slice(
                            0,
                            MAX_INSPECTIONS
                        );

                    highlightElement(
                        target
                    );
                }

                state.inspecting =
                    false;

                document.removeEventListener(
                    'pointerdown',
                    inspectorHandler,
                    true
                );

                inspectorHandler =
                    null;

                state.activeTab =
                    'inspect';

                updateUI();
            };

        document.addEventListener(
            'pointerdown',
            inspectorHandler,
            true
        );
    }


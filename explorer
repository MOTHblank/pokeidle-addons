            <div class="mexp-section">
                <h4>Recent inspections</h4>
                <pre class="mexp-code">${escapeHtml(JSON.stringify(state.inspections, null, 2))}</pre>
            </div>
        `;
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function updateUI() {
        ensureUI();

        const drawer =
            q('#' + DRAWER_ID);

        if (!drawer) {
            return;
        }

        drawer.hidden =
            !state.drawerOpen;

        for (
            const tab of
            qa(
                '[data-tab]',
                drawer
            )
        ) {
            tab.classList.toggle(
                'active',
                tab.dataset.tab ===
                    state.activeTab
            );
        }

        const recordButton =
            q(
                '[data-mexp-record]',
                drawer
            );

        if (recordButton) {
            recordButton.classList.toggle(
                'active',
                state.persistentRecording
            );

            recordButton.textContent =
                state.persistentRecording
                    ? 'Recording DOM'
                    : 'Record DOM';
        }

        const inspectButton =
            q(
                '[data-mexp-inspect]',
                drawer
            );

        if (inspectButton) {
            inspectButton.classList.toggle(
                'mexp-inspecting',
                state.inspecting
            );

            inspectButton.textContent =
                state.inspecting
                    ? 'Click an element…'
                    : 'Inspect next click';
        }

        if (!state.drawerOpen) {
            return;
        }

        const body =
            q(
                '.mexp-body',
                drawer
            );

        if (!body) {
            return;
        }

        const renderers = {
            overview:
                renderOverview,
            dom:
                renderDom,
            network:
                renderNetwork,
            perf:
                renderPerformance,
            inspect:
                renderInspect
        };

        body.innerHTML =
            (
                renderers[
                    state.activeTab
                ] ||
                renderOverview
            )();
    }

    // ------------------------------------------------------------------
    // Bootstrap / rolling metrics
    // ------------------------------------------------------------------

    installWebSocketHook();
    installTimerHooks();
    installRafHook();
    installPerformanceObservers();

    // Use the instrumented rAF intentionally so Explorer measures itself
    // consistently with the rest of the page.
    page.requestAnimationFrame(
        fpsLoop
    );

    setInterval(() => {
        state.raf.scheduledPerSecond =
            state.raf.scheduledWindow;

        state.raf.executedPerSecond =
            state.raf.executedWindow;

        state.raf.scheduledWindow = 0;
        state.raf.executedWindow = 0;

        state.perf.longTaskMsPerSecond =
            state.perf.longTaskMsWindow;

        state.perf.longTaskMsWindow = 0;

        if (state.drawerOpen) {
            updateUI();
        }
    }, 1000);

    function bootstrap() {
        scanExistingResources();
        ensureUI();

        state.uiTimer =
            setInterval(() => {
                ensureUI();
            }, 1500);

        console.info(
            '[PokéIdle Explorer] v1 loaded'
        );
    }

    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            bootstrap,
            {
                once: true
            }
        );
    } else {
        bootstrap();
    }
})();

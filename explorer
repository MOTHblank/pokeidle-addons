    function histogramDelays(map) {
        const histogram =
            new Map();

        for (
            const item of
            map.values()
        ) {
            const key =
                String(
                    item.delay
                );

            histogram.set(
                key,
                (
                    histogram.get(key) ||
                    0
                ) + 1
            );
        }

        return [...histogram.entries()]
            .map(
                ([delay, count]) => ({
                    delayMs:
                        Number(delay),
                    count
                })
            )
            .sort(
                (a, b) =>
                    a.delayMs -
                    b.delayMs
            );
    }

    function downloadExport() {
        const data =
            JSON.stringify(
                buildExport(),
                null,
                2
            );

        const blob =
            new Blob(
                [data],
                {
                    type:
                        'application/json'
                }
            );

        const url =
            URL.createObjectURL(
                blob
            );

        const anchor =
            document.createElement(
                'a'
            );

        anchor.href = url;
        anchor.download =
            'pokeidle-explorer-' +
            new Date()
                .toISOString()
                .replace(
                    /[:.]/g,
                    '-'
                ) +
            '.json';

        document.body.appendChild(
            anchor
        );

        anchor.click();
        anchor.remove();

        setTimeout(
            () =>
                URL.revokeObjectURL(
                    url
                ),
            1000
        );
    }


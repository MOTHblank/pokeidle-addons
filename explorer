// ==UserScript==
// @name         PokéIdle Explorer
// @namespace    moth.pokeidle
// @version      1.0.0
// @description  Runtime explorer/dev console for PokéIdle addon development.
// @match        https://pokeidle.io/*
// @match        https://www.pokeidle.io/*
// @grant        unsafeWindow
// @run-at       document-start
// ==/UserScript==

(() => {
    'use strict';

    const page = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;

    const ROOT_ID = 'moth-explorer-root';
    const BUTTON_ID = 'moth-explorer-button';
    const DRAWER_ID = 'moth-explorer-drawer';
    const STYLE_ID = 'moth-explorer-style';

    const MAX_WS_SAMPLES = 80;
    const MAX_LONG_TASKS = 100;
    const MAX_INSPECTIONS = 30;
    const MAX_MUTATION_KEYS = 250;
    const MAX_RESIZE_KEYS = 150;

    const state = {
        drawerOpen: false,
        activeTab: 'overview',
        persistentRecording: false,
        inspecting: false,

        websocket: {
            hookInstalled: false,
            sockets: 0,
            messages: 0,
            parseFailures: 0,
            types: new Map(),
            samples: []
        },

        timers: {
            hookInstalled: false,
            timeouts: new Map(),
            intervals: new Map(),
            createdTimeouts: 0,
            createdIntervals: 0
        },

        raf: {
            hookInstalled: false,
            pending: new Set(),
            scheduledWindow: 0,
            executedWindow: 0,
            scheduledPerSecond: 0,
            executedPerSecond: 0
        },

        perf: {
            browserFps: 0,
            longTasks: [],
            longTaskMsWindow: 0,
            longTaskMsPerSecond: 0,
            resources: []
        },

        mutations: new Map(),
        resizes: new Map(),
        mutationObserver: null,
        resizeObserver: null,

        inspections: [],
        lastInspection: null,

        uiTimer: null
    };

    const q = (selector, root = document) => root.querySelector(selector);
    const qa = (selector, root = document) => [...root.querySelectorAll(selector)];

    function normalize(value) {
        return String(value ?? '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .replace(/\s+/g, ' ')
            .trim();
    }

    function visible(el) {
        if (!el?.isConnected || el.hidden || el.classList?.contains('hidden')) {
            return false;
        }

        const style = getComputedStyle(el);

        if (
            style.display === 'none' ||
            style.visibility === 'hidden' ||
            Number(style.opacity) === 0
        ) {
            return false;
        }

        return el.getClientRects().length > 0;
    }

    function shortText(value, limit = 80) {
        const text = String(value ?? '')
            .replace(/\s+/g, ' ')
            .trim();

        return text.length > limit
            ? text.slice(0, limit - 1) + '…'
            : text;
    }

    function elementLabel(el) {
        if (!(el instanceof Element)) {
            return '(non-element)';
        }

        if (el.id) {
            return '#' + el.id;
        }

        const region = el.closest?.('[id]');

        if (region?.id) {
            return '#' + region.id;
        }

        const classes = [...el.classList].slice(0, 2);

        return (
            el.tagName.toLowerCase() +
            (classes.length ? '.' + classes.join('.') : '')
        );
    }

    function elementPath(el, limit = 6) {
        if (!(el instanceof Element)) {
            return '';
        }

        const parts = [];
        let node = el;

        while (
            node &&
            node instanceof Element &&
            parts.length < limit
        ) {
            let part = node.tagName.toLowerCase();

            if (node.id) {
                part += '#' + node.id;
                parts.unshift(part);
                break;
            }

            const classes =
                [...node.classList]
                    .filter(Boolean)
                    .slice(0, 2);

            if (classes.length) {
                part += '.' + classes.join('.');
            }

            parts.unshift(part);
            node = node.parentElement;
        }

        return parts.join(' > ');
    }

    // ------------------------------------------------------------------
    // Sanitized schema helpers
    // ------------------------------------------------------------------

    const sensitiveKeyPattern =
        /token|secret|password|passwd|auth|cookie|session|jwt|email|mail|phone|telefone|ip|address|endereco/i;

    function primitiveShape(value, key = '') {
        if (sensitiveKeyPattern.test(key)) {
            return '<redacted>';
        }

        if (value === null) return 'null';

        if (typeof value === 'string') {
            const text = value.trim();

            if (
                text.length <= 36 &&
                /^[\w .:/+\-À-ÿ]+$/.test(text) &&
                !/[A-Za-z0-9_-]{24,}/.test(text)
            ) {
                return {
                    type: 'string',
                    example: text
                };
            }

            return {
                type: 'string',
                length: value.length
            };
        }

        if (typeof value === 'number') {
            return {
                type: 'number'
            };
        }

        if (typeof value === 'boolean') {
            return {
                type: 'boolean'
            };
        }

        return {
            type: typeof value
        };
    }

    function schemaOf(value, depth = 0, key = '') {
        if (depth > 5) {
            return '<max-depth>';
        }

        if (
            value === null ||
            typeof value !== 'object'
        ) {
            return primitiveShape(value, key);
        }

        if (Array.isArray(value)) {
            return {
                type: 'array',
                length: value.length,
                item:
                    value.length
                        ? schemaOf(
                            value[0],
                            depth + 1,
                            key
                        )
                        : '<empty>'
            };
        }

        const result = {};

        for (
            const [childKey, child] of
            Object.entries(value).slice(0, 60)
        ) {
            result[childKey] =
                sensitiveKeyPattern.test(childKey)
                    ? '<redacted>'
                    : schemaOf(
                        child,
                        depth + 1,
                        childKey
                    );
        }

        return result;
    }

    function messageTypeOf(value) {
        if (!value || typeof value !== 'object') {
            return typeof value;
        }

        for (
            const key of [
                'type',
                'tipo',
                'event',
                'evento',
                'action',
                'acao',
                'op',
                'kind',
                't'
            ]
        ) {
            if (
                Object.prototype.hasOwnProperty.call(
                    value,
                    key
                )
            ) {
                const candidate =
                    value[key];

                if (
                    ['string', 'number'].includes(
                        typeof candidate
                    )
                ) {
                    return shortText(candidate, 60);
                }
            }
        }

        const keys =
            Object.keys(value)
                .sort()
                .slice(0, 6);

        return keys.length
            ? '{' + keys.join(',') + '}'
            : '{}';
    }

    function decodeWsData(data) {
        if (typeof data === 'string') {
            try {
                return {
                    parsed: JSON.parse(data),
                    rawType: 'text'
                };
            } catch {
                return {
                    parsed: null,
                    rawType: 'text'
                };
            }
        }

        if (data instanceof ArrayBuffer) {
            try {
                const text =
                    new TextDecoder().decode(data);

                return {
                    parsed: JSON.parse(text),
                    rawType: 'arraybuffer'
                };
            } catch {
                return {
                    parsed: null,
                    rawType: 'arraybuffer'
                };
            }
        }

        return {
            parsed: null,
            rawType:
                data?.constructor?.name ||
                typeof data
        };
    }

    function recordWsMessage(data, direction) {
        state.websocket.messages++;

        const decoded =
            decodeWsData(data);

        if (!decoded.parsed) {
            state.websocket.parseFailures++;

            const type =
                '<' +
                decoded.rawType +
                '>';

            const entry =
                state.websocket.types.get(type) ||
                {
                    type,
                    count: 0,
                    direction: {
                        in: 0,
                        out: 0
                    },
                    schema: null
                };

            entry.count++;
            entry.direction[direction]++;

            state.websocket.types.set(
                type,
                entry
            );

            return;
        }

        const type =
            messageTypeOf(
                decoded.parsed
            );

        const entry =
            state.websocket.types.get(type) ||
            {
                type,
                count: 0,
                direction: {
                    in: 0,
                    out: 0
                },
                schema: schemaOf(
                    decoded.parsed
                )
            };

        entry.count++;
        entry.direction[direction]++;

        state.websocket.types.set(
            type,
            entry
        );

        if (
            state.websocket.samples.length <
            MAX_WS_SAMPLES
        ) {
            state.websocket.samples.push({
                time:
                    new Date().toISOString(),
                direction,
                type,
                schema:
                    schemaOf(
                        decoded.parsed
                    )
            });
        }
    }

    // ------------------------------------------------------------------
    // WebSocket instrumentation
    // ------------------------------------------------------------------

    function installWebSocketHook() {
        if (state.websocket.hookInstalled) {
            return true;
        }

        const NativeWebSocket =
            page.WebSocket;

        if (
            typeof NativeWebSocket !==
            'function'
        ) {
            return false;
        }

        if (
            page.__mothExplorerWebSocket
        ) {
            state.websocket.hookInstalled =
                true;

            return true;
        }

        const WrappedWebSocket =
            new Proxy(
                NativeWebSocket,
                {
                    construct(
                        target,
                        args,
                        newTarget
                    ) {
                        const socket =
                            Reflect.construct(
                                target,
                                args,
                                target
                            );

                        state.websocket.sockets++;

                        socket.addEventListener(
                            'message',
                            event => {
                                if (
                                    typeof Blob !==
                                        'undefined' &&
                                    event.data instanceof
                                        Blob
                                ) {
                                    event.data
                                        .text()
                                        .then(text =>
                                            recordWsMessage(
                                                text,
                                                'in'
                                            )
                                        )
                                        .catch(() => {});

                                    return;
                                }

                                recordWsMessage(
                                    event.data,
                                    'in'
                                );
                            }
                        );

                        const nativeSend =
                            socket.send;

                        socket.send =
                            function (data) {
                                recordWsMessage(
                                    data,
                                    'out'
                                );

                                return nativeSend.call(
                                    this,
                                    data
                                );
                            };

                        return socket;
                    }
                }
            );

        try {
            page.WebSocket =
                WrappedWebSocket;

            page.__mothExplorerWebSocket =
                true;

            state.websocket.hookInstalled =
                page.WebSocket ===
                WrappedWebSocket;

            return state.websocket
                .hookInstalled;
        } catch {
            return false;
        }
    }

    // ------------------------------------------------------------------
    // Timer instrumentation
    // ------------------------------------------------------------------

    function installTimerHooks() {
        if (state.timers.hookInstalled) {
            return true;
        }

        const nativeSetTimeout =
            page.setTimeout.bind(page);

        const nativeClearTimeout =
            page.clearTimeout.bind(page);

        const nativeSetInterval =
            page.setInterval.bind(page);

        const nativeClearInterval =
            page.clearInterval.bind(page);

        try {
            page.setTimeout =
                function (
                    handler,
                    delay = 0,
                    ...args
                ) {
                    if (
                        typeof handler !==
                        'function'
                    ) {
                        return nativeSetTimeout(
                            handler,
                            delay,
                            ...args
                        );
                    }

                    let id;

                    const wrapped =
                        function (...callbackArgs) {
                            state.timers.timeouts.delete(
                                id
                            );

                            return handler.apply(
                                this,
                                callbackArgs
                            );
                        };

                    id =
                        nativeSetTimeout(
                            wrapped,
                            delay,
                            ...args
                        );

                    state.timers.createdTimeouts++;

                    state.timers.timeouts.set(
                        id,
                        {
                            delay:
                                Number(delay) ||
                                0,
                            createdAt:
                                performance.now()
                        }
                    );

                    return id;
                };

            page.clearTimeout =
                function (id) {
                    state.timers.timeouts.delete(
                        id
                    );

                    return nativeClearTimeout(
                        id
                    );
                };

            page.setInterval =
                function (
                    handler,
                    delay = 0,
                    ...args
                ) {
                    const id =
                        nativeSetInterval(
                            handler,
                            delay,
                            ...args
                        );

                    state.timers.createdIntervals++;

                    state.timers.intervals.set(
                        id,
                        {
                            delay:
                                Number(delay) ||
                                0,
                            createdAt:
                                performance.now()
                        }
                    );

                    return id;
                };

            page.clearInterval =
                function (id) {
                    state.timers.intervals.delete(
                        id
                    );

                    return nativeClearInterval(
                        id
                    );
                };

            state.timers.hookInstalled =
                true;

            return true;
        } catch {
            return false;
        }
    }

    // ------------------------------------------------------------------
    // rAF instrumentation
    // ------------------------------------------------------------------

    function installRafHook() {
        if (state.raf.hookInstalled) {
            return true;
        }

        const nativeRAF =
            page.requestAnimationFrame
                ?.bind(page);

        const nativeCancelRAF =
            page.cancelAnimationFrame
                ?.bind(page);

        if (
            !nativeRAF ||
            !nativeCancelRAF
        ) {
            return false;
        }

        try {
            page.requestAnimationFrame =
                function (callback) {
                    state.raf.scheduledWindow++;

                    let id;

                    id =
                        nativeRAF(
                            timestamp => {
                                state.raf.pending.delete(
                                    id
                                );

                                state.raf.executedWindow++;

                                return callback.call(
                                    page,
                                    timestamp
                                );
                            }
                        );

                    state.raf.pending.add(id);

                    return id;
                };

            page.cancelAnimationFrame =
                function (id) {
                    state.raf.pending.delete(
                        id
                    );

                    return nativeCancelRAF(id);
                };

            state.raf.hookInstalled =
                true;

            return true;
        } catch {
            return false;
        }
    }

    // ------------------------------------------------------------------
    // Performance/resource instrumentation
    // ------------------------------------------------------------------

    function installPerformanceObservers() {
        try {
            const longTaskObserver =
                new PerformanceObserver(
                    list => {
                        for (
                            const entry of
                            list.getEntries()
                        ) {
                            const item = {
                                time:
                                    Math.round(
                                        entry.startTime
                                    ),
                                duration:
                                    Math.round(
                                        entry.duration *
                                        10
                                    ) / 10
                            };

                            state.perf.longTasks.push(
                                item
                            );

                            state.perf.longTaskMsWindow +=
                                entry.duration;

                            if (
                                state.perf.longTasks
                                    .length >
                                MAX_LONG_TASKS
                            ) {
                                state.perf.longTasks.shift();
                            }
                        }
                    }
                );

            longTaskObserver.observe({
                type: 'longtask',
                buffered: true
            });
        } catch {}

        try {
            const resourceObserver =
                new PerformanceObserver(
                    list => {
                        for (
                            const entry of
                            list.getEntries()
                        ) {
                            if (
                                !/\.(?:m?js)(?:\?|$)/i
                                    .test(
                                        entry.name
                                    )
                            ) {
                                continue;
                            }

                            upsertResource(
                                entry
                            );
                        }
                    }
                );

            resourceObserver.observe({
                type: 'resource',
                buffered: true
            });
        } catch {}
    }

    function upsertResource(entry) {
        const existing =
            state.perf.resources.find(
                item =>
                    item.url ===
                    entry.name
            );

        const data = {
            url: entry.name,
            name:
                entry.name
                    .split('/')
                    .pop()
                    ?.split('?')[0] ||
                entry.name,
            initiatorType:
                entry.initiatorType,
            startTime:
                Math.round(
                    entry.startTime
                ),
            duration:
                Math.round(
                    entry.duration *
                    10
                ) / 10,
            transferSize:
                Number(
                    entry.transferSize ||
                    0
                ),
            decodedBodySize:
                Number(
                    entry.decodedBodySize ||
                    0
                )
        };

        if (existing) {
            Object.assign(
                existing,
                data
            );
        } else {
            state.perf.resources.push(
                data
            );
        }
    }

    function scanExistingResources() {
        for (
            const entry of
            performance.getEntriesByType(
                'resource'
            )
        ) {
            if (
                /\.(?:m?js)(?:\?|$)/i.test(
                    entry.name
                )
            ) {
                upsertResource(
                    entry
                );
            }
        }
    }

    let fpsFrames = 0;
    let fpsStarted =
        performance.now();

    function fpsLoop(now) {
        fpsFrames++;

        const elapsed =
            now - fpsStarted;

        if (elapsed >= 1000) {
            state.perf.browserFps =
                Math.round(
                    (
                        fpsFrames *
                        1000 /
                        elapsed
                    ) *
                    10
                ) / 10;

            fpsFrames = 0;
            fpsStarted = now;
        }

        page.requestAnimationFrame(
            fpsLoop
        );
    }

    // ------------------------------------------------------------------
    // Mutation/layout activity profiler
    // ------------------------------------------------------------------

    function incrementMap(
        map,
        key,
        amount = 1,
        maxKeys = 200
    ) {
        map.set(
            key,
            (
                map.get(key) ||
                0
            ) + amount
        );

        if (
            map.size >
            maxKeys
        ) {
            const lowest =
                [...map.entries()]
                    .sort(
                        (a, b) =>
                            a[1] -
                            b[1]
                    )
                    .slice(
                        0,
                        map.size -
                            maxKeys
                    );

            for (
                const [removeKey] of
                lowest
            ) {
                map.delete(
                    removeKey
                );
            }
        }
    }

    function mutationRegion(
        node
    ) {
        const el =
            node instanceof Element
                ? node
                : node?.parentElement;

        if (!el) {
            return '(document)';
        }

        return elementLabel(el);
    }

    function startMutationProfiler() {
        if (
            state.mutationObserver ||
            !document.documentElement
        ) {
            return;
        }

        state.mutationObserver =
            new MutationObserver(
                records => {
                    for (
                        const record of
                        records
                    ) {
                        incrementMap(
                            state.mutations,
                            mutationRegion(
                                record.target
                            ),
                            1,
                            MAX_MUTATION_KEYS
                        );
                    }
                }
            );

        state.mutationObserver.observe(
            document.documentElement,
            {
                childList: true,
                subtree: true,
                characterData: true,
                attributes: true,
                attributeFilter: [
                    'class',
                    'style',
                    'aria-hidden',
                    'aria-expanded',
                    'title'
                ]
            }
        );

        startResizeProfiler();
    }

    function stopMutationProfiler() {
        state.mutationObserver
            ?.disconnect();

        state.mutationObserver =
            null;

        state.resizeObserver
            ?.disconnect();

        state.resizeObserver =
            null;
    }

    function startResizeProfiler() {
        if (
            state.resizeObserver ||
            typeof ResizeObserver !==
                'function'
        ) {
            return;
        }

        state.resizeObserver =
            new ResizeObserver(
                entries => {
                    for (
                        const entry of
                        entries
                    ) {
                        incrementMap(
                            state.resizes,
                            elementLabel(
                                entry.target
                            ),
                            1,
                            MAX_RESIZE_KEYS
                        );
                    }
                }
            );

        for (
            const el of
            qa(
                [
                    '.painel',
                    '#palco',
                    '#caidos',
                    '#hud-log',
                    '#golpes-painel',
                    '#chat-msgs',
                    '#sessao-painel',
                    '#capturas-painel'
                ].join(',')
            )
        ) {
            try {
                state.resizeObserver.observe(
                    el
                );
            } catch {}
        }
    }

    function syncProfilerState() {
        if (
            state.drawerOpen ||
            state.persistentRecording
        ) {
            startMutationProfiler();
        } else {
            stopMutationProfiler();
        }
    }

    // ------------------------------------------------------------------
    // DOM scans
    // ------------------------------------------------------------------

    function visiblePanels() {
        const candidates =
            qa(
                [
                    '.painel[id]',
                    '.modal[id]',
                    '[role="dialog"][id]',
                    '#palco',
                    '#caidos',
                    '#eco-painel',
                    '#sessao-painel',
                    '#capturas-painel'
                ].join(',')
            );

        return candidates
            .filter(visible)
            .map(el => {
                const rect =
                    el.getBoundingClientRect();

                return {
                    id:
                        el.id ||
                        null,
                    tag:
                        el.tagName
                            .toLowerCase(),
                    classes:
                        [...el.classList]
                            .slice(0, 6),
                    rect: {
                        x:
                            Math.round(
                                rect.x
                            ),
                        y:
                            Math.round(
                                rect.y
                            ),
                        width:
                            Math.round(
                                rect.width
                            ),
                        height:
                            Math.round(
                                rect.height
                            )
                    }
                };
            });
    }

    function visibleButtons() {
        return qa(
            'button, [role="button"]'
        )
            .filter(visible)
            .slice(0, 250)
            .map(el => ({
                id:
                    el.id ||
                    null,
                text:
                    shortText(
                        el.textContent,
                        60
                    ),
                title:
                    shortText(
                        el.getAttribute(
                            'title'
                        ),
                        80
                    ),
                dataModal:
                    el.getAttribute(
                        'data-modal'
                    ),
                path:
                    elementPath(
                        el,
                        4
                    )
            }));
    }

    function topMapEntries(
        map,
        limit = 20
    ) {
        return [...map.entries()]
            .sort(
                (a, b) =>
                    b[1] -
                    a[1]
            )
            .slice(0, limit)
            .map(
                ([region, count]) => ({
                    region,
                    count
                })
            );
    }

    // ------------------------------------------------------------------
    // Inspect next click
    // ------------------------------------------------------------------

    let inspectorHandler = null;

    function inspectElement(el) {
        if (!(el instanceof Element)) {
            return null;
        }

        const rect =
            el.getBoundingClientRect();

        const attributes = {};

        for (
            const attr of
            [...el.attributes]
        ) {
            attributes[attr.name] =
                sensitiveKeyPattern.test(
                    attr.name
                )
                    ? '<redacted>'
                    : shortText(
                        attr.value,
                        160
                    );
        }

        return {
            time:
                new Date().toISOString(),
            tag:
                el.tagName
                    .toLowerCase(),
            id:
                el.id ||
                null,
            classes:
                [...el.classList],
            text:
                shortText(
                    el.textContent,
                    180
                ),
            attributes,
            path:
                elementPath(
                    el,
                    8
                ),
            rect: {
                x:
                    Math.round(
                        rect.x
                    ),
                y:
                    Math.round(
                        rect.y
                    ),
                width:
                    Math.round(
                        rect.width
                    ),
                height:
                    Math.round(
                        rect.height
                    )
            },
            parentIds:
                collectParentIds(
                    el
                )
        };
    }

    function collectParentIds(el) {
        const ids = [];
        let node =
            el.parentElement;

        while (node) {
            if (node.id) {
                ids.push(
                    node.id
                );
            }

            node =
                node.parentElement;
        }

        return ids.slice(0, 10);
    }

    function highlightElement(el) {
        if (!(el instanceof Element)) {
            return;
        }

        const previous =
            el.style.outline;

        const previousOffset =
            el.style.outlineOffset;

        el.style.outline =
            '2px solid #ffd25a';

        el.style.outlineOffset =
            '2px';

        setTimeout(() => {
            el.style.outline =
                previous;

            el.style.outlineOffset =
